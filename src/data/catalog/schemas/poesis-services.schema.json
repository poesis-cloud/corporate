{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://poesis.cloud/schemas/poesis-services.schema.json",
    "title": "Poesis services catalog",
    "description": "The engagement side of the model: how the platform is delivered to an organization. A service states its own availability and never declares platform or usage support.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "services"
    ],
    "properties": {
        "$schema": {
            "type": "string"
        },
        "services": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/service"
            }
        }
    },
    "$defs": {
        "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "text": {
            "type": "string",
            "minLength": 1
        },
        "point": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "title",
                "description"
            ],
            "properties": {
                "title": {
                    "$ref": "#/$defs/text"
                },
                "description": {
                    "$ref": "#/$defs/text"
                }
            }
        },
        "service": {
            "type": "object",
            "description": "An engagement offer. `availability` is the claim boundary; `availabilityNote` states what still needs agreement or acceptance.",
            "additionalProperties": false,
            "required": [
                "slug",
                "availability",
                "availabilityNote",
                "label",
                "category",
                "title",
                "summary",
                "lead",
                "proposition",
                "outcomes",
                "stages"
            ],
            "properties": {
                "slug": {
                    "$ref": "#/$defs/slug"
                },
                "availability": {
                    "enum": [
                        "By agreement",
                        "Planned"
                    ]
                },
                "availabilityNote": {
                    "$ref": "#/$defs/text"
                },
                "label": {
                    "$ref": "#/$defs/text"
                },
                "category": {
                    "$ref": "#/$defs/text"
                },
                "title": {
                    "$ref": "#/$defs/text"
                },
                "summary": {
                    "$ref": "#/$defs/text"
                },
                "lead": {
                    "$ref": "#/$defs/text"
                },
                "proposition": {
                    "$ref": "#/$defs/text"
                },
                "outcomes": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/$defs/point"
                    }
                },
                "stages": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/$defs/point"
                    }
                }
            }
        }
    }
}