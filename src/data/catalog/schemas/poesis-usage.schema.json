{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poesis.cloud/schemas/poesis-usage.schema.json",
  "title": "Poesis usage catalog",
  "description": "The usage side of the model: domains, actor types, independent pains, homepage pain groups, use cases and composite values. The usage side never declares what supports it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["domains", "actorTypes", "pains", "painGroups", "useCases", "values"],
  "properties": {
    "$schema": { "type": "string" },
    "domains": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/domain" } },
    "actorTypes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/actorType" } },
    "pains": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/pain" } },
    "painGroups": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/painGroup" } },
    "useCases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/useCase" } },
    "values": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/value" } }
  },
  "$defs": {
    "slug": { "type": "string", "minLength": 1 },
    "slugList": { "type": "array", "items": { "$ref": "#/$defs/slug" }, "uniqueItems": true },
    "nonEmptySlugList": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/slug" }, "uniqueItems": true },
    "text": { "type": "string", "minLength": 1 },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "name", "label", "tags", "blurb"],
      "properties": {
        "slug": { "$ref": "#/$defs/slug" },
        "name": { "$ref": "#/$defs/text" },
        "label": { "$ref": "#/$defs/text" },
        "tags": { "type": "array", "items": { "$ref": "#/$defs/text" } },
        "blurb": { "$ref": "#/$defs/text" }
      }
    },
    "actorType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "kind", "domainSlug", "name", "tags", "icon", "hook", "body"],
      "properties": {
        "slug": { "$ref": "#/$defs/slug" },
        "kind": { "enum": ["human", "system"] },
        "domainSlug": { "$ref": "#/$defs/slug" },
        "name": { "$ref": "#/$defs/text" },
        "tags": { "type": "array", "items": { "$ref": "#/$defs/text" } },
        "icon": { "$ref": "#/$defs/text" },
        "hook": { "$ref": "#/$defs/text" },
        "body": { "$ref": "#/$defs/text" }
      }
    },
    "pain": {
      "type": "object",
      "description": "An independent pain. Pains never reference what addresses them; support is projected from use cases.",
      "additionalProperties": false,
      "required": ["slug", "tags", "pain", "cost", "actorTypes"],
      "properties": {
        "slug": { "$ref": "#/$defs/slug" },
        "tags": { "type": "array", "items": { "$ref": "#/$defs/text" } },
        "pain": { "$ref": "#/$defs/text" },
        "cost": { "$ref": "#/$defs/text" },
        "actorTypes": { "$ref": "#/$defs/slugList" },
        "occursIn": {
          "description": "Use cases the pain occurs in.",
          "$ref": "#/$defs/slugList"
        }
      }
    },
    "painGroup": {
      "type": "object",
      "description": "An editorial grouping of pains used by the homepage lead boxes.",
      "additionalProperties": false,
      "required": ["slug", "lead", "pains"],
      "properties": {
        "slug": { "$ref": "#/$defs/slug" },
        "lead": { "$ref": "#/$defs/text" },
        "pains": { "$ref": "#/$defs/nonEmptySlugList" }
      }
    },
    "useCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "name", "goal", "actorTypes", "addressedPains"],
      "properties": {
        "slug": { "$ref": "#/$defs/slug" },
        "name": { "$ref": "#/$defs/text" },
        "goal": { "$ref": "#/$defs/text" },
        "actorTypes": { "$ref": "#/$defs/nonEmptySlugList" },
        "addressedPains": { "$ref": "#/$defs/slugList" }
      }
    },
    "value": {
      "type": "object",
      "description": "A value composes explicit use cases; its delivery status accounts for every constituent case, including missing support.",
      "additionalProperties": false,
      "required": ["slug", "originalTitle", "title", "body", "useCases"],
      "properties": {
        "slug": { "type": "string", "pattern": "^value:" },
        "originalTitle": { "$ref": "#/$defs/text" },
        "title": { "$ref": "#/$defs/text" },
        "body": { "$ref": "#/$defs/text" },
        "useCases": { "$ref": "#/$defs/nonEmptySlugList" }
      }
    }
  }
}
