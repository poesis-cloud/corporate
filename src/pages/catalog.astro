---
/** The catalog index: three families with explicit relationships between types. */
import CatalogLayout from '../layouts/CatalogLayout.astro';
import Icon from '../components/Icon.astro';
import ArchMap from '../components/ArchMap.astro';
import UsageMap from '../components/UsageMap.astro';
import { cardTypeIcons, cardTypeLabels, type CatalogItemType } from '../data/catalog-card.ts';
import { services } from '../data/services.ts';

interface CatalogEntry {
  type: CatalogItemType;
  href: string;
  label: string;
  count: number;
  claim: string;
  body: string;
}

const serviceEntry: CatalogEntry = {
  type: 'service', href: '/catalog/services', label: 'Services', count: services.length,
  claim: 'Describe an engagement or delivery route',
  body: 'Consulting, managed cloud, sovereign deployment and capability building each define their proposition, outcomes, stages and availability.',
};
---
<CatalogLayout
  title="Poesis catalog"
  description="The Poesis catalog: platform structure and coverage, usage needs and outcomes, and the services through which Poesis is delivered."
  heading="Catalog"
  lead="Three connected catalogs separate what Poesis is, what it is used for, and how it is delivered. Open an item type to inspect its complete inventory and relationships."
  count="3 connected catalogs"
>
  <section id="platform" class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Platform catalog</p>
        <h2>Platform</h2>
        <p class="lead">Solutions contain products and their features; capabilities connect those implementation units to the affordances the platform makes possible. Expand the shared map to inspect the complete structure.</p>
      </div>
      <ArchMap />
    </div>
  </section>

  <section id="usage" class="section section--soft">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Usage catalog</p>
        <h2>Usage</h2>
        <p class="lead">Actors experience pains and pursue use cases; use cases address those pains and realize values. Expand each peer ledger to inspect the complete direct inventory without confusing relationship with ownership.</p>
      </div>
      <UsageMap />
    </div>
  </section>

  <section id="services" class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Services catalog</p>
        <h2>Services</h2>
        <p class="lead">Services describe how Poesis expertise and platform operation are made available. Their availability is stated independently from platform delivery status.</p>
      </div>
      <ul class="think-consequence-list catalog-grid">
        <li>
          <span class="think-consequence__head">
            <span class="think-consequence__icon"><Icon name={cardTypeIcons[serviceEntry.type]} size={16} /></span>
            <span class="think-consequence__step">{cardTypeLabels[serviceEntry.type]}</span>
          </span>
          <h3><a href={serviceEntry.href}>{serviceEntry.label}</a></h3>
          <strong>{serviceEntry.claim}</strong>
          <p>{serviceEntry.body}</p>
          <p class="catalog-meta">{serviceEntry.count} {serviceEntry.count === 1 ? 'entry' : 'entries'}</p>
        </li>
      </ul>
    </div>
  </section>
</CatalogLayout>
