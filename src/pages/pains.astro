---
import CatalogLayout from '../layouts/CatalogLayout.astro';
import CatalogDirectory from '../components/CatalogDirectory.astro';
import { poesisUsage } from '../data/usage.ts';
import { painCard } from '../data/catalog-card.ts';

const cards = poesisUsage.pains.map(painCard);
---
<CatalogLayout
  title="Poesis pain points"
  description="Where IT governance work becomes difficult: independent pain points, who feels them and the use cases addressing them."
  heading="Pain points"
  lead="Where the work becomes difficult today, and what it costs. A pain point is recorded whether or not the platform already addresses it."
  count={`${cards.length} pain points`}
>
  <CatalogDirectory id="pain-contexts" eyebrow="Pains" title="Where work becomes difficult" cards={cards} />
</CatalogLayout>
