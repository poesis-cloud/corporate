---
import BaseLayout from '../layouts/BaseLayout.astro';
import { services } from '../data/services.ts';
---
<BaseLayout
  title="Services"
  description="AI-generative / agentic transformation of your organization, IT first — delivered with the Poesis framework and stack, plus certification for partners and practitioners."
>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Transformation</p>
      <h1>AI-native transformation, IT first.</h1>
      <p class="lead">We transform how your organization defines, builds, and governs its systems — using the same open standard, framework, and stack we created. Where it fits, the Poesis stack becomes the governed substrate of the transformation.</p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="/contact">Book a conversation</a>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Engagement models</p>
        <h2>Choose the operating boundary that fits.</h2>
        <p class="lead">Start with transformation, a managed platform, sovereign deployment, or the capability to deliver Poesis with confidence.</p>
      </div>
      <div class="grid grid-2">
        {services.map((service) => (
          <article class="card card--feature service-card">
            <span class="tag">{service.category}</span>
            <h3>{service.label}</h3>
            <p>{service.summary}</p>
            <a class="btn btn-ghost btn-sm service-link" href={service.href}>Explore {service.label}<span aria-hidden="true">→</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container center">
      <h2>Bring systemic governance to your organization.</h2>
      <p class="lead" style="margin-inline:auto">Tell us where you are; we'll show you the shortest path to governed, AI-native systems.</p>
      <p><a class="btn btn-primary" href="/contact">Talk to us</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .service-card {
    display: flex;
    min-height: 15rem;
    flex-direction: column;
    align-items: flex-start;
  }

  .service-link {
    margin-top: auto;
  }
</style>
