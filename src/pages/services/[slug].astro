---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { services, type Service } from '../../data/services.ts';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

interface Props {
  service: Service;
}

const { service } = Astro.props;
---
<BaseLayout title={service.label} description={service.summary}>
  <section class="hero service-hero">
    <div class="container">
      <p class="eyebrow"><a href="/services">Services</a><span aria-hidden="true">/</span>{service.category}</p>
      <h1>{service.title}</h1>
      <p class="lead">{service.lead}</p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="/contact">Discuss your context</a>
        <a class="btn btn-ghost" href="/services">All services</a>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container service-proposition">
      <div>
        <p class="eyebrow">Service intent</p>
        <h2>Transformation with an explicit operating boundary.</h2>
      </div>
      <p class="lead">{service.proposition}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Outcomes</p>
        <h2>What this service is designed to establish.</h2>
      </div>
      <div class="grid grid-3">
        {service.outcomes.map((outcome) => (
          <article class="card card--feature">
            <h3>{outcome.title}</h3>
            <p>{outcome.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--ink">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Engagement path</p>
        <h2>Move in bounded, evidence-producing stages.</h2>
      </div>
      <ol class="service-stages">
        {service.stages.map((stage, index) => (
          <li>
            <span class="stage-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3>{stage.title}</h3>
              <p>{stage.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container center">
      <p class="eyebrow centered-eyebrow">Next step</p>
      <h2>Start with the boundary that matters most.</h2>
      <p class="lead closing-lead">We will locate the smallest engagement that can produce useful evidence without losing sight of the system around it.</p>
      <p><a class="btn btn-primary" href="/contact">Talk to Poesis</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .service-hero .eyebrow {
    flex-wrap: wrap;
  }

  .service-hero .eyebrow a {
    color: inherit;
  }

  .service-proposition {
    display: grid;
    grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 7vw, 6rem);
    align-items: start;
  }

  .service-proposition h2 {
    margin-bottom: 0;
  }

  .service-proposition .lead {
    margin: 0;
  }

  .service-stages {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .service-stages li {
    min-width: 0;
    padding: clamp(1.4rem, 3vw, 2rem);
    background: var(--bg-ink);
  }

  .stage-number {
    display: block;
    margin-bottom: 2.5rem;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: .78rem;
  }

  .service-stages h3 {
    margin-bottom: .55rem;
  }

  .service-stages p {
    margin-bottom: 0;
  }

  .centered-eyebrow {
    justify-content: center;
  }

  .closing-lead {
    margin-inline: auto;
  }

  @media (max-width: 820px) {
    .service-proposition,
    .service-stages {
      grid-template-columns: 1fr;
    }

    .stage-number {
      margin-bottom: 1.2rem;
    }
  }
</style>