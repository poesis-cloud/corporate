---
import CatalogLayout from '../layouts/CatalogLayout.astro';
import CatalogDirectory from '../components/CatalogDirectory.astro';
import { usageFeatures } from '../data/usage.ts';
import { featureCard } from '../data/catalog-card.ts';

const cards = usageFeatures.map(featureCard);
---
<CatalogLayout
  title="Poesis features"
  description="Every Poesis product feature with its delivery status, milestone and the use cases it declares it serves."
  heading="Features"
  lead="The product scope itself. Each feature states whether it is implemented, partial or planned, and which use cases it declares it serves."
  count={`${cards.length} features`}
>
  <CatalogDirectory id="features" eyebrow="Features" title="Product scope" cards={cards} variant="platform" />
</CatalogLayout>
