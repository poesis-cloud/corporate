---
import CatalogLayout from '../layouts/CatalogLayout.astro';
import CatalogDirectory from '../components/CatalogDirectory.astro';
import { poesisUsage } from '../data/usage.ts';
import { actorCard } from '../data/catalog-card.ts';

const cards = poesisUsage.actorTypes.map(actorCard);
---
<CatalogLayout
  title="Poesis actors"
  description="The human and system actor types that pursue Poesis use cases, from service and risk owners to assessment runners and delivery agents."
  heading="Actors"
  lead="Human and system participants named by the use cases. An actor is a role in the work, not a licensed seat or a product persona."
  count={`${cards.length} actor types`}
>
  <CatalogDirectory id="actor-types" eyebrow="Actor types" title="Human and system participants" cards={cards} />
</CatalogLayout>
