---
import CatalogLayout from '../layouts/CatalogLayout.astro';
import CatalogDirectory from '../components/CatalogDirectory.astro';
import { usageValues } from '../data/usage.ts';
import { valueCard } from '../data/catalog-card.ts';

const cards = usageValues.map(valueCard);
---
<CatalogLayout
  title="Poesis values"
  description="Benefits composed from explicit use cases, with constituent platform coverage and missing support visible."
  heading="Values"
  lead="Benefits sought from the work, composed from explicit use cases. Coverage remains incomplete when a constituent case lacks platform support."
  count={`${cards.length} values`}
>
  <CatalogDirectory id="values" eyebrow="Values" title="Benefits sought" cards={cards} />
</CatalogLayout>
