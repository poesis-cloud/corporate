      feedback: 'Task success, rework, gate failures, cost, latency, and human intervention are measured per run.',
      partner: ['A living reference for supervised multi-agent engineering using partner models', 'A planned evidence surface for task success, rework, gate failures, cost, latency, and human intervention'],
      poesis: ['Faster delivery where measured outcomes demonstrate an advantage over the baseline workflow', 'Auditable delivery evidence governed by deterministic gates and human approval'],
      comps: 'Agent definitions, workflows, model catalog, and harness contracts exist in the <b>SAFe Agentic Framework</b>; the deterministic harness runtime and persisted evidence collection remain to be implemented.',
    },
    {
      id: 'E', hex: '#f59e0b', from: 'n-sie', to: 'n-eval', lane: 28,
      label: 'governed tests → comparable model evidence',
      title: 'E — Model evaluation and assurance (Poesis ↔ LLM)',
      maturity: '<strong>Current maturity:</strong> schema validation, typed Mechanism execution, lifecycle audit, and an ITIP appraisal integration proof are implemented. <strong>Partnership work:</strong> define model evaluation envelopes, datasets, baselines, assurance criteria, and a repeatable service surface.',
      sub: 'A vendor submits versioned model outputs and inference configurations against defined enterprise tasks. GSM schemas and SIE Mechanisms can evaluate only properties made explicit by those contracts, producing reproducible findings and traces. This can reveal capability, failure boundaries, and regressions without changing model weights; it does not turn every governance rule into ground truth or establish inference truth beyond the evaluated contract.',
      schema: [
        { label: 'Enterprise tasks', note: 'GSM schemas, Mechanisms, expected outcomes' },
        { label: 'Vendor submission', note: 'versioned model outputs and inference configuration' },
        { label: 'Typed execution', note: 'deterministic evaluation of explicitly contracted properties' },
        { label: 'Reproducible findings and traces', note: 'capability, failure boundaries, regressions' },
        { label: 'Selection or upgrade decision', note: 'evidence gathered before governed deployment' },
      ],
      feedback: 'Findings return to the vendor as workload-specific evidence rather than general benchmark claims.',
      partner: ['Workload-specific evidence about model strengths, regressions, and failure boundaries', 'A governed assurance case grounded in reproducible tests rather than general benchmark claims'],
