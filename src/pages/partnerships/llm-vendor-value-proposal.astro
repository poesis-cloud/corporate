    },
  ];

  const svg = document.getElementById('vf-wires');
  const diagram = document.getElementById('vf-diagram');
  const detail = document.getElementById('vf-detail');
  let selectedFlow = null;
  let selectedComponent = null;

  function anchor(el, side) {
    const r = el.getBoundingClientRect();
    const d = diagram.getBoundingClientRect();
    return { x: (side === 'right' ? r.right : r.left) - d.left, y: r.top + r.height / 2 - d.top };
  }

  function draw() {
    if (!svg || !diagram) return;
    svg.innerHTML = '';
    if (window.innerWidth <= 860) return;
    svg.setAttribute('width', String(diagram.clientWidth));
    svg.setAttribute('height', String(diagram.clientHeight));

    FLOWS.forEach((f) => {
      const fromEl = document.getElementById(f.from);
      const toEl = document.getElementById(f.to);
      if (!fromEl || !toEl) return;
      const a = anchor(fromEl, fromEl.closest('#g-partner') ? 'right' : 'left');
      const b = anchor(toEl, toEl.closest('#g-partner') ? 'right' : 'left');
      const midX = (a.x + b.x) / 2;
      const related = selectedComponent && (f.from === selectedComponent || f.to === selectedComponent);
      const sel = selectedFlow === f.id || related;

      const lane = f.lane ?? 0;
      const pathData = `M ${a.x} ${a.y} C ${midX} ${a.y + lane}, ${midX} ${b.y + lane}, ${b.x} ${b.y}`;

      const hit = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      hit.setAttribute('d', pathData);
      hit.setAttribute('fill', 'none');
      hit.setAttribute('stroke', 'transparent');
      hit.setAttribute('stroke-width', '20');
      hit.setAttribute('class', 'vf-flow-hit');
      hit.setAttribute('aria-label', f.title);
      hit.addEventListener('click', () => selectFlow(f.id));
      svg.appendChild(hit);

      const p = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      p.setAttribute('d', pathData);
      p.setAttribute('fill', 'none');
      p.setAttribute('stroke', f.hex);
      p.setAttribute('stroke-width', sel ? '7' : '5');
      p.setAttribute('opacity', (selectedFlow || selectedComponent) && !sel ? '0.16' : '0.82');
      p.setAttribute('pointer-events', 'none');
      if (f.dashed) p.setAttribute('stroke-dasharray', '6 5');
      svg.appendChild(p);

      const tip = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
      tip.setAttribute('cx', String(b.x));
      tip.setAttribute('cy', String(b.y));
      tip.setAttribute('r', sel ? '6' : '5');
      tip.setAttribute('fill', f.hex);
      tip.setAttribute('opacity', (selectedFlow || selectedComponent) && !sel ? '0.16' : '1');
      tip.setAttribute('pointer-events', 'none');
      svg.appendChild(tip);
    });
  }

  function schemaMarkup(flow) {
    if (!flow.schema || !flow.schema.length) return '';
    const steps = flow.schema
      .map((step) => {
        const gate = step.gate ? ' vf-step-gate' : '';
        const tint = step.gate ? '' : ` style="border-top-color:${flow.hex}"`;
        return `<div class="vf-step${gate}"${tint}><b>${step.label}</b>${step.note || ''}</div>`;
      })
      .join('<span class="vf-arrow" aria-hidden="true">&#8594;</span>');
    const feedback = flow.feedback
      ? `<p class="vf-schema-feedback">&#8617; ${flow.feedback}</p>`
      : '';
    return `<div class="vf-schema" role="img" aria-label="Flow schema: ${flow.schema.map((step) => step.label).join(', then ')}">
      <div class="vf-schema-row">${steps}</div>
      ${feedback}
    </div>`;
  }

  function adherenceMarkup(flow) {
    const shared = flow.shared && flow.shared.length
      ? `<div class="vf-shared">
        <h5>Shared value in the customer organisation</h5>
        <ul>${flow.shared.map((value) => `<li>${value}</li>`).join('')}</ul>
      </div>`
      : '';
    return `<article class="vf-adherence">
      <h4 style="color:${flow.hex}">${flow.title}</h4>
      <p class="vf-dsub">${flow.sub}</p>
      ${schemaMarkup(flow)}
      <div class="vf-dcols">
        <div><h5>Value for the LLM vendor partner</h5><ul>${flow.partner.map((value) => `<li>${value}</li>`).join('')}</ul></div>
        <div><h5>Value for Poesis</h5><ul>${flow.poesis.map((value) => `<li>${value}</li>`).join('')}</ul></div>
      </div>
      ${shared}
      <div class="vf-comps">Adherence locus — ${flow.comps}</div>
      <p class="vf-maturity">${flow.maturity}</p>
    </article>`;
  }

  function showAdherences(title, flows) {
    if (!detail) return;
    detail.hidden = false;
    detail.innerHTML = `<h3>${title}</h3>${flows.map(adherenceMarkup).join('')}`;
    draw();
    detail.focus({ preventScroll: true });
    detail.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function clearSelection() {
    selectedFlow = null;
    selectedComponent = null;
    document.querySelectorAll('.vf-card').forEach((card) => card.classList.remove('vf-selected'));
    document.querySelectorAll('.vf-card-select').forEach((control) => control.setAttribute('aria-pressed', 'false'));
    document.querySelectorAll('.value-card[data-flow], .vf-mobile-flow[data-flow]').forEach((control) => control.setAttribute('aria-pressed', 'false'));
    if (detail) detail.hidden = true;
    draw();
  }

  function selectFlow(id) {
    if (selectedFlow === id && !selectedComponent) {
      clearSelection();
      return;
    }
    selectedFlow = id;
    selectedComponent = null;
    document.querySelectorAll('.vf-card').forEach((card) => card.classList.remove('vf-selected'));
    document.querySelectorAll('.vf-card-select').forEach((control) => control.setAttribute('aria-pressed', 'false'));
    document.querySelectorAll('.value-card[data-flow], .vf-mobile-flow[data-flow]').forEach((control) => {
      control.setAttribute('aria-pressed', String(control.dataset.flow === id));
    });
    const flow = FLOWS.find((candidate) => candidate.id === id);
    if (!flow) {
      clearSelection();
      return;
    }
    showAdherences(`Selected value flow — ${flow.label}`, [flow]);
  }

  function selectComponent(card) {
    if (selectedComponent === card.id && !selectedFlow) {
      clearSelection();
      return;
    }
    selectedComponent = card.id;
    selectedFlow = null;
    document.querySelectorAll('.value-card[data-flow], .vf-mobile-flow[data-flow]').forEach((control) => control.setAttribute('aria-pressed', 'false'));
    document.querySelectorAll('.vf-card').forEach((candidate) => {
      const selected = candidate === card;
      candidate.classList.toggle('vf-selected', selected);
      candidate.querySelector('.vf-card-select')?.setAttribute('aria-pressed', String(selected));
    });
    const flows = FLOWS.filter((flow) => flow.from === card.id || flow.to === card.id);
    showAdherences(`${card.dataset.component} — ${flows.length} connected adherence${flows.length === 1 ? '' : 's'}`, flows);
  }

  document.querySelectorAll('.vf-card[data-component]').forEach((card) => {
    card.querySelector('.vf-card-select')?.addEventListener('click', () => selectComponent(card));
  });

  document.querySelectorAll('.value-card[data-flow], .vf-mobile-flow[data-flow]').forEach((control) => {
    control.addEventListener('click', () => selectFlow(control.dataset.flow));
  });

  document.querySelectorAll('.vf-fold-btn').forEach((btn) => {
    btn.addEventListener('click', (event) => {
      event.stopPropagation();
      const fold = document.getElementById(btn.dataset.fold);
      if (!fold) return;
      const expanded = !fold.classList.contains('open');
      fold.classList.toggle('open', expanded);
      fold.hidden = !expanded;
      btn.setAttribute('aria-expanded', String(expanded));
      btn.textContent = `${expanded ? '▾' : '▸'} components`;
      draw();
    });
  });

  window.addEventListener('resize', draw);
  draw();
</script>
