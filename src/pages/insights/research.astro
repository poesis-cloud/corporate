---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const category = 'Research';
const posts = (await getCollection('insights'))
  .filter((p) => p.data.category === category)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const insightHref = (id: string) => `/insights/${id.replace(/\.md$/, '')}`;

/** Editorial map of what each premise implies, downstream — curated, since a citation graph can't be inferred automatically. */
const appliesIn: Record<string, { label: string; slug: string }[]> = {
  'as-probabilistic-as-human-intelligence': [
    { label: 'agentic harness', slug: 'what-is-an-agentic-harness' },
    { label: 'agentic SAFe', slug: 'agentic-safe' },
  ],
  'governance-owns-the-concerns': [
    { label: 'agentic AI governance', slug: 'agentic-ai-governance-that-executes' },
  ],
  'definition-versus-description': [
    { label: 'governed world model', slug: 'the-governed-world-model' },
    { label: 'autonomous enterprise', slug: 'the-autonomous-enterprise' },
    { label: 'digital twin', slug: 'digital-twin-of-an-organization' },
  ],
  'the-generative-inversion': [
    { label: 'spec-driven development', slug: 'spec-driven-development-without-spec-drift' },
    { label: 'digital twin', slug: 'digital-twin-of-an-organization' },
  ],
  'governed-context-versus-retrieval': [
    { label: 'agentic AI governance (conduct vs. consequence)', slug: 'agentic-ai-governance-that-executes' },
  ],
  'governed-synthetic-autopoiesis': [
    { label: 'autonomous enterprise', slug: 'the-autonomous-enterprise' },
    { label: 'agentic harness', slug: 'what-is-an-agentic-harness' },
  ],
};
const premises = posts.filter((p) => p.data.tags.includes('Premise'));
---
<BaseLayout
  title="Research notes"
  description="Poesis research notes — controlled experiments, benchmarks, and reference-design notes on governed systems and agentic delivery."
  pageType={category}
>
  <section class="hero">
    <div class="container">
      <p class="eyebrow"><a href="/#insights">{category} · Insights</a></p>
      <h1>Research notes</h1>
      <p class="lead">Controlled experiments, benchmarks, and reference-design notes from the Poesis engineering team.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">How these ideas fit together</p>
        <h2>A small set of premises, and what follows from them.</h2>
        <p class="lead">These notes are not independent essays. A handful of foundational pieces, tagged <span class="tag">Premise</span> below, state the premises; the rest are what those premises imply once applied to a specific question.</p>
      </div>
      <div class="grid grid-2" style="margin-top:1.5rem">
        {premises.map((post) => (
          <article class="card card--static">
            <span class="tag">Premise</span>
            <h3><a href={insightHref(post.id)}>{post.data.title}</a></h3>
            <p>{post.data.summary}</p>
            {appliesIn[post.id.replace(/\.md$/, '')] && (
              <p class="pain-addressed">
                Applied in:{' '}
                {appliesIn[post.id.replace(/\.md$/, '')].map((a, i) => (
                  <>
                    {i > 0 && ' · '}
                    <a href={insightHref(a.slug)}>{a.label}</a>
                  </>
                ))}
              </p>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="grid grid-2">
        {posts.map((post) => (
          <article class="card card--feature card--static">
            <span class="tag">{post.data.category}</span>
            {post.data.tags.includes('Premise') && <span class="tag tag--value">Premise</span>}
            <h3><a href={insightHref(post.id)}>{post.data.title}</a></h3>
            <p>{post.data.summary}</p>
            <time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
