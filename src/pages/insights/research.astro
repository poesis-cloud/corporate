---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const category = 'Research';
const posts = (await getCollection('insights'))
  .filter((p) => p.data.category === category)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const insightHref = (id: string) => `/insights/${id.replace(/\.md$/, '')}`;
---
<BaseLayout
  title="Research notes"
  description="Poesis research notes — controlled experiments, benchmarks, and reference-design notes on governed systems and agentic delivery."
  pageType={category}
>
  <section class="hero">
    <div class="container">
      <p class="eyebrow"><a href="/#insights">{category} · Insights</a></p>
      <h1>Research notes</h1>
      <p class="lead">Controlled experiments, benchmarks, and reference-design notes from the Poesis engineering team.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">How these ideas fit together</p>
        <h2>A small set of premises, and what follows from them.</h2>
        <p class="lead">These notes are not independent essays. A handful of foundational pieces state the premises; the rest are what those premises imply once applied to a specific question.</p>
      </div>
      <div class="grid grid-2" style="margin-top:1.5rem">
        <article class="card card--static">
          <span class="tag">Premise</span>
          <h3><a href="/insights/as-probabilistic-as-human-intelligence/">Generative AI is as probabilistic as human intelligence</a></h3>
          <p>Reasoners — human or model — get reliability from institutions, never from being made deterministic. Applied in: <a href="/insights/what-is-an-agentic-harness/">agentic harness</a>, <a href="/insights/agentic-safe/">agentic SAFe</a>.</p>
        </article>
        <article class="card card--static">
          <span class="tag">Premise</span>
          <h3><a href="/insights/governance-owns-the-concerns/">Governance owns the concerns</a></h3>
          <p>Concerns are owned by stakeholders and carried by governance; the model proposes, the stack and the human dispose. Applied in: <a href="/insights/agentic-ai-governance-that-executes/">agentic AI governance</a>.</p>
        </article>
        <article class="card card--static">
          <span class="tag">Premise</span>
          <h3><a href="/insights/definition-versus-description/">Definition versus description</a></h3>
          <p>A definition constitutes standing; a description only reports it. Applied in: <a href="/insights/the-governed-world-model/">governed world model</a>, <a href="/insights/the-autonomous-enterprise/">autonomous enterprise</a>, <a href="/insights/digital-twin-of-an-organization/">digital twin</a>.</p>
        </article>
        <article class="card card--static">
          <span class="tag">Premise</span>
          <h3><a href="/insights/the-generative-inversion/">The generative inversion</a></h3>
          <p>The definition generates the system, rather than the system being described after the fact. Applied in: <a href="/insights/spec-driven-development-without-spec-drift/">spec-driven development</a>, <a href="/insights/digital-twin-of-an-organization/">digital twin</a>.</p>
        </article>
        <article class="card card--static">
          <span class="tag">Premise</span>
          <h3><a href="/insights/governed-context-versus-retrieval/">Governed context or document retrieval</a></h3>
          <p>Governed context answers standing; retrieval only answers resemblance. Applied in: <a href="/insights/agentic-ai-governance-that-executes/">agentic AI governance</a> (conduct vs. consequence).</p>
        </article>
        <article class="card card--static">
          <span class="tag">Premise</span>
          <h3><a href="/insights/governed-synthetic-autopoiesis/">Governed synthetic autopoiesis</a></h3>
          <p>Self-production needs a conserved organization, or it is dissolution on a schedule. Applied in: <a href="/insights/the-autonomous-enterprise/">autonomous enterprise</a>, <a href="/insights/what-is-an-agentic-harness/">agentic harness</a>.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="grid grid-2">
        {posts.map((post) => (
          <article class="card card--feature card--static">
            <span class="tag">{post.data.category}</span>
            <h3><a href={insightHref(post.id)}>{post.data.title}</a></h3>
            <p>{post.data.summary}</p>
            <time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
