---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const category = 'Research';
const posts = (await getCollection('insights'))
  .filter((p) => p.data.category === category)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const insightHref = (id: string) => `/insights/${id.replace(/\.md$/, '')}`;
---
<BaseLayout
  title="Research notes"
  description="Poesis research notes — controlled experiments, benchmarks, and reference-design notes on governed systems and agentic delivery."
  pageType={category}
>
  <section class="hero">
    <div class="container">
      <p class="eyebrow"><a href="/#insights">{category} · Insights</a></p>
      <h1>Research notes</h1>
      <p class="lead">Controlled experiments, benchmarks, and reference-design notes from the Poesis engineering team.</p>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="grid grid-2">
        {posts.map((post) => (
          <article class="card card--feature card--static">
            <span class="tag">{post.data.category}</span>
            <h3><a href={insightHref(post.id)}>{post.data.title}</a></h3>
            <p>{post.data.summary}</p>
            <time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
