---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('insights')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const categories = [...new Set(posts.map((p) => p.data.category))];
const insightHref = (id: string) => `/insights/${id.replace(/\.md$/, '')}`;
---
<BaseLayout
  title="Insights"
  description="Case studies and research from Poesis."
  pageType="Insights"
>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Insights</p>
      <h1>How Poesis is applied, argued, and advanced.</h1>
      <p class="lead">Case studies and research notes on governed synthetic autopoiesis, systemic IT governance, and agentic delivery.</p>
      <div class="hero-cta">
        <a class="btn btn-ghost" href="/contact"><Icon name="message" /> Talk to us</a>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="insights-grid" id="insights-results">
        {categories.map((category) => (
          <div class="insight-group" data-category={category}>
            <h2>{category}</h2>
            <div class="grid grid-2">
              {posts.filter((p) => p.data.category === category).map((post) => (
                <article class="card card--feature card--static">
                  <span class="tag">{post.data.category}</span>
                  <h3><a href={insightHref(post.id)}>{post.data.title}</a></h3>
                  <p>{post.data.summary}</p>
                  <time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
                </article>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
