---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const category = 'Publications';
const posts = (await getCollection('insights'))
  .filter((p) => p.data.category === category)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<BaseLayout
  title={`${category} · Insights`}
  description={`Poesis ${category.toLowerCase()} — formal papers and standard-stewardship documents.`}
>
  <section class="hero">
    <div class="container">
      <p class="eyebrow"><a href="/insights">Insights</a> / {category}</p>
      <h1>{category}</h1>
      <p class="lead">Formal papers, standard-stewardship documents, and long-form reference material.</p>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="grid grid-2">
        {posts.map((post) => (
          <article class="card card--feature card--static">
            <span class="tag">{post.data.category}</span>
            <h3><a href={`/insights/${post.id}`}>{post.data.title}</a></h3>
            <p>{post.data.summary}</p>
            <time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
