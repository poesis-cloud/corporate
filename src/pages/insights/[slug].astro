---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthorCard from '../../components/AuthorCard.astro';
import RoadmapNote from '../../components/RoadmapNote.astro';
import { getCollection, render } from 'astro:content';
import { getAuthor } from '../../data/authors';

export async function getStaticPaths() {
  const posts = await getCollection('insights');
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const author = getAuthor(post.data.author);
---
<BaseLayout
  title={post.data.title}
  description={post.data.summary}
  pageType={post.data.category}
  article={{
    publishedTime: post.data.date.toISOString(),
    authorName: author.name,
    authorUrl: author.linkedin,
  }}
>
  <article class="article">
    <div class="container narrow">
      <p class="eyebrow">{post.data.category}</p>
      <h1>{post.data.title}</h1>
      <p class="lead">{post.data.summary}</p>
      <time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
      <AuthorCard authorId={post.data.author} />
      <RoadmapNote />
      <div class="article-body">
        <Content />
      </div>
      <p style="margin-top:2.5rem"><a href="/insights/research">&larr; All insights</a></p>
    </div>
  </article>
</BaseLayout>
