---
import CatalogLayout from '../../layouts/CatalogLayout.astro';
import CatalogDirectory from '../../components/CatalogDirectory.astro';
import { services } from '../../data/services.ts';
import { serviceCard } from '../../data/catalog-card.ts';

const cards = services.map(serviceCard);
---
<CatalogLayout
  title="Poesis services"
  description="Explore the Poesis Pilot, enterprise and agentic transformation, organizational context engineering, ITIP SaaS, SIE SaaS and GSM Certification."
  heading="Services"
  lead="Start with a Poesis Pilot by agreement. Explore six planned offers for organizational transformation, agentic work, governed context, managed applications and engines, and professional qualification."
  count={`${cards.length} services`}
>
  <CatalogDirectory id="services" eyebrow="Services" title="How Poesis is delivered" cards={cards} variant="platform" />
</CatalogLayout>
