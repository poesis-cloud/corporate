---
import CatalogLayout from '../../layouts/CatalogLayout.astro';
import UsageCases from '../../components/UsageCases.astro';
import { poesisUsage } from '../../data/usage.ts';
---
<CatalogLayout
  title="Poesis use cases"
  description="Browse the IT work Poesis is built for, from service ownership and incident impact to definition review, appraisal and delivery."
  heading="Use cases"
  lead="Each use case states a goal and the actors who pursue it. A delivery badge appears only where platform items declare they serve it."
  count={`${poesisUsage.useCases.length} use cases`}
>
  <form slot="controls" class="usage-filters" id="usage-filters" role="search">
    <label>Actor type<select name="actor" id="actor-filter"><option value="">All actor types</option>{poesisUsage.actorTypes.map((actor) => <option value={actor.slug}>{actor.name}</option>)}</select></label>
    <label>Pain<select name="pain" id="pain-filter"><option value="">All pains</option>{poesisUsage.pains.map((pain) => <option value={pain.slug}>{pain.tags.join(' · ')}</option>)}</select></label>
  </form>
  <div id="use-cases"><UsageCases cases={poesisUsage.useCases} title="Workflows and outcomes" browse={false} /></div>
</CatalogLayout>
<style>
  .usage-filters { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1rem; align-items: end; margin-top: 2rem; }
  .usage-filters label { min-width: 0; display: grid; gap: .4rem; font-size: .9rem; }
  select { width: 100%; min-width: 0; min-height: 2.75rem; background: var(--bg-soft); color: var(--ink); border: 1px solid var(--line-strong); border-radius: 4px; padding: .5rem; font: inherit; }
  @media (max-width: 640px) { .usage-filters { grid-template-columns: minmax(0, 1fr); } }
</style>