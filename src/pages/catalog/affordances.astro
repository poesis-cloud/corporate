---
import CatalogLayout from '../../layouts/CatalogLayout.astro';
import CatalogDirectory from '../../components/CatalogDirectory.astro';
import { usageAffordances } from '../../data/usage.ts';
import { affordanceCard } from '../../data/catalog-card.ts';

const cards = usageAffordances.map(affordanceCard);
---
<CatalogLayout
  title="Poesis affordances"
  description="What the Poesis platform lets people and agents do, with the capabilities behind each affordance and the use cases it serves."
  heading="Affordances"
  lead="What the platform lets people and agents do. Each affordance is delivered only when an accepted route of supporting capabilities is."
  count={`${cards.length} affordances`}
>
  <CatalogDirectory id="affordances" eyebrow="Affordances" title="What the platform makes possible" cards={cards} variant="platform" />
</CatalogLayout>
