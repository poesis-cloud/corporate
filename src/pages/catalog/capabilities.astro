---
import CatalogLayout from '../../layouts/CatalogLayout.astro';
import CatalogDirectory from '../../components/CatalogDirectory.astro';
import { usageCapabilities } from '../../data/usage.ts';
import { capabilityCard } from '../../data/catalog-card.ts';

const cards = usageCapabilities.map(capabilityCard);
---
<CatalogLayout
  title="Poesis capabilities"
  description="The solution capabilities behind Poesis affordances, each with its contributing features and the use cases it serves."
  heading="Capabilities"
  lead="What each solution can do, built from product features. A capability carries the status of the features that prove it."
  count={`${cards.length} capabilities`}
>
  <CatalogDirectory id="capabilities" eyebrow="Capabilities" title="What each solution can do" cards={cards} variant="platform" />
</CatalogLayout>
