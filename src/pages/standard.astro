---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="GSM has moved"
  description="The Generative System Model product page is now available at /gsm."
>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Generative System Model</p>
      <h1>This page has moved to /gsm.</h1>
      <p class="lead">The canonical product page for the Generative System Model is now <a href="/gsm">poesis.cloud/gsm</a>.</p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="/gsm">Open the Generative System Model page</a>
      </div>
    </div>
  </section>
</BaseLayout>