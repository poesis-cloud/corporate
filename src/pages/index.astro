---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import DeliveryStatus from '../components/DeliveryStatus.astro';
import ArchMap from '../components/ArchMap.astro';
import PlatformValues from '../components/PlatformValues.astro';
import CatalogCard from '../components/CatalogCard.astro';
import { poesisUsage, useCaseStatus } from '../data/usage.ts';
import { useCaseCard } from '../data/catalog-card.ts';
import { plannedClass } from '../data/poesis-platform.ts';
import ThinkBottleneckDiagram from '../components/ThinkBottleneckDiagram.astro';
import ThinkTherapyDiagram from '../components/ThinkTherapyDiagram.astro';
import { actorTypes } from '../data/usage-actors.ts';
import { services } from '../data/services.ts';

/** The homepage shows what the platform already serves; the catalogs hold the full backlog. */
const currentUseCases = poesisUsage.useCases.filter((useCase) => useCaseStatus(useCase) === 'delivered');
const usageActorGroups = [
  { label: 'People', actors: actorTypes.filter((actor) => actor.kind === 'human') },
  { label: 'Systems', actors: actorTypes.filter((actor) => actor.kind === 'system') },
].filter((group) => group.actors.length > 0);
---
<BaseLayout title="The Organizational Intelligence Platform" pageType="Home">
  <section class="hero home-hero hero--split">
    <div class="container">
      <p class="eyebrow">The foundation of the autonomous enterprise</p>
      <h1>The Organizational Intelligence Platform.</h1>
      <p class="lead">AI is entering sociotechnical organizations it doesn't understand. Humans have always scrambled in the same way. No technology has ever supplied a satisfactory capability to understand, define and realize the organization coherently end-to-end.</p>
      <p class="lead">Poesis grounds humans and AI in a coherent end-to-end system that manages Definitions of any sociotechnical organization — its DNA — <strong>to efficiently and continuously define, govern and generate that organization</strong>.</p>
      <div class="hero-promise">
        <p>The DNA of the organization constitutes a living digital twin — the foundation for <strong>accelerating THINK, BUILD and RUN adequately</strong>, <strong>ultimately leading to the autonomous enterprise</strong>.</p>
      </div>
      <div class="hero-cta">
        <a class="btn btn-primary" href="/pilot" data-demo-cta="homepage-hero-pilot"><Icon name="play" /> Shape a Pilot</a>
      </div>
      <p class="hero-note">Human-governed Definitions that people and AI can act on.</p>
      <nav class="hero-sections" aria-label="On this page">
        <a href="#pains"><span>Pain points</span></a>
        <a href="#affordances"><span>Affordances</span></a>
        <a href="#usage"><span>Usage</span></a>
        <a href="#qualities"><span>Qualities</span></a>
        <a href="#services"><span>Services</span></a>
        <a href="#portfolio"><span>Platform</span></a>
        <a href="#pilot"><span>Pilot</span></a>
      </nav>
    </div>
  </section>

  <section id="pains" class="section section--soft home-inversion">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Pain points</p>
        <h2>Drift at machine speed, or align at human speed.</h2>
        <p class="lead">This is the central tension of industrial GenAI adoption. GenAI accelerates the production of artifacts, but not the production of Definition and governance required to viably deliver these artifacts.</p>
        <p class="lead">The scarce resource is now more than ever the THINK: the AI and human capacity to define and govern these Definitions for BUILD to generate from and RUN to maintain from.</p>
      </div>
      <ThinkBottleneckDiagram />
    </div>
  </section>

  <section id="affordances" class="section home-therapy">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Affordances</p>
        <h2>The Poesis Gene Therapy</h2>
        <p class="lead"><strong>Poesis resolves the historical THINK pathology &mdash; for AI, people, and programmatic tools, to accelerate THINK, BUILD and RUN at the expected rate and safety.</strong></p>
      </div>
      <ThinkTherapyDiagram />
    </div>
  </section>

  <section id="usage" class="section section--soft home-usage">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Usage</p>
        <h2>The organization becomes intelligible.</h2>
        <p class="lead">To the people and the machines who think, build, and run it. Definitions stop being prose: a structured causal context that can be reasoned over, taught, governed, simulated, and continuously evaluated.</p>
      </div>

      <h3 class="home-usage-subhead">Who is it for</h3>
      <div class="home-usage-filter">
        <div class="field home-usage-field">
          <label for="usage-actor">Actor type</label>
          <select id="usage-actor">
            <option value="">Everyone</option>
            {usageActorGroups.map((group) => (
              <optgroup label={group.label}>
                {group.actors.map((actor) => <option value={actor.slug} data-hook={actor.hook}>{actor.name}</option>)}
              </optgroup>
            ))}
          </select>
        </div>
        <p class="home-usage-hook" id="usage-actor-hook" hidden></p>
      </div>

      <h3 class="home-usage-subhead">What they do with it</h3>
      <ul class="think-consequence-list catalog-grid usage-case-list home-usage-cases">
        {currentUseCases.map((useCase) => <CatalogCard card={useCaseCard(useCase)} as="h4" />)}
      </ul>
      <p class="home-usage-empty" id="usage-empty" hidden>No delivered use case names this actor type yet. <a href="/usage">Browse all use cases &rarr;</a></p>

      <h3 class="home-usage-subhead">What it is worth</h3>
      <PlatformValues />

      <div class="hero-cta home-usage-cta">
        <a class="btn btn-primary" href="/pilot" data-demo-cta="homepage-usage-pilot"><Icon name="play" /> Shape your Pilot</a>
        <a class="btn btn-ghost" href="/usage"><Icon name="grid" /> Discover the catalog</a>
      </div>
    </div>
  </section>

  <section id="qualities" class="section home-postures">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Qualities</p>
        <h2>Added to your estate, never taken from it.</h2>
        <p class="lead">Two qualities of the governed THINK layer: how portable it stays inside your control boundary, and how it fits what you already run.</p>
      </div>

      <div id="deployment" class="home-posture">
        <h3>Portability &amp; sovereignty</h3>
        <p class="home-posture__lead">Local, self-hosted and hosted routes each carry their own acceptance boundary.</p>
        <ul class="think-consequence-list home-deployment-list">
        <li>
          <span class="think-consequence__head"><span class="think-consequence__icon"><Icon name="spark" size={16} /></span><span class="think-consequence__step">Model-independent</span></span>
          <strong>Governance does not depend on one provider</strong>
          <p>Model profiles support selection for bounded tasks. Each host mapping and model change needs compatibility and quality checks.</p>
        </li>
        <li>
          <span class="think-consequence__head"><span class="think-consequence__icon"><Icon name="shield" size={16} /></span><span class="think-consequence__step">Local and sovereign</span></span>
          <strong>Define the data boundary explicitly</strong>
          <p>Local execution supports control, but models, tools, telemetry, remotes and backups can transmit data. Egress and retention policies remain necessary.</p>
        </li>
        <li>
          <span class="think-consequence__head"><span class="think-consequence__icon"><Icon name="layers" size={16} /></span><span class="think-consequence__step">Cloud where appropriate</span></span>
          <strong>Managed infrastructure without ceding control</strong>
          <p>Deploy services through managed infrastructure where it makes sense, while the control boundary stays explicit rather than assumed.</p>
        </li>
        <li>
          <span class="think-consequence__head"><span class="think-consequence__icon"><Icon name="check-badge" size={16} /></span><span class="think-consequence__step">Vendor-neutral standard</span></span>
          <strong>Governance you can inspect, not a black box</strong>
          <p>GSM is a candidate common Definition model. Interchange requirements support inspectability; compatible consumers and draft-preserving migration still need acceptance.</p>
        </li>
        <li>
          <span class="think-consequence__head"><span class="think-consequence__icon"><Icon name="github" size={16} /></span><span class="think-consequence__step">Open and inspectable</span></span>
          <strong>Trust cannot be proprietary</strong>
          <p>GSM specification content exists in source, with publication pending. SAF local tools use Apache-2.0; SIE and the planned bridge have separate licenses. Inspect each product and its terms.</p>
        </li>
      </ul>
      </div>

      <div id="integration" class="home-posture">
        <h3>Interoperability</h3>
        <p class="home-posture__lead">Governed THINK connects to the BUILD and RUN environments you already operate.</p>
        <ul class="think-consequence-list home-integration-list">
        <li>
          <span class="think-consequence__head"><span class="think-consequence__icon"><Icon name="repos" size={16} /></span><span class="think-consequence__step">Git repositories</span><DeliveryStatus state="planned" /></span>
          <strong>Planned candidates from pinned revisions</strong>
          <p>Supported analysis is planned to produce reviewable candidates. Acquisition, conflict reduction and governed registration are distinct steps.</p>
        </li>
        <li>
          <span class="think-consequence__head"><span class="think-consequence__icon"><Icon name="docs" size={16} /></span><span class="think-consequence__step">API contracts</span><DeliveryStatus state="planned" /></span>
          <strong>The interaction surface of your estate</strong>
          <p>Planned adapters describe declared interaction surfaces with explicit coverage. Contracts alone do not prove actual traffic or applicable obligations.</p>
        </li>
        <li>
          <span class="think-consequence__head"><span class="think-consequence__icon"><Icon name="list" size={16} /></span><span class="think-consequence__step">SBOMs</span><DeliveryStatus state="planned" /></span>
          <strong>Planned dependency evidence</strong>
          <p>SBOM analysis identifies declared dependencies in a supported scope. Presence does not prove deployed use, reachability or compliance.</p>
        </li>
        <li>
          <span class="think-consequence__head"><span class="think-consequence__icon"><Icon name="layers" size={16} /></span><span class="think-consequence__step">Infrastructure</span><DeliveryStatus state="planned" /></span>
          <strong>Separate intent from observations</strong>
          <p>Planned infrastructure sourcing reads declared configuration. Deployed identity, observation time and coverage are needed to describe what runs.</p>
        </li>
      </ul>
      <p class="home-integration-note"><DeliveryStatus state="planned" /> The sourcing bench is specified and in build. Named-tool connectors follow as further knowledge sources feeding the same governed model.</p>
      </div>
    </div>
  </section>


  <section id="services" class="section section--soft" aria-labelledby="services-heading">
    <div class="container">
      <div class="section-head">
        <h2 id="services-heading">Services</h2>
      </div>
      <ul class="think-consequence-list">
        {services.map((service) => (
          <li>
            <span class="think-consequence__head"><span class="think-consequence__icon"><Icon name="briefcase" size={16} /></span><span class="think-consequence__step">{service.category}</span></span>
            <h3><a href={service.href}>{service.label}</a></h3>
            <span class="claim-status">{service.availability}</span>
            <p>{service.summary}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="portfolio" class="section home-platform">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Platform</p>
        <h2>Explore the complete solutions and products map.</h2>
        <p class="lead">Specification, source content, local controls and planned integrations contribute in different ways. Explore each product for feature scope and historical version metadata.</p>
      </div>
      <ArchMap />
    </div>
  </section>

  <section id="pilot" class="section section--ink home-pilot">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Pilot</p>
        <h2>Start with the value you seek. Or the pain you feel.</h2>
        <p class="lead">Shape an ITIP + SIE SaaS evaluation around what matters to you. Start with desired values or pain points, add relevant use cases, and define your scope, success criteria, evidence, timing and constraints.</p>
        <p>A discussion brief, not a fixed package. Registered support and gaps stay visible; selected scope, operating readiness and terms are confirmed together before kickoff.</p>
      </div>
      <div class="hero-cta">
        <a class="btn btn-primary" href="/pilot" data-demo-cta="homepage-pilot"><Icon name="play" /> Shape your Pilot</a>
        <a class="btn btn-ghost" href="/services/consulting"><Icon name="briefcase" /> Explore transformation services</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const picker = document.querySelector<HTMLSelectElement>('#usage-actor');
  const cases = [...document.querySelectorAll<HTMLElement>('.home-usage-cases > [data-usage-case]')];
  const hook = document.querySelector<HTMLElement>('#usage-actor-hook');
  const empty = document.querySelector<HTMLElement>('#usage-empty');
  if (picker && cases.length && hook && empty) {
    const apply = () => {
      const actor = picker.value;
      let shown = 0;
      for (const card of cases) {
        card.hidden = Boolean(actor) && !card.dataset.actors?.split(' ').includes(actor);
        if (!card.hidden) shown++;
      }
      const selected = picker.selectedOptions[0];
      hook.textContent = selected?.dataset.hook ?? '';
      hook.hidden = !selected?.dataset.hook;
      empty.hidden = shown > 0;
    };
    picker.addEventListener('change', apply);
    apply();
  }
</script>

<style>
  .home-usage-filter { margin: 0 0 1rem; }
  .home-usage-field { max-width: 24rem; }
  .home-usage-hook { margin: 1rem 0 0; font-size: 1.05rem; }
  .home-usage-subhead { margin: 2.5rem 0 1.75rem; font-size: 1rem; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  .home-usage-cases > li[hidden] { display: none; }
  .home-usage-empty { margin: 1.5rem 0 0; color: var(--muted); }
  .home-usage-cta { margin-top: 2.5rem; }
  @media (max-width: 640px) { .home-usage-cases { grid-template-columns: minmax(0, 1fr); } }
</style>
