---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ArchMap from '../components/ArchMap.astro';
import PlatformValues from '../components/PlatformValues.astro';
import ThinkBottleneckDiagram from '../components/ThinkBottleneckDiagram.astro';
import ThinkTherapyDiagram from '../components/ThinkTherapyDiagram.astro';
import { profilesForDomain } from '../data/profiles.ts';

const itProfiles = profilesForDomain('it');
---
<BaseLayout title="The Organizational Intelligence Platform" pageType="Home">
  <section class="hero home-hero hero--split">
    <div class="container">
      <p class="eyebrow">The foundation of the autonomous enterprise</p>
      <h1>The Organizational Intelligence Platform.</h1>
      <p class="lead">AI is entering organizations it doesn't understand. Humans rarely understand them much better. Poesis grounds both in a coherent system that manages <em>definitions</em> of the organization — its DNA — <strong>to efficiently and continuously generate that organization</strong>.</p>
      <div class="hero-promise">
        <p>The DNA of the organization constitutes a living digital twin — the foundation for <strong>accelerating BUILD and RUN adequately</strong>, and <strong>ultimately for the autonomous enterprise to emerge</strong>.</p>
      </div>
      <div class="hero-cta">
        <a class="btn btn-primary" href="/contact" data-demo-cta="homepage-hero-pilot"><Icon name="play" /> Run a Pilot</a>
      </div>
      <p class="hero-note">Human-governed definitions that people and AI can act on.</p>
      <nav class="hero-sections" aria-label="On this page">
        <a href="#pains"><span>Pain points</span></a>
        <a href="#affordances"><span>Affordances</span></a>
        <a href="#values"><span>Values</span></a>
        <a href="#deployment"><span>Deployment posture</span></a>
        <a href="#integration"><span>Integration posture</span></a>
        <a href="#personas"><span>Persona targets</span></a>
        <a href="#pilot"><span>Start with one workflow</span></a>
        <a href="#portfolio"><span>The Poesis platform</span></a>
      </nav>
    </div>
  </section>

  <section id="pains" class="section section--soft home-inversion">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Pain points</p>
        <h2>Drift at machine speed, or align at human speed.</h2>
        <p class="lead">This is the central tension of industrial GenAI adoption. GenAI accelerates the production of artifacts, but not the production of definition and governance required to viably deliver these artifacts.</p>
        <p class="lead">The scarce resource is now more than ever the THINK: the AI and human capacity to understand, define, plan, validate, and take responsibility for what has been created.</p>
      </div>
      <ThinkBottleneckDiagram />
    </div>
  </section>

  <section id="affordances" class="section home-therapy">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Affordances</p>
        <h2>Poesis Gene Therapy</h2>
        <p class="lead"><strong>Poesis resolves the historical THINK pathology &mdash; for GenAI, people, and programmatic tools, to safely accelerate BUILD and RUN at the expected rate.</strong></p>
      </div>
      <ThinkTherapyDiagram />
    </div>
  </section>

  <section id="values" class="section section--soft home-values">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Values</p>
        <h2>The organization becomes intelligible.</h2>
        <p class="lead">To the people and the machines who think, build, and run it. Definitions stop being prose: a structured causal context that can be reasoned over, taught, governed, simulated, and continuously evaluated.</p>
      </div>
      <PlatformValues />
    </div>
  </section>

  <section id="deployment" class="section section--soft home-deployment">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Deployment posture</p>
        <h2>Your models. Your systems. Your control boundary.</h2>
        <p class="lead">Poesis adds a governed THINK layer that runs where you decide, on the models you choose, in a format you can take with you.</p>
      </div>
      <ul class="think-consequence-list home-deployment-list">
        <li>
          <span class="think-consequence__head"><span class="think-consequence__icon"><Icon name="spark" size={16} /></span><span class="think-consequence__step">Model-independent</span></span>
          <strong>Governance does not depend on one provider</strong>
          <p>Use the models appropriate to each bounded task &mdash; and change them &mdash; without the governed definition or its guarantees moving with them.</p>
        </li>
        <li>
          <span class="think-consequence__head"><span class="think-consequence__icon"><Icon name="shield" size={16} /></span><span class="think-consequence__step">Local and sovereign</span></span>
          <strong>Sensitive state never leaves your boundary</strong>
          <p>THINK and RUN state stays inside environments you control, so the organizational definition remains yours by deployment, not by policy alone.</p>
        </li>
        <li>
          <span class="think-consequence__head"><span class="think-consequence__icon"><Icon name="layers" size={16} /></span><span class="think-consequence__step">Cloud where appropriate</span></span>
          <strong>Managed infrastructure without ceding control</strong>
          <p>Deploy services through managed infrastructure where it makes sense, while the control boundary stays explicit rather than assumed.</p>
        </li>
        <li>
          <span class="think-consequence__head"><span class="think-consequence__icon"><Icon name="check-badge" size={16} /></span><span class="think-consequence__step">Vendor-neutral standard</span></span>
          <strong>Governance you can inspect, not a black box</strong>
          <p>Poesis is delivered on GSM &mdash; the vendor-neutral standard for defining systems, as OpenTelemetry is the vendor-neutral standard for observing them. Your governed model is typed and portable rather than trapped in a product format.</p>
        </li>
        <li>
          <span class="think-consequence__head"><span class="think-consequence__icon"><Icon name="github" size={16} /></span><span class="think-consequence__step">Open and inspectable</span></span>
          <strong>Trust cannot be proprietary</strong>
          <p>The GSM standard is published openly, the SAF framework is Apache-2.0, and the engine is source-available on a scheduled path to open &mdash; a stack asked to carry an organization&rsquo;s definitions must be inspectable by the organizations asked to trust it.</p>
        </li>
      </ul>
    </div>
  </section>

  <section id="integration" class="section home-integration">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Integration posture</p>
        <h2>The definition layer, not a replacement.</h2>
        <p class="lead">Poesis does not ask you to rip anything out: governed THINK connects to the BUILD and RUN environments you already operate. The sourcing bench targets the artifacts your stack already produces, and the governed model it builds is a substrate your existing tools can consume.</p>
      </div>
      <ul class="think-consequence-list home-integration-list">
        <li>
          <span class="think-consequence__head"><span class="think-consequence__icon"><Icon name="repos" size={16} /></span><span class="think-consequence__step">Git repositories<span class="planned-mark" aria-hidden="true"></span></span></span>
          <strong>What is committed becomes definition</strong>
          <p>Source code is read continuously &mdash; code index, property graph, and dependency analysis turn what is committed into evidence-backed definition contributions.</p>
        </li>
        <li>
          <span class="think-consequence__head"><span class="think-consequence__icon"><Icon name="docs" size={16} /></span><span class="think-consequence__step">API contracts<span class="planned-mark" aria-hidden="true"></span></span></span>
          <strong>The interaction surface of your estate</strong>
          <p>OpenAPI and service contracts source who talks to whom, through what, under which obligations &mdash; interactions as governed definitions rather than tribal knowledge.</p>
        </li>
        <li>
          <span class="think-consequence__head"><span class="think-consequence__icon"><Icon name="list" size={16} /></span><span class="think-consequence__step">SBOMs<span class="planned-mark" aria-hidden="true"></span></span></span>
          <strong>Supply-chain truth, qualified</strong>
          <p>Software bills of materials anchor supply-chain truth &mdash; every dependency identified with confidence and provenance attached to the claim.</p>
        </li>
        <li>
          <span class="think-consequence__head"><span class="think-consequence__icon"><Icon name="layers" size={16} /></span><span class="think-consequence__step">Infrastructure<span class="planned-mark" aria-hidden="true"></span></span></span>
          <strong>The running shape, not the intended one</strong>
          <p>Kubernetes and Helm artifacts source what is actually deployed, so RUN reality feeds back into the definition instead of diverging from it silently.</p>
        </li>
      </ul>
      <p class="home-integration-note"><span class="planned-mark" aria-hidden="true"></span>On roadmap: the sourcing bench is specified and in build, not delivered. Named-tool connectors &mdash; ServiceNow CMDB, Backstage catalogs, EA repositories &mdash; follow as further knowledge sources feeding the same governed model.</p>
    </div>
  </section>

  <section id="personas" class="section section--soft home-personas">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Persona targets</p>
        <h2>Every IT profile, one governed model.</h2>
        <p class="lead">Architects author, developers consult, ops watch drift, security proves posture &mdash; all on the same governed definitions, with no translation silos between them. IT is the entry point by design: the business domains the IT organization serves are reached through the model it already governs.</p>
      </div>
      <ul class="think-consequence-list home-persona-list">
        {itProfiles.map((profile) => (
          <li id={profile.id}>
            <span class="think-consequence__head"><span class="think-consequence__icon"><Icon name={profile.icon} size={16} /></span><span class="think-consequence__step">{profile.name}</span></span>
            <strong>{profile.hook}</strong>
            <p>{profile.body}</p>
            <p class="home-persona-cta"><a href={profile.cta.href} data-profile-cta={profile.id}>{profile.cta.label} &rarr;</a></p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="pilot" class="section section--ink home-pilot">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Start with one real workflow</p>
        <h2>Find where it hurts. Prove governed acceleration there.</h2>
        <p class="lead">Wherever your pain sits &mdash; stale knowledge, drifting delivery, opaque operations &mdash; it is the same THINK pathology surfacing in a different phase. Pick that workflow, make THINK explicit, then test how people, software, and AI perform across the governed loop.</p>
      </div>
      <ul class="think-consequence-list home-pilot-entries">
        <li id="use-case-think">
          <span class="think-consequence__head"><span class="think-consequence__icon"><Icon name="compass" size={16} /></span><span class="think-consequence__step">01 &middot; THINK</span></span>
          <strong>Know what your organization actually is</strong>
          <p>Your architecture docs, compliance registers, and tribal knowledge drift the moment they are written. Source definitions automatically from people, code, contracts, and infrastructure into one governed digital twin &mdash; evaluated for validity and coherence before anything depends on it.</p>
          <p class="home-usecase-proof"><span>Backed by</span>Automatic truth sourcing &middot; Governed organizational context</p>
        </li>
        <li id="use-case-build">
          <span class="think-consequence__head"><span class="think-consequence__icon"><Icon name="layers" size={16} /></span><span class="think-consequence__step">02 &middot; BUILD</span></span>
          <strong>Build without rebuilding the intent</strong>
          <p>Every team, review, and AI agent reconstructs context from scratch &mdash; and reconstruction is where drift enters. Give people and machines the same machine-operable definitions to build from, with deterministic checks and human gates deciding what enters into effect.</p>
          <p class="home-usecase-proof"><span>Backed by</span>Generative delivery &middot; Governance lifecycle</p>
        </li>
        <li id="use-case-run">
          <span class="think-consequence__head"><span class="think-consequence__icon"><Icon name="play" size={16} /></span><span class="think-consequence__step">03 &middot; RUN</span></span>
          <strong>Operate what you defined &mdash; provably</strong>
          <p>Operations run on assumptions nobody can verify, and audits reconstruct the past under pressure. Put definitions into effect over human, software, and agentic action &mdash; every divergence surfaces as it appears, with evidence flowing back to THINK.</p>
          <p class="home-usecase-proof"><span>Backed by</span>Continuous norm evaluation &middot; Composed governance fabric</p>
        </li>
      </ul>
      <ol class="think-consequence-list home-pilot-steps">
        <li>
          <span class="think-consequence__head"><span class="think-consequence__icon">01</span><span class="think-consequence__step">Frame THINK</span></span>
          <p>Identify purpose, actors, evidence, constraints, and human decisions.</p>
        </li>
        <li>
          <span class="think-consequence__head"><span class="think-consequence__icon">02</span><span class="think-consequence__step">Govern THINK</span></span>
          <p>Source intent and RUN reality into a governed, machine-operable definition.</p>
        </li>
        <li>
          <span class="think-consequence__head"><span class="think-consequence__icon">03</span><span class="think-consequence__step">Connect BUILD + RUN</span></span>
          <p>Let bounded software, mechanisms, people, and agents use the governed definition.</p>
        </li>
        <li>
          <span class="think-consequence__head"><span class="think-consequence__icon">04</span><span class="think-consequence__step">Evaluate the loop</span></span>
          <p>Measure BUILD and RUN speed, rework, control, and traceability against the starting point.</p>
        </li>
      </ol>
      <div class="hero-cta">
        <a class="btn btn-primary" href="/contact" data-demo-cta="homepage-pilot"><Icon name="play" /> Run a Pilot</a>
        <a class="btn btn-ghost" href="/services/consulting"><Icon name="briefcase" /> Explore transformation services</a>
      </div>
    </div>
  </section>

  <section id="portfolio" class="section home-platform">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">The Poesis platform</p>
        <h2>Explore the complete solutions and products map.</h2>
        <p class="lead">No phase belongs to a product: every Poesis solution &mdash; ITIP, SAF, SIE &mdash; operates across the governed THINK &rarr; BUILD &rarr; RUN loop, because they all act on the same governed definitions. Open the product and feature groups to inspect what exists, what is planned, and how the portfolio fits together.</p>
      </div>
      <ArchMap />
    </div>
  </section>
</BaseLayout>
