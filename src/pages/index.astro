---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ThinkBottleneckDiagram from '../components/ThinkBottleneckDiagram.astro';
import { poesisPortfolio } from '../data/poesis-portfolio.ts';

const platformResponsibilities: Record<string, string> = {
  gsm: 'Defines systems in a shared, machine-readable model.',
  sie: 'Manages governed definitions and executes what they authorize.',
  itip: 'Provides the IT organizational twin and the human surface for governing it.',
  saf: 'Organizes governed agentic work from intent through delivery.',
};

const platform = poesisPortfolio.map(({ slug, name, fullName, href, products }) => ({
  slug,
  name,
  fullName,
  href,
  responsibility: platformResponsibilities[slug],
  harness: slug === 'saf' ? products.find((product) => product.slug === 'agentic-harness') : undefined,
}));

const shippedProductSlugs = new Set([
  'agentic-harness',
  'definition-manager',
  'definition-blackboard-manager',
]);

const shippedProducts = poesisPortfolio.flatMap((solution) =>
  solution.products
    .filter((product) => shippedProductSlugs.has(product.slug))
    .map((product) => ({ ...product, solutionHref: solution.href })),
);
---
<BaseLayout title="Resolve THINK before AI accelerates BUILD and RUN" pageType="Home">
  <section class="hero home-hero">
    <div class="container">
      <p class="eyebrow">The control point before generation</p>
      <h1>Resolve THINK before AI accelerates BUILD and RUN.</h1>
      <p class="lead">Organizations do not struggle to produce more output. They struggle to make intent, architecture, policy, and constraints explicit enough for people and machines to act on them reliably.</p>
      <p class="home-hero__promise">Poesis uses AI upstream to help form governed, machine-operable definitions, so downstream work can move faster without outrunning authorization, validation, human disposition, or traceability.</p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="/contact" data-demo-cta="homepage-hero-pilot"><Icon name="play" /> Run a Pilot</a>
        <a class="btn btn-ghost" href="#bottleneck"><Icon name="arrow-right" /> See the bottleneck</a>
      </div>
      <p class="hero-note">AI-assisted, human-governed · Model-independent · Traceable by construction</p>
    </div>
  </section>

  <section id="bottleneck" class="section section--soft home-problem">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">The problem</p>
        <h2>AI made production abundant. It did not make purpose precise.</h2>
        <p class="lead">When THINK stays implicit, faster BUILD creates more material to interpret, review, repair, and govern. RUN inherits every unresolved assumption.</p>
      </div>
      <ThinkBottleneckDiagram />
    </div>
  </section>

  <section id="mechanism" class="section home-mechanism">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">How Poesis works</p>
        <h2>Govern the definition before automating the action.</h2>
        <p class="lead">Poesis brings two sources of truth into one governed account: what people intend and what the operating system reveals.</p>
      </div>
      <div class="home-definition-flow">
        <div class="home-definition-inputs">
          <article>
            <span class="tag">Human intent</span>
            <h3>Purpose and disposition</h3>
            <p>People set direction, obligations, acceptable boundaries, and the decisions that remain human.</p>
          </article>
          <article>
            <span class="tag">Observed reality</span>
            <h3>Evidence from running systems</h3>
            <p>Code, infrastructure, tools, and operational signals contribute what exists and how it behaves.</p>
          </article>
        </div>
        <div class="home-definition-core">
          <span class="tag tag--value">Governed definition</span>
          <h3>A shared, machine-operable account</h3>
          <p>AI helps source and structure the model. Provenance, lifecycle, rules, and human gates determine what becomes authoritative.</p>
        </div>
        <div class="home-definition-actors" aria-label="Actors enabled by governed definitions">
          <span>Humans</span><span>Software</span><span>Mechanisms</span><span>Bounded agents</span>
        </div>
      </div>
    </div>
  </section>

  <section id="outcomes" class="section section--ink home-outcomes">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">What changes</p>
        <h2>Acceleration becomes governable because the reference point stops drifting.</h2>
      </div>
      <div class="home-outcome-grid">
        <article><span class="home-step">01</span><h3>Accelerate BUILD</h3><p>Generate against explicit architecture, constraints, and acceptance conditions instead of reconstructing them in every prompt.</p></article>
        <article><span class="home-step">02</span><h3>Automate RUN</h3><p>Let governed mechanisms and software evaluate state and act within declared authority.</p></article>
        <article><span class="home-step">03</span><h3>Control change</h3><p>Keep lifecycle, provenance, authorization, validation, and human disposition attached to the definition.</p></article>
        <article><span class="home-step">04</span><h3>Trace consequence</h3><p>Connect intent to definition, action, evidence, and outcome without reconstructing the chain after the fact.</p></article>
      </div>
    </div>
  </section>

  <section id="platform" class="section home-platform">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">The Poesis platform</p>
        <h2>Four responsibilities. One governed THINK → BUILD → RUN loop.</h2>
        <p class="lead">The products appear only after the mechanism: each owns a distinct responsibility in forming, managing, applying, or operationalizing governed definitions.</p>
      </div>
      <div class="home-platform-grid">
        {platform.map((solution) => (
          <article class={`home-platform-item home-platform-item--${solution.slug}`}>
            <span class="tag">{solution.name}</span>
            <h3>{solution.fullName}</h3>
            <p>{solution.responsibility}</p>
            {solution.harness && (
              <div class="home-platform-child">
                <span>Within SAF</span>
                <strong>{solution.harness.name}</strong>
                <p>{solution.harness.tagline}</p>
              </div>
            )}
            <a class="btn btn-ghost btn-sm" href={solution.href}><Icon name="arrow-right" /> Explore {solution.name}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="deployment" class="section section--soft home-deployment">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Deployment posture</p>
        <h2>Your models. Your systems. Your control boundary.</h2>
        <p class="lead">Poesis adds a governance and execution layer without requiring a particular model vendor or replacing the enterprise systems that already run the work.</p>
      </div>
      <div class="home-deployment-grid">
        <article><Icon name="spark" size={22} /><h3>Model-independent</h3><p>Use the models appropriate to each bounded task; governance does not depend on one provider.</p></article>
        <article><Icon name="shield" size={22} /><h3>Local and sovereign</h3><p>Keep sensitive execution and working state inside environments you control.</p></article>
        <article><Icon name="layers" size={22} /><h3>Cloud where appropriate</h3><p>Deploy services through managed infrastructure while retaining explicit control boundaries.</p></article>
        <article><Icon name="grid" size={22} /><h3>Built around your estate</h3><p>Bring governed definitions to existing code, cloud, data, IT, and operating processes.</p></article>
      </div>
    </div>
  </section>

  <section id="proof" class="section home-proof">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Shipped proof</p>
        <h2>Three production foundations have reached 1.0.</h2>
        <p class="lead">No future platform capability is presented as shipped. These are the released foundations available now.</p>
      </div>
      <div class="home-proof-grid">
        {shippedProducts.map((product) => (
          <article>
            <span class="tag tag--value">Shipped · v{product.currentVersion}</span>
            <h3>{product.name}</h3>
            <p>{product.description}</p>
            <a class="btn btn-ghost btn-sm" href={`${product.solutionHref}/products/${product.slug}`}><Icon name="arrow-right" /> Product details</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="pilot" class="section section--soft home-pilot">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Start with one real workflow</p>
        <h2>Prove governed acceleration at a useful scale.</h2>
        <p class="lead">Choose a workflow where ambiguity, review load, or control risk currently limits the value of AI. Make its definition explicit, then test the downstream result.</p>
      </div>
      <ol class="home-pilot-steps">
        <li><span>01</span><strong>Discover</strong><p>Identify the workflow, actors, evidence, constraints, and human decisions.</p></li>
        <li><span>02</span><strong>Define</strong><p>Source intent and reality into a governed, machine-operable definition.</p></li>
        <li><span>03</span><strong>Execute</strong><p>Run bounded software, mechanisms, people, and agents against it.</p></li>
        <li><span>04</span><strong>Evaluate</strong><p>Measure speed, rework, control, and traceability against the starting point.</p></li>
      </ol>
      <div class="hero-cta">
        <a class="btn btn-primary" href="/contact" data-demo-cta="homepage-pilot"><Icon name="play" /> Run a Pilot</a>
        <a class="btn btn-ghost" href="/services/consulting"><Icon name="briefcase" /> Explore transformation services</a>
      </div>
    </div>
  </section>

  <section class="section section--ink home-vision">
    <div class="container">
      <p class="eyebrow">The longer horizon</p>
      <h2>Define the world in software; generate it.</h2>
      <p class="lead">When a system carries a governed definition of what it is, what it should do, and what reality reports back, generation can become part of a controlled systemic loop rather than an isolated act of production.</p>
      <p class="home-vision__line">That is the path toward governed synthetic autopoiesis: not AI acting alone, but humans, software, mechanisms, and agents regenerating systems from explicit definitions under governance.</p>
    </div>
  </section>
</BaseLayout>
