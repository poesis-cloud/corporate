---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ArchMap from '../components/ArchMap.astro';
import { services } from '../data/services.ts';
import { getCollection } from 'astro:content';

const insightPosts = (await getCollection('insights'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);
---
<BaseLayout title="Poesis" pageType="Home">
  <section class="hero">
    <div class="container">
      <p class="motto">Define the world in software; generate it.</p>
      <h1>Harnessing generative AI for an age of governed synthetic autopoiesis.</h1>
      <p class="lead">Poesis makes synthetic autopoiesis governable: systems continuously regenerate their organization through generative AI while remaining grounded in explicit definitions, systemic governance, and human oversight.</p>
      <p class="lead">Poesis closes the IT <strong>THINK → BUILD → RUN</strong> loop — <strong>systematically and autonomously, with humans in the loop.</strong>
      <p class="lead">Today, IT's Think — governance and specifications — live in prose — architecture wiki, compliance spreadsheets, review boards — that drifts from reality the moment it is written. Poesis stack turns that prose into governed, typed, versioned, <strong>machine-operable</strong> <i>definitions</i> it can act on, generate from, and continuously enforce.</p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="#portfolio"><Icon name="marketplace" /> Portfolio</a>
        <a class="btn btn-primary" href="#services"><Icon name="external" /> Services</a>
        <a class="btn btn-primary" href="#partnerships"><Icon name="external" /> Partnerships</a>
        <a class="btn btn-primary" href="#insights"><Icon name="docs" /> Insights</a>
        <a class="btn btn-primary" href="#custody"><Icon name="play" /> Custody</a>
        <a class="btn btn-ghost" href="/contact"><Icon name="external" /> Talk to us</a>
      </div>
    </div>
  </section>

  <section id="portfolio" class="section section--soft">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Portfolio</p>
        <h2>An open systemic model standard, an engine implementing it, domain applications on top of it — and the agentic AI generating from that.</h2>
        <p class="lead">GSM roots the <i>definitions</i> (governance intents and specifications) into systemics field; SIE operates the <i>definitions</i>; ITIP applies that to IT; the SAFe Agentic generates <i>definitions</i> and operational artifacts from <i>definitions</i>; and Poesis services deliver the change. Each piece links to the other to close the IT Think-Build-Run loop, <strong>systematically and autonomously</strong>, <strong>with humans in the loop.</strong></p>
      </div>

      <ArchMap />
    </div>
  </section>

  <section id="services" class="section section--soft">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Services</p>
        <h2>Choose how you adopt and operate Poesis.</h2>
        <p class="lead">Transformation, managed cloud, sovereign deployment, or certified delivery capability — each service defines a clear boundary of ownership, risk, and support.</p>
      </div>
      <div class="grid grid-2" style="margin-top:1.5rem">
        {services.map((service) => (
          <article class="card card--feature card--static">
            <span class="tag">{service.category}</span>
            <h3>{service.label}</h3>
            <p>{service.summary}</p>
            <a class="btn btn-ghost btn-sm service-link" href={service.href}><Icon name="external" /> Explore {service.label}</a>
          </article>
        ))}
      </div>
      <p style="margin-top:2.5rem;text-align:center"><a class="btn btn-primary" href="/contact"><Icon name="external" /> Talk to us</a></p>
    </div>
  </section>

  <section id="partnerships" class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Partnership proposals</p>
        <h2>Build the future of governed AI together.</h2>
        <p class="lead">We partner with model providers, systems integrators, and research groups to ground generative capabilities in systemic governance.</p>
      </div>
      <div class="grid grid-2" style="margin-top:1.5rem">
        <article class="card card--feature card--static">
          <span class="tag">LLM vendors</span>
          <h3>LLM Vendor Partnership</h3>
          <p>What the Poesis stack brings to LLM capabilities — and what LLMs bring to Poesis. Models propose; humans dispose through ITIP; SIE evaluates constraints and executes governed Mechanisms.</p>
          <a class="btn btn-ghost btn-sm service-link" href="/partnerships/llm-vendor-value-proposal"><Icon name="external" /> Read the value proposal</a>
        </article>
      </div>
    </div>
  </section>

  <section id="insights" class="section section--soft">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Insights</p>
        <h2>How Poesis is applied, argued, and advanced.</h2>
        <p class="lead">Case studies and research notes on governed synthetic autopoiesis, systemic IT governance, and agentic delivery.</p>
      </div>
      <div class="grid grid-2" style="margin-top:1.5rem">
        {insightPosts.map((post) => (
          <article class="card card--feature card--static">
            <span class="tag">{post.data.category}</span>
            <h3>{post.data.title}</h3>
            <p>{post.data.summary}</p>
            <p class="insight-meta">
              <time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
            </p>
            <a class="btn btn-ghost btn-sm service-link" href={`/insights/${post.id}`}><Icon name="docs" /> Read {post.data.title.split(':')[0]}</a>
          </article>
        ))}
      </div>
      <p style="margin-top:2.5rem;text-align:center"><a class="btn btn-primary" href="/insights"><Icon name="docs" /> Browse all insights</a></p>
    </div>
  </section>

  <section id="custody" class="section section--ink">
    <div class="container">
      <p class="eyebrow">Our first custody</p>
      <h2>Poesis runs on Poesis.</h2>
      <p class="lead">We are our own first customer. The Poesis stack that will integrate your systems already define, build, and govern ours — Poesis's development power rests on the very stack it ships.</p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="/solutions/itip"><Icon name="play" /> Explore ITIP</a>
        <a class="btn btn-ghost" href="/solutions/sie"><Icon name="play" /> Explore SIE</a>
        <a class="btn btn-ghost" href="/solutions/framework"><Icon name="play" /> Explore Agentic Framework</a>
        <a class="btn btn-ghost" href="https://github.com/poesis-cloud"><Icon name="github" /> See it on GitHub</a>
      </div>
    </div>
  </section>
</BaseLayout>
