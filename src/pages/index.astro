---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ArchMap from '../components/ArchMap.astro';
import { services } from '../data/services.ts';
import { getCollection } from 'astro:content';

const insightPosts = (await getCollection('insights'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);
---
<BaseLayout title="Poesis" pageType="Home">
  <section class="hero">
    <div class="container">
      <p class="motto">Define the world in software; generate it.</p>
      <h1>Harnessing generative AI for an age of governed synthetic autopoiesis.</h1>
      <p class="lead">Poesis makes synthetic autopoiesis realizable: for the first time, systems can continuously regenerate their organization through generative AI while remaining grounded in explicit definitions of the world, systemic governance, and human oversight.</p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="#portfolio"><Icon name="grid" /> Portfolio</a>
        <a class="btn btn-primary" href="#services"><Icon name="briefcase" /> Services</a>
        <a class="btn btn-primary" href="#partnerships"><Icon name="handshake" /> Partnerships</a>
        <a class="btn btn-primary" href="#insights"><Icon name="lightbulb" /> Insights</a>
        <a class="btn btn-primary" href="#custody"><Icon name="shield" /> Custody</a>
        <a class="btn btn-ghost" href="/contact"><Icon name="message" /> Talk to us</a>
      </div>
    </div>
  </section>

  <section id="portfolio" class="section section--soft">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Portfolio</p>
        <h2>An innovative solutions stack for the challenges of the new automation era — challenges every domain is only beginning to face.</h2>
        <p class="lead"><strong>GSM</strong> grounds <i>Definitions</i> of the world you interact with — its intents and specifications, its <i>DNA</i> — in systemics; <strong>SIE</strong> manages these Definitions, evaluates the real world against them, and realizes them; <strong>ITIP</strong> applies that to IT, the first domain; <strong>SAF</strong> bridges that to agentic AI and integrates that agentic capability into the organization's operational processes.</p>
        <p class="lead">Each layer feeds the next, closing the Think → Build → Run loop — systematically, autonomously, and always with humans in the loop.</p>
      </div>

      <ArchMap />
    </div>
  </section>

  <section id="services" class="section section--soft">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Services</p>
        <h2>Enter the generative AI era with Poesis experts at your side.</h2>
        <p class="lead">Transformation, managed cloud, sovereign deployment, or certified delivery capability — four ways in, with one constant: an explicit boundary of ownership, risk, and support, agreed before any work begins.</p>
      </div>
      <div class="grid grid-2" style="margin-top:1.5rem">
        {services.map((service) => (
          <article class="card card--feature card--static">
            <span class="tag">{service.category}</span>
            <h3>{service.label}</h3>
            <p>{service.summary}</p>
            <a class="btn btn-ghost btn-sm service-link" href={service.href}><Icon name="arrow-right" /> Explore {service.label}</a>
          </article>
        ))}
      </div>
      <p style="margin-top:2.5rem;text-align:center"><a class="btn btn-primary" href="/contact"><Icon name="message" /> Talk to us</a></p>
    </div>
  </section>

  <section id="partnerships" class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Partnership proposals</p>
        <h2>Build the future of generative AI together.</h2>
        <p class="lead">We partner with model providers, systems integrators, and research groups to ground generative capabilities in systemic governance.</p>
      </div>
      <div class="grid grid-2" style="margin-top:1.5rem">
        <article class="card card--feature card--static">
          <span class="tag">LLM vendors</span>
          <h3>LLM Vendor Partnership</h3>
          <p>What the Poesis stack brings to LLM capabilities — and what LLMs bring to Poesis. Models propose; humans dispose through ITIP; SIE evaluates constraints and executes governed Mechanisms.</p>
          <a class="btn btn-ghost btn-sm service-link" href="/partnerships/llm-vendor-value-proposal"><Icon name="arrow-right" /> Read the value proposal</a>
        </article>
      </div>
    </div>
  </section>

  <section id="insights" class="section section--soft">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Insights</p>
        <h2>How Poesis is applied, argued, and advanced.</h2>
        <p class="lead">Case studies and research notes on governed synthetic autopoiesis, systemic IT governance, and agentic delivery.</p>
      </div>
      <div class="grid grid-2" style="margin-top:1.5rem">
        {insightPosts.map((post) => (
          <article class="card card--feature card--static">
            <span class="tag">{post.data.category}</span>
            <h3>{post.data.title}</h3>
            <p>{post.data.summary}</p>
            <p class="insight-meta">
              <time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
            </p>
            <a class="btn btn-ghost btn-sm service-link" href={`/insights/${post.id.replace(/\.md$/, '')}`}><Icon name="book-open" /> Read {post.data.title.split(':')[0]}</a>
          </article>
        ))}
      </div>
      <p style="margin-top:2.5rem;text-align:center"><a class="btn btn-primary" href="/insights/research"><Icon name="list" /> Browse all insights</a></p>
    </div>
  </section>

  <section id="custody" class="section section--ink">
    <div class="container">
      <p class="eyebrow">Our first custody</p>
      <h2>Poesis runs on Poesis.</h2>
      <p class="lead">We are our own first customer. The Poesis stack that will integrate your systems already define, build, and govern ours — Poesis's development power rests on the very stack it ships.</p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="/solutions/itip"><Icon name="compass" /> Explore ITIP</a>
        <a class="btn btn-ghost" href="/solutions/sie"><Icon name="layers" /> Explore SIE</a>
        <a class="btn btn-ghost" href="/solutions/saf"><Icon name="spark" /> Explore SAF</a>
        <a class="btn btn-ghost" href="https://github.com/poesis-cloud"><Icon name="github" /> See it on GitHub</a>
      </div>
    </div>
  </section>
</BaseLayout>
