---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ArchMap from '../components/ArchMap.astro';
import ThinkBottleneckDiagram from '../components/ThinkBottleneckDiagram.astro';
import { poesisPortfolio, solutionValueAnchor } from '../data/poesis-portfolio.ts';

const valueSet = (solutionSlug: string, primary: string) => {
  const solution = poesisPortfolio.find((candidate) => candidate.slug === solutionSlug);
  if (!solution) throw new Error(`Unknown solution '${solutionSlug}'`);
  return { solution, primary };
};

const defineValues = valueSet('itip', 'A source of truth AI can act on.');
const buildValues = valueSet('saf', 'Definitions that generate systems.');
const runValues = valueSet('sie', 'Harnessed operations.');
---
<BaseLayout title="The Organizational Intelligence Platform" pageType="Home">
  <section class="hero home-hero">
    <div class="container">
      <p class="eyebrow">The foundation of the autonomous enterprise</p>
      <h1>The Organizational Intelligence Platform.</h1>
      <p class="lead">AI is entering organizations it doesn't understand. Humans rarely understand them much better. Poesis grounds both in a coherent system that manages <em>definitions</em> of the organization — its DNA — <strong>to efficiently and continuously generate that organization</strong>.</p>
      <p class="home-hero__promise">The DNA of the organization constitutes a living digital twin — the foundation for <strong>accelerating BUILD and RUN adequately</strong>, and <strong>ultimately for the autonomous enterprise to emerge</strong>.</p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="/contact" data-demo-cta="homepage-hero-pilot"><Icon name="play" /> Run a Pilot</a>
        <a class="btn btn-ghost" href="#autonomous-enterprise"><Icon name="arrow-right" /> See where it leads</a>
      </div>
      <p class="hero-note">Human-governed definitions that people and AI can act on.</p>
    </div>
  </section>

  <section id="bottleneck" class="section section--soft home-inversion">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">The thesis</p>
        <h2>Drift at machine speed, or align at human speed.</h2>
        <p class="lead">This is the central tension of industrial GenAI adoption. GenAI accelerates the production of artifacts, but not the production of definition and governance required to viably deliver these artifacts.</p>
        <p class="lead">The scarce resource is now more than ever the THINK: the AI and human capacity to understand, define, plan, validate, and take responsibility for what has been created.</p>
        <p class="lead"><strong>Poesis resolves the historical THINK pathology &mdash; for GenAI, people, and programmatic tools, to safely accelerate BUILD and RUN at the expected rate.</strong></p>
      </div>
      <ThinkBottleneckDiagram />
    </div>
  </section>

  <section id="effects" class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Immediate therapy values</p>
        <h2>The organization becomes intelligible &mdash; to the people and the machines who think, build, and run it.</h2>
        <p class="lead">Organizational definitions stop being prose. They become a structured causal context that can be reasoned over, taught, governed, simulated, and continuously evaluated.</p>
      </div>
      <ul class="think-consequence-list">
        <li>
          <span class="think-consequence__head"><span class="think-consequence__icon"><Icon name="compass" size={16} /></span><span class="think-consequence__step">Analysis power</span></span>
          <strong>Impact is traced before the decision</strong>
          <p>Changes ripple through typed relations, so blast radius, dependencies, and affected obligations are reasoned from the model instead of guessed in a meeting.</p>
        </li>
        <li>
          <span class="think-consequence__head"><span class="think-consequence__icon"><Icon name="check-badge" size={16} /></span><span class="think-consequence__step">Continuous evaluation</span></span>
          <strong>The conformance state is known continuously</strong>
          <p>Every divergence between the definition and observed reality surfaces the moment it appears &mdash; not at audit time, and not after it has propagated.</p>
        </li>
        <li>
          <span class="think-consequence__head"><span class="think-consequence__icon"><Icon name="list" size={16} /></span><span class="think-consequence__step">Governed authority</span></span>
          <strong>Nothing enters into effect ungoverned</strong>
          <p>Definitions and operations &mdash; proposed by AI or by people &mdash; take effect only through the explicit lifecycle, so authority stays human, attributed, and never implicit.</p>
        </li>
        <li>
          <span class="think-consequence__head"><span class="think-consequence__icon"><Icon name="shield" size={16} /></span><span class="think-consequence__step">Accountable autonomy</span></span>
          <strong>Execution can be delegated without losing control</strong>
          <p>Agentic and automated action stays bounded by Directives and Norms, so autonomy can grow without accountability being traded away for speed.</p>
        </li>
        <li>
          <span class="think-consequence__head"><span class="think-consequence__icon"><Icon name="spark" size={16} /></span><span class="think-consequence__step">Resource economy</span></span>
          <strong>The same resources deliver more</strong>
          <p>Intent stops being rebuilt at every handoff and deliverables derive from the model, releasing the human and compute capacity that drift consumes.</p>
        </li>
        <li>
          <span class="think-consequence__head"><span class="think-consequence__icon"><Icon name="book-open" size={16} /></span><span class="think-consequence__step">Audit readiness</span></span>
          <strong>The history of the model is the audit trail</strong>
          <p>Every governed change is a retained, versioned transition carrying its provenance &mdash; evidence exists by construction, not reconstructed under audit pressure.</p>
        </li>
      </ul>
    </div>
  </section>

  <section id="use-cases" class="section home-usecases">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">The governed loop</p>
        <h2>THINK, BUILD, RUN &mdash; and back to THINK.</h2>
        <p class="lead">Those effects are what the loop produces &mdash; and keeps producing. Three jobs share one set of governed definitions; evaluation is THINK applied continuously to THINK, BUILD, and RUN.</p>
      </div>
      <div class="home-usecase-grid">
        <article id="use-case-think">
          <span class="home-step">01 · THINK</span>
          <h3>Generate a living digital twin of your organization</h3>
          <p>Source definitions from people, code, contracts, infrastructure, and evidence; evaluate their validity, coherence, and fitness; govern them into one traceable organizational digital twin.</p>
          <div class="home-usecase-values">
            <span>The values</span>
            <nav aria-label={`${defineValues.solution.name} values related to Define`}>
              {defineValues.solution.values.map((value) => (
                <a class:list={{ 'is-primary': value.title === defineValues.primary }} href={`${defineValues.solution.href}#${solutionValueAnchor(value.title)}`}>{value.title}</a>
              ))}
            </nav>
          </div>
          <a class="btn btn-ghost btn-sm" href="/solutions/itip"><Icon name="arrow-right" /> Explore ITIP</a>
        </article>
        <article id="use-case-build">
          <span class="home-step">02 · BUILD</span>
          <h3>Build from the organizational digital twin</h3>
          <p>Use its governed definitions as machine-operable context for people and AI; evaluate generated systems against them through deterministic checks and human gates; return evidence to THINK.</p>
          <div class="home-usecase-values">
            <span>The values</span>
            <nav aria-label={`${buildValues.solution.name} values related to Build`}>
              {buildValues.solution.values.map((value) => (
                <a class:list={{ 'is-primary': value.title === buildValues.primary }} href={`${buildValues.solution.href}#${solutionValueAnchor(value.title)}`}>{value.title}</a>
              ))}
            </nav>
          </div>
          <a class="btn btn-ghost btn-sm" href="/solutions/saf"><Icon name="arrow-right" /> Explore SAF</a>
        </article>
        <article id="use-case-run">
          <span class="home-step">03 · RUN</span>
          <h3>Operate from active definitions</h3>
          <p>Put the digital twin into effect through Mechanisms that guide human, software, and agentic action; evaluate runtime subjects through Norms for compliance and drift; return evidence to THINK.</p>
          <div class="home-usecase-values">
            <span>The values</span>
            <nav aria-label={`${runValues.solution.name} values related to Run`}>
              {runValues.solution.values.map((value) => (
                <a class:list={{ 'is-primary': value.title === runValues.primary }} href={`${runValues.solution.href}#${solutionValueAnchor(value.title)}`}>{value.title}</a>
              ))}
            </nav>
          </div>
          <a class="btn btn-ghost btn-sm" href="/solutions/sie"><Icon name="arrow-right" /> Explore SIE</a>
        </article>
      </div>
    </div>
  </section>

  <section id="deployment" class="section section--soft home-deployment">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Deployment posture</p>
        <h2>Your models. Your systems. Your control boundary.</h2>
        <p class="lead">Poesis adds a governed THINK layer without requiring a particular model vendor or replacing existing BUILD and RUN systems.</p>
      </div>
      <div class="home-deployment-grid">
        <article><Icon name="spark" size={22} /><h3>Model-independent</h3><p>Use the models appropriate to each bounded task; governance does not depend on one provider.</p></article>
        <article><Icon name="shield" size={22} /><h3>Local and sovereign</h3><p>Keep sensitive THINK and RUN state inside environments you control.</p></article>
        <article><Icon name="layers" size={22} /><h3>Cloud where appropriate</h3><p>Deploy services through managed infrastructure while retaining explicit control boundaries.</p></article>
        <article><Icon name="grid" size={22} /><h3>Built around your estate</h3><p>Connect governed THINK to existing BUILD and RUN environments.</p></article>
      </div>
    </div>
  </section>

  <section id="autonomous-enterprise" class="section section--ink home-vision">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">The middle- to long-term horizon</p>
        <h2>Toward the human-governed autonomous enterprise.</h2>
        <p class="lead">As the organizational digital twin expands across domains, more of the enterprise can adapt and operate from the same governed definition. Execution stays a choice: agentic today through SAF, increasingly deterministic and economic as the SIE Operator matures toward Organization as a Service. This is the horizon Poesis is building toward, not a claim that the complete autonomous enterprise is available today.</p>
      </div>
      <div class="home-outcome-grid">
        <article><span class="home-step">01</span><h3>Autonomous enterprise</h3><p>An organization that can adapt and act through machine-operable governance while people retain purpose, authority, and final disposition.</p></article>
        <article><span class="home-step">02</span><h3>Organization as a Service</h3><p>A human-facing way to govern and operate organizational capabilities through the shared executable model.</p></article>
        <article><span class="home-step">03</span><h3>Product as a Service</h3><p>A human-facing way to generate, govern, and evolve products from the same organizational definition.</p></article>
        <article><span class="home-step">04</span><h3>Productive capacity in people&rsquo;s hands</h3><p>People direct governed organizational capacity without surrendering control to opaque or unbounded automation.</p></article>
      </div>
    </div>
  </section>

  <section id="portfolio" class="section home-platform">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">The Poesis platform</p>
        <h2>Explore the complete solutions and products map.</h2>
        <p class="lead">Each solution owns a distinct responsibility in the governed THINK → BUILD → RUN loop. Open the product and feature groups to inspect what exists, what is planned, and how the portfolio fits together.</p>
      </div>
      <ArchMap />
    </div>
  </section>

  <section id="pilot" class="section section--soft home-pilot">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Start with one real workflow</p>
        <h2>Prove governed acceleration at a useful scale.</h2>
        <p class="lead">Choose a workflow where limited THINK constrains BUILD or RUN today. Make THINK explicit, then test how people, software, and AI perform across the governed loop.</p>
      </div>
      <ol class="home-pilot-steps">
        <li><span>01</span><strong>Frame THINK</strong><p>Identify purpose, actors, evidence, constraints, and human decisions.</p></li>
        <li><span>02</span><strong>Govern THINK</strong><p>Source intent and RUN reality into a governed, machine-operable definition.</p></li>
        <li><span>03</span><strong>Connect BUILD + RUN</strong><p>Let bounded software, mechanisms, people, and agents use the governed definition.</p></li>
        <li><span>04</span><strong>Evaluate the loop</strong><p>Measure BUILD and RUN speed, rework, control, and traceability against the starting point.</p></li>
      </ol>
      <div class="hero-cta">
        <a class="btn btn-primary" href="/contact" data-demo-cta="homepage-pilot"><Icon name="play" /> Run a Pilot</a>
        <a class="btn btn-ghost" href="/services/consulting"><Icon name="briefcase" /> Explore transformation services</a>
      </div>
    </div>
  </section>
</BaseLayout>
