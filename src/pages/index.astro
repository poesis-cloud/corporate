---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ArchMap from '../components/ArchMap.astro';
import ThinkBottleneckDiagram from '../components/ThinkBottleneckDiagram.astro';
import OrganizationTwinDiagram from '../components/OrganizationTwinDiagram.astro';
import { poesisPortfolio } from '../data/poesis-portfolio.ts';

const shippedProductSlugs = new Set([
  'agentic-harness',
  'definition-manager',
  'definition-blackboard-manager',
]);

const shippedProducts = poesisPortfolio.flatMap((solution) =>
  solution.products
    .filter((product) => shippedProductSlugs.has(product.slug))
    .map((product) => ({ ...product, solutionHref: solution.href })),
);
---
<BaseLayout title="The Organizational Intelligence Platform" pageType="Home">
  <section class="hero home-hero">
    <div class="container">
      <p class="eyebrow">Shared understanding. Human authority.</p>
      <h1>The Organizational Intelligence Platform.</h1>
      <p class="lead">AI is entering organizations it doesn't understand. Poesis gives people and AI one governed understanding of how your organization actually works.</p>
      <p class="home-hero__promise">Human-governed, traceable definitions form a living digital twin of your organization — the foundation for accelerating BUILD and RUN safely.</p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="/contact" data-demo-cta="homepage-hero-pilot"><Icon name="play" /> Run a Pilot</a>
        <a class="btn btn-ghost" href="#digital-twin"><Icon name="arrow-right" /> See how it works</a>
      </div>
      <p class="hero-note">Available now · AI-assisted · Human-governed · Traceable by construction</p>
    </div>
  </section>

  <section id="bottleneck" class="section section--soft home-inversion">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">The thesis</p>
        <h2>Resolve THINK before AI accelerates BUILD and RUN.</h2>
        <p class="lead">AI multiplies output, but shared understanding doesn't scale with it. Work drifts from intent — and people spend the gain pulling it back.</p>
        <p>Poesis inverts the sequence: human and AI capacity goes to THINK first. BUILD and RUN then execute against governed definitions — without drift, and as deterministically as you choose, with little or no AI. This bottleneck predates AI. AI made resolving it possible, and not resolving it untenable.</p>
      </div>
      <ThinkBottleneckDiagram />
    </div>
  </section>

  <section id="mechanism" class="section home-mechanism">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">The operating model</p>
        <h2>Human and AI governance makes shared definitions authoritative.</h2>
        <p class="lead">Poesis brings human intent, AI-assisted reasoning, and evidence from RUN into one governed definition process. THINK establishes what should guide work; governance determines which definitions are trusted, in effect, and available to humans and machines.</p>
      </div>
      <div class="home-definition-flow">
        <div class="home-definition-inputs">
          <article>
            <span class="tag">Human THINK</span>
            <h3>Purpose and disposition</h3>
            <p>People set direction, obligations, acceptable boundaries, and the decisions that remain human.</p>
          </article>
          <article>
            <span class="tag">Observed RUN</span>
            <h3>Evidence from RUN</h3>
            <p>Code, infrastructure, tools, and RUN signals contribute what exists and how it behaves.</p>
          </article>
        </div>
        <div class="home-definition-core">
          <span class="tag tag--value">Governed definitions</span>
          <h3>The authoritative output of THINK</h3>
          <p>AI helps source and structure candidate definitions. Provenance, lifecycle, validation, and human disposition determine what becomes authoritative.</p>
        </div>
        <div class="home-definition-actors" aria-label="Actors enabled by governed definitions">
          <span>Humans</span><span>Software</span><span>Mechanisms</span><span>Bounded agents</span>
        </div>
      </div>
    </div>
  </section>

  <section id="digital-twin" class="section section--ink home-vision">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">How the platform works</p>
        <h2>The organizational digital twin makes governed definitions operational.</h2>
        <p class="lead">Poesis composes authoritative definitions sourced from THINK, BUILD, and RUN into a living, executable model. People govern the model; every authorized human or machine actor can use it.</p>
      </div>
      <OrganizationTwinDiagram />
      <p class="home-vision__line">The organizational digital twin is not a static representation. It is the coherent system of governed definitions through which purpose, structures, rules, constraints, decisions, and evidence remain connected as the organization changes.</p>
    </div>
  </section>

  <section id="outcomes" class="section section--ink home-outcomes">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">One governed definition system</p>
        <h2>Accelerate BUILD and RUN without losing control.</h2>
        <p class="lead">Humans, software, and AI work from the same authoritative definitions established through THINK.</p>
      </div>
      <div class="home-outcome-grid">
        <article><span class="home-step">01</span><h3>Scale BUILD</h3><p>BUILD works from explicit architecture, constraints, and acceptance conditions instead of reconstructing THINK in every prompt.</p></article>
        <article><span class="home-step">02</span><h3>Scale RUN</h3><p>RUN evaluates state and operates within authority declared by governed THINK.</p></article>
        <article><span class="home-step">03</span><h3>Govern THINK</h3><p>Lifecycle, provenance, authorization, validation, and human disposition remain attached to the definition.</p></article>
        <article><span class="home-step">04</span><h3>Close the loop</h3><p>Evidence from BUILD and RUN returns to THINK without reconstructing the chain after the fact.</p></article>
      </div>
    </div>
  </section>

  <section id="portfolio" class="section home-platform">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">The Poesis platform</p>
        <h2>Explore the complete solutions and products map.</h2>
        <p class="lead">Each solution owns a distinct responsibility in the governed THINK → BUILD → RUN loop. Open the product and feature groups to inspect what exists, what is planned, and how the portfolio fits together.</p>
      </div>
      <ArchMap />
    </div>
  </section>

  <section id="deployment" class="section section--soft home-deployment">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Deployment posture</p>
        <h2>Your models. Your systems. Your control boundary.</h2>
        <p class="lead">Poesis adds a governed THINK layer without requiring a particular model vendor or replacing existing BUILD and RUN systems.</p>
      </div>
      <div class="home-deployment-grid">
        <article><Icon name="spark" size={22} /><h3>Model-independent</h3><p>Use the models appropriate to each bounded task; governance does not depend on one provider.</p></article>
        <article><Icon name="shield" size={22} /><h3>Local and sovereign</h3><p>Keep sensitive THINK and RUN state inside environments you control.</p></article>
        <article><Icon name="layers" size={22} /><h3>Cloud where appropriate</h3><p>Deploy services through managed infrastructure while retaining explicit control boundaries.</p></article>
        <article><Icon name="grid" size={22} /><h3>Built around your estate</h3><p>Connect governed THINK to existing BUILD and RUN environments.</p></article>
      </div>
    </div>
  </section>

  <section id="proof" class="section home-proof">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Shipped proof</p>
        <h2>Three Poesis foundations have reached 1.0.</h2>
        <p class="lead">No future platform capability is presented as shipped. These are the released foundations available now.</p>
      </div>
      <div class="home-proof-grid">
        {shippedProducts.map((product) => (
          <article>
            <span class="tag tag--value">Shipped · v{product.currentVersion}</span>
            <h3>{product.name}</h3>
            <p>{product.description}</p>
            <a class="btn btn-ghost btn-sm" href={`${product.solutionHref}/products/${product.slug}`}><Icon name="arrow-right" /> Product details</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="pilot" class="section section--soft home-pilot">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Start with one real workflow</p>
        <h2>Prove governed acceleration at a useful scale.</h2>
        <p class="lead">Choose a workflow where limited THINK constrains BUILD or RUN today. Make THINK explicit, then test how people, software, and AI perform across the governed loop.</p>
      </div>
      <ol class="home-pilot-steps">
        <li><span>01</span><strong>Frame THINK</strong><p>Identify purpose, actors, evidence, constraints, and human decisions.</p></li>
        <li><span>02</span><strong>Govern THINK</strong><p>Source intent and RUN reality into a governed, machine-operable definition.</p></li>
        <li><span>03</span><strong>Connect BUILD + RUN</strong><p>Let bounded software, mechanisms, people, and agents use the governed definition.</p></li>
        <li><span>04</span><strong>Evaluate the loop</strong><p>Measure BUILD and RUN speed, rework, control, and traceability against the starting point.</p></li>
      </ol>
      <div class="hero-cta">
        <a class="btn btn-primary" href="/contact" data-demo-cta="homepage-pilot"><Icon name="play" /> Run a Pilot</a>
        <a class="btn btn-ghost" href="/services/consulting"><Icon name="briefcase" /> Explore transformation services</a>
      </div>
    </div>
  </section>

  <section id="autonomous-enterprise" class="section section--ink home-outcomes">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">The middle- to long-term horizon</p>
        <h2>Toward the human-governed autonomous enterprise.</h2>
        <p class="lead">As the organizational digital twin expands across domains, more of the enterprise can adapt and operate from the same governed definition. This is the horizon Poesis is building toward, not a claim that the complete autonomous enterprise is available today.</p>
      </div>
      <div class="home-outcome-grid">
        <article><span class="home-step">01</span><h3>Autonomous enterprise</h3><p>An organization that can adapt and act through machine-operable governance while people retain purpose, authority, and final disposition.</p></article>
        <article><span class="home-step">02</span><h3>Organization as a Service</h3><p>A human-facing way to govern and operate organizational capabilities through the shared executable model.</p></article>
        <article><span class="home-step">03</span><h3>Product as a Service</h3><p>A human-facing way to generate, govern, and evolve products from the same organizational definition.</p></article>
        <article><span class="home-step">04</span><h3>Productive capacity in people&rsquo;s hands</h3><p>People direct governed organizational capacity without surrendering control to opaque or unbounded automation.</p></article>
      </div>
    </div>
  </section>
</BaseLayout>
