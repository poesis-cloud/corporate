---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchMap from '../../components/ArchMap.astro';
import { solutions } from '../../data/solutions.ts';
---
<BaseLayout
  title="Solutions"
  description="The Poesis portfolio as an architecture map: the GSM standard, the SIE engine, the ITIP application, and the SAFe Agentic Framework — each solution, its products, and their features."
>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Solutions</p>
      <h1>One standard, one engine, one application — and the agents that build from them.</h1>
      <p class="lead">The portfolio composes top to bottom: GSM defines the meaning, SIE runs it, ITIP applies it to IT, and the SAFe Agentic Framework generates from it. Every box below is clickable — solutions open their page, products open their sub-page, features jump to their section.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <ArchMap />
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <p class="eyebrow">The solutions</p>
      <h2>Four solutions, one governed loop.</h2>
      <div class="grid grid-2" style="margin-top:1.5rem">
        {solutions.map((s) => (
          <div class="card">
            <span class={`tag${s.slug === 'gsm' ? '' : ' tag--muted'}`}>{s.tag}</span>
            <h3>{s.fullName}</h3>
            <p>{s.description}</p>
            <p style="margin-top:.6rem">
              <a href={s.href}>About {s.name} →</a>
              {s.products.map((p) => (
                <> &middot; <a href={`${s.href}/products/${p.slug}`}>{p.name}</a></>
              ))}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container center">
      <h2>Bring it to your organization.</h2>
      <p class="lead" style="margin-inline:auto">The transformation services deploy the whole stack as the governed substrate of your change.</p>
      <p><a class="btn btn-primary" href="/services">See the services →</a></p>
    </div>
  </section>
</BaseLayout>

