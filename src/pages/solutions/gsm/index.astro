---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import ProductCards from '../../../components/ProductCards.astro';
import SolutionValueCards from '../../../components/SolutionValueCards.astro';
import GsmModelDiagram from '../../../components/GsmModelDiagram.astro';
import { solutions } from '../../../data/solutions.ts';

const gsm = solutions.find((s) => s.slug === 'gsm')!;
const [h1] = gsm.tagline.split(' — ');
---
<BaseLayout
  title="GSM — Generative System Model: the governed world model"
  description="The Generative System Model (GSM) — the vendor-neutral standard for defining and governing systems: governance as code, an explicit and governed world model of your organization, grounded in systemics, developed as a candidate open standard."
  pageType="Solution"
>
  <section class="hero">
    <div class="container">
      <p class="eyebrow"><a href="/#portfolio">{gsm.tag} · Solution</a></p>
      <h1>{h1}.</h1>
      <p class="lead">The vendor-neutral standard for defining systems — governance as code, not governance as prose. GSM is to the world's THINK–BUILD–RUN what OpenTelemetry's semantic conventions are to observability: one shared model every tool can use.</p>
      <p class="lead">It is grounded in systemics — synthesizing Beer's Viable System Model, von Bertalanffy's General System Theory, Wiener and Ashby's cybernetics, and Maturana and Varela's autopoiesis into a single generative definition of systems.</p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="https://docs.poesis.cloud/gsm/"><Icon name="docs" /> Read the docs</a>
        <a class="btn btn-ghost" href="https://github.com/poesis-cloud"><Icon name="github" /> Browse the repos</a>
        <a class="btn btn-ghost" href="/contact"><Icon name="message" /> Talk to us</a>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <p class="eyebrow">Why it matters</p>
      <h2>The definition layer beneath the projects you already run.</h2>
      <SolutionValueCards solution={gsm} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">The mental model</p>
      <h2>The governed world model, simplified.</h2>
      <p class="lead">Two anchors you already know: GSM is to THINK what OpenTelemetry’s semantic conventions are to RUN — one shared, vendor-neutral model every tool can speak — and an Archetype is to the model what a CRD is to Kubernetes: a typed schema that makes new kinds of subjects definable and governable. Together they make GSM what learned world models cannot be: an <strong>explicit, causal, governed world model</strong> of your organization.</p>
      <p class="lead">Everything is a governed Definition. Ascriptions version it as governed snapshots; Archetypes — themselves definitions — type it; and the DNA grammar, Directives operationalized by Norms, governs it all under one lifecycle.</p>
      <GsmModelDiagram />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Products</p>
      <h2>The specification — and the frameworks sourced into it.</h2>
      <ProductCards solution={gsm} />
    </div>
  </section>

</BaseLayout>
