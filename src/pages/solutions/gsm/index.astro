---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import UsageCases from '../../../components/UsageCases.astro';
import { useCasesForSolution } from '../../../data/usage.ts';
import Icon from '../../../components/Icon.astro';
import ProductCards from '../../../components/ProductCards.astro';
import SolutionValueCards from '../../../components/SolutionValueCards.astro';
import SolutionCapabilityCards from '../../../components/SolutionCapabilityCards.astro';
import { platformSolutions } from '../../../data/poesis-platform.ts';

const gsm = platformSolutions.find((s) => s.slug === 'gsm')!;
---
<BaseLayout
  title="The Generative System Model — the governed world model"
  description={gsm.description}
  pageType="Solution"
>
  <section class="hero hero--split">
    <div class="container">
      <p class="eyebrow"><a href="/#portfolio">{gsm.tags.join(' · ')} · Solution</a></p>
      <h1>The Generative System Model — the governed world model.</h1>
      <p class="lead">{gsm.tagline}</p>
      <div class="hero-promise">
        <p>{gsm.description}</p>
        <p>OpenTelemetry conventions and Kubernetes CRDs are useful analogies for shared semantics and typing, not interoperability proof or identity with Archetypes.</p>
      </div>
      <div class="hero-cta">
        <a class="btn btn-primary" href="https://docs.poesis.cloud/gsm/"><Icon name="docs" /> Read the docs</a>
      </div>
      <p class="hero-note"><a href="/insights/the-governed-world-model/">Insights · why learned world models cannot give you this →</a></p>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Values</p>
        <h2>Shared definition semantics, inspectable sources and interoperability.</h2>
      </div>
      <SolutionValueCards solution={gsm} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Capabilities</p>
        <h2>Specification content, selected vocabularies and research with distinct scopes.</h2>
      </div>
      <SolutionCapabilityCards solution={gsm} />
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Products</p>
        <h2>Specifications, Ontology and Research Lab.</h2>
      </div>
      <ProductCards solution={gsm} />
    </div>
  </section>

  <UsageCases cases={useCasesForSolution('gsm')} title="Modeling, evidence and integration use cases" />
</BaseLayout>
