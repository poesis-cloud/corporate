---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import UsageCases from '../../../components/UsageCases.astro';
import { useCasesForSolution } from '../../../data/usage.ts';
import Icon from '../../../components/Icon.astro';
import ProductCards from '../../../components/ProductCards.astro';
import SolutionValueCards from '../../../components/SolutionValueCards.astro';
import SolutionCapabilityCards from '../../../components/SolutionCapabilityCards.astro';
import QualityList from '../../../components/QualityList.astro';
import { solutionQualities } from '../../../data/qualities.ts';
import { platformSolutions } from '../../../data/poesis-platform.ts';

const sie = platformSolutions.find((s) => s.slug === 'sie')!;
---
<BaseLayout
  title="The Systemic Intelligence Engine — the governed AI context"
  description={sie.description}
  pageType="Solution"
>
  <section class="hero hero--split">
    <div class="container">
      <p class="eyebrow"><a href="/#portfolio">{sie.tags.join(' · ')} · Solution</a></p>
      <h1>The Systemic Intelligence Engine — the governed AI context.</h1>
      <p class="lead">{sie.tagline}</p>
      <div class="hero-promise">
        <p>{sie.description}</p>
        <p>Declarative infrastructure is an analogy, not evidence of universal reconciliation. Local API use does not require hosting.</p>
      </div>
      <div class="hero-cta">
        <span class="btn btn-primary" aria-disabled="true"><Icon name="azure" /> PaaS Demo Instance <span class="tag tag--muted">coming soon</span></span>
        <span class="btn btn-ghost" aria-disabled="true"><Icon name="store" /> PaaS on Azure Marketplace <span class="tag tag--muted">coming soon</span></span>
        <a class="btn btn-ghost" href="https://docs.poesis.cloud/sie/"><Icon name="docs" /> Read the docs</a>
      </div>
      <p class="hero-note"><a href="/insights/governed-context-versus-retrieval/">Insights · context engineering’s missing layer — governed context, not retrieval →</a></p>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Values</p>
        <h2>Attributable context, bounded operations and feedback loops.</h2>
      </div>
      <SolutionValueCards solution={sie} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Capabilities</p>
        <h2>Definition and execution foundations alongside planned evaluation and access routes.</h2>
      </div>
      <SolutionCapabilityCards solution={sie} />
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Products</p>
        <h2>Three products, one engine.</h2>
      </div>
      <ProductCards solution={sie} />
    </div>
  </section>

  <section id="qualities" class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Qualities</p>
        <h2>What the engine decides, and what it refuses to guess.</h2>
      </div>
      <QualityList qualities={solutionQualities('sie')} />
    </div>
  </section>

  <UsageCases cases={useCasesForSolution('sie')} title="Definition, appraisal and execution use cases" />
</BaseLayout>
