---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import ProductCards from '../../../components/ProductCards.astro';
import SolutionValueCards from '../../../components/SolutionValueCards.astro';
import SieLoopDiagram from '../../../components/SieLoopDiagram.astro';
import { solutions } from '../../../data/solutions.ts';

const sie = solutions.find((s) => s.slug === 'sie')!;
const [h1, ...rest] = sie.tagline.split(' — ');
const lead = rest.join(' — ');
const leadText = lead.charAt(0).toUpperCase() + lead.slice(1);
---
<BaseLayout
  title="SIE — Systemic Intelligence Engine: the governed AI context"
  description="SIE — the Systemic Intelligence Engine: the reference implementation of GSM. A governed AI context — the layer context engineering is missing — with definitions management APIs, lifecycle enforcement, the Operator runtime, and the Definition Blackboard Manager."
  pageType="Solution"
>
  <section class="hero">
    <div class="container">
      <p class="eyebrow"><a href="/#portfolio">{sie.tag} · Solution</a></p>
      <h1>{h1}.</h1>
      <p class="lead">{leadText}</p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="https://docs.poesis.cloud/sie/"><Icon name="docs" /> Read the docs</a>
        <a class="btn btn-ghost" href="https://github.com/poesis-cloud"><Icon name="github" /> Browse the repos</a>
        <span class="btn btn-ghost" aria-disabled="true"><Icon name="azure" /> SaaS demo instance on Azure <span class="tag tag--muted">coming soon</span></span>
        <span class="btn btn-ghost" aria-disabled="true"><Icon name="store" /> SaaS product on Azure Marketplace <span class="tag tag--muted">coming soon</span></span>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <p class="eyebrow">Why it matters</p>
      <h2>The governed AI context — the layer context engineering is missing.</h2>
      <SolutionValueCards solution={sie} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">The mental model</p>
      <h2>One loop, from definition to reality — and back.</h2>
      <p class="lead">Think Kubernetes, generalized: you declare desired state as typed, versioned, API-managed definitions, and the engine continuously evaluates reality against them and acts to close the gap. Kubernetes runs that loop on infrastructure; SIE can run it on anything you can define.</p>
      <SieLoopDiagram />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Products</p>
      <h2>Three products, one engine.</h2>
      <ProductCards solution={sie} />
    </div>
  </section>

</BaseLayout>
