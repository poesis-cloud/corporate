---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import ProductCards from '../../../components/ProductCards.astro';
import SolutionValueCards from '../../../components/SolutionValueCards.astro';
import SolutionCapabilityCards from '../../../components/SolutionCapabilityCards.astro';
import { poesisPortfolio } from '../../../data/poesis-portfolio.ts';

const sie = poesisPortfolio.find((s) => s.slug === 'sie')!;
---
<BaseLayout
  title="The Systemic Intelligence Engine — the governed AI context"
  description="SIE — the Systemic Intelligence Engine: the reference implementation of GSM. A governed AI context — the layer context engineering is missing — with definitions management APIs, lifecycle enforcement, the Operator runtime, and the Definition Blackboard Manager."
  pageType="Solution"
>
  <section class="hero hero--split">
    <div class="container">
      <p class="eyebrow"><a href="/#portfolio">{sie.tag} · Solution</a></p>
      <h1>The Systemic Intelligence Engine — the governed AI context.</h1>
      <p class="lead">The reference implementation of GSM — typed, versioned, API-managed definitions that applications, humans, and agents can reason and act on.</p>
      <div class="hero-promise">
        <p>Think <strong>Kubernetes, generalized</strong>: you declare desired state as typed definitions, and the engine continuously evaluates reality against them and acts to close the gap.</p>
        <p>Kubernetes runs that loop on infrastructure. SIE runs it on anything you can define.</p>
      </div>
      <div class="hero-cta">
        <span class="btn btn-primary" aria-disabled="true"><Icon name="azure" /> PaaS Demo Instance <span class="tag tag--muted">coming soon</span></span>
        <span class="btn btn-ghost" aria-disabled="true"><Icon name="store" /> PaaS on Azure Marketplace <span class="tag tag--muted">coming soon</span></span>
        <a class="btn btn-ghost" href="https://docs.poesis.cloud/sie/"><Icon name="docs" /> Read the docs</a>
      </div>
      <p class="hero-note"><a href="https://docs.poesis.cloud/sie/mental-model/">The mental model — one loop, from definition to reality →</a></p>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Values</p>
        <h2>A governed context AI can act on, operations harnessed by it, and one closed loop that keeps it true to reality.</h2>
      </div>
      <SolutionValueCards solution={sie} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Capabilities</p>
        <h2>Store and lifecycle-enforce every definition, source it collaboratively, evaluate Norms and execute Mechanisms from it — and serve it to AI.</h2>
      </div>
      <SolutionCapabilityCards solution={sie} />
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Products</p>
        <h2>Three products, one engine.</h2>
      </div>
      <ProductCards solution={sie} />
    </div>
  </section>

</BaseLayout>
