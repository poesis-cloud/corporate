---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProductCards from '../../../components/ProductCards.astro';
import { solutions } from '../../../data/solutions.ts';

const sie = solutions.find((s) => s.slug === 'sie')!;
const [h1, ...rest] = sie.tagline.split(' — ');
const lead = rest.join(' — ');
const leadText = lead.charAt(0).toUpperCase() + lead.slice(1);
const demoUrl = 'https://demo.poesis.cloud';
const azureUrl = 'https://azuremarketplace.microsoft.com';
---
<BaseLayout
  title="SIE"
  description="SIE — the Systemic Intelligence Engine: the reference implementation of GSM — definitions management APIs, retention, the Operator, and the Definition Blackboard Manager."
>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">{sie.tag} · Solution</p>
      <h1>{h1}.</h1>
      <p class="lead">{leadText}</p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="https://docs.poesis.cloud/sie-definition/">Read the docs</a>
        <a class="btn btn-ghost" href="https://docs.poesis.cloud/sie-blackboard/">Blackboard docs</a>
        <a class="btn btn-ghost" href="https://github.com/poesis-cloud">Browse the repos</a>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <p class="eyebrow">Why it matters</p>
      <h2>Not just where definitions live — the context AI operates on.</h2>
      <div class="grid grid-2" style="margin-top:1.5rem">
        <div class="card card--feature card--static">
          <h3>A governed AI context.</h3>
          <p>SIE leverages the definitions as a typed, machine-readable context — each one carrying its Archetype's meaning — that applications, humans, and agents can reason and generate from directly. It is the governed account generative models rarely have: what a system <em>is</em>, what it <em>must</em> do, and <em>why</em>.</p>
        </div>
        <div class="card card--feature card--static">
          <h3>Harnessed operations.</h3>
          <p>Operations on that context are harnessed by the definitions themselves: Directives and Norms bound what AI and agentic actions may do, so every operation stays governed, checked, and trustworthy — intuition proposes, the model disposes.</p>
        </div>
        <div class="card card--feature card--static">
          <h3>One closed governance loop.</h3>
          <p>Define → realize → evaluate → refine: definitions are stored and lifecycle-enforced, executed against observed state, and refreshed from collaborative sourcing — every divergence surfaces immediately, not at audit time.</p>
        </div>
        <div class="card card--feature card--static">
          <h3>Reality feeds governance.</h3>
          <p>The Definition Blackboard Manager lets code sourcers, manual authors, and external frameworks contribute evidence-backed identifications — sealed, audited, and promoted into governed definitions, so the model tracks the real system.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Products</p>
      <h2>Three products, one engine.</h2>
      <ProductCards solution={sie} />
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <p class="eyebrow">SaaS</p>
      <h2>Run SIE as a managed cloud.</h2>
      <p class="lead">The engine, operated by the team that builds it — experience it through the ITIP demo instance, or deploy from the Azure Marketplace.</p>
      <div class="hero-cta">
        <a class="btn btn-primary" href={demoUrl}>ITIP demo instance <span class="tag tag--muted">incoming</span></a>
        <a class="btn btn-ghost" href={azureUrl}>Azure Marketplace <span class="tag tag--muted">coming soon</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
