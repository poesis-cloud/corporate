---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import ProductCards from '../../../components/ProductCards.astro';
import SolutionValueCards from '../../../components/SolutionValueCards.astro';
import SolutionCapabilityCards from '../../../components/SolutionCapabilityCards.astro';
import { poesisPortfolio } from '../../../data/poesis-portfolio.ts';

const itip = poesisPortfolio.find((s) => s.slug === 'itip')!;
const [, ...rest] = itip.tagline.split(' — ');
const lead = rest.join(' — ');
const leadText = lead.charAt(0).toUpperCase() + lead.slice(1);
---
<BaseLayout
  title="The IT Intelligence Platform — the autonomous enterprise and AI governance platform for IT"
  description="ITIP — the autonomous enterprise and AI governance platform for IT: the digital twin of your IT landscape. Define, govern, regulate, and supervise IT as a single source of truth, generate IT artifacts, simulate impacts, and evaluate compliance."
  pageType="Solution"
>
  <section class="hero hero--split">
    <div class="container">
      <p class="eyebrow"><a href="/#portfolio">{itip.tag} · Solution</a></p>
      <h1>The IT Intelligence Platform — the autonomous enterprise and AI governance platform for IT.</h1>
      <p class="lead">{leadText}</p>
      <div class="hero-promise">
        <p>ITIP is the <strong>digital twin of your IT landscape</strong> — the landscape itself, systematically digitalized into a live, typed model, continuously fed by truth sourcers reading the real system, so it cannot drift.</p>
        <p>And what is digitalized becomes <strong>operable</strong>: simulate a change on the twin before committing it, evaluate compliance against it continuously, generate deliverables from it — every IT profile working the same twin.</p>
      </div>
      <div class="hero-cta">
        <a class="btn btn-primary" href="https://docs.poesis.cloud/itip/"><Icon name="docs" /> Read the docs</a>
        <a class="btn btn-ghost" href="https://github.com/poesis-cloud"><Icon name="github" /> Browse the repos</a>
        <span class="btn btn-ghost" aria-disabled="true"><Icon name="azure" /> SaaS demo instance on Azure <span class="tag tag--muted">coming soon</span></span>
        <span class="btn btn-ghost" aria-disabled="true"><Icon name="store" /> SaaS product on Azure Marketplace <span class="tag tag--muted">coming soon</span></span>
      </div>
      <p class="hero-note"><a href="/insights/digital-twin-of-an-organization/">Why the twin pattern works here →</a></p>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Values</p>
        <h2>One governed model that stops drifting, that AI can act on, that every IT profile shares — composed from the frameworks you already answer to.</h2>
      </div>
      <SolutionValueCards solution={itip} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Capabilities</p>
        <h2>Hold the IT landscape as one governed inventory, compose the frameworks over it, source it from the real system — then evaluate, reason, and generate from it.</h2>
      </div>
      <SolutionCapabilityCards solution={itip} />
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Products</p>
        <h2>Two products closing the AI governance loop for IT.</h2>
      </div>
      <ProductCards solution={itip} />
    </div>
  </section>

</BaseLayout>
