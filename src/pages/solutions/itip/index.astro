---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import ProductCards from '../../../components/ProductCards.astro';
import { solutions } from '../../../data/solutions.ts';

const itip = solutions.find((s) => s.slug === 'itip')!;
const [h1, ...rest] = itip.tagline.split(' — ');
const lead = rest.join(' — ');
const leadText = lead.charAt(0).toUpperCase() + lead.slice(1);
---
<BaseLayout
  title="ITIP — IT Intelligence Platform"
  description="ITIP — the IT Intelligence Platform: define, govern, regulate, and supervise the IT landscape as a single source of truth, generate IT artifacts, simulate impacts, and evaluate compliance."
  pageType="Solution"
>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">{itip.tag} · Solution</p>
      <h1>{h1}.</h1>
      <p class="lead">{leadText}</p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="https://docs.poesis.cloud/itip/"><Icon name="docs" /> Read the docs</a>
        <a class="btn btn-ghost" href="https://github.com/poesis-cloud"><Icon name="github" /> Browse the repos</a>
        <span class="btn btn-ghost" aria-disabled="true"><Icon name="azure" /> Azure demo <span class="tag tag--muted">coming soon</span></span>
        <span class="btn btn-ghost" aria-disabled="true"><Icon name="store" /> Azure Marketplace <span class="tag tag--muted">coming soon</span></span>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <p class="eyebrow">Why it matters</p>
      <h2>From governance that drifts to a model that maintains itself.</h2>
      <div class="grid grid-2" style="margin-top:1.5rem">
        <div class="card card--feature card--static">
          <span class="tag tag--value">Value</span>
          <h3>Governance that stops drifting.</h3>
          <p>Architecture wikis, compliance spreadsheets, and review boards drift from reality the moment they are written. ITIP makes the <em>definition</em> the living source of truth — sourced from the real system, governed continuously, and never reconstructed under audit pressure.</p>
        </div>
        <div class="card card--feature card--static">
          <span class="tag tag--value">Value</span>
          <h3>A source of truth AI can act on.</h3>
          <p>Every definition is typed by a GSM Archetype, so its meaning is explicit and machine-readable. Humans and AI agents reason and generate from the same governed account of what your systems <em>are</em>, what they <em>must</em> do, and <em>why</em>.</p>
        </div>
        <div class="card card--feature card--static">
          <span class="tag tag--value">Value</span>
          <h3>Every IT profile converges.</h3>
          <p>Architects define, developers consult, ops watch drift, project managers track state, security audits coverage — one platform, one governed inventory, no translation silos between the people who run your IT.</p>
        </div>
        <div class="card card--feature card--static">
          <span class="tag tag--value">Value</span>
          <h3>Frameworks stacked, not siloed.</h3>
          <p>TOGAF, ISO 25000-series, GDPR, NIS2, DORA — attached from the catalogue and composed into one enforceable governance fabric, so regulations and quality models inform every decision instead of living in separate lists.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Product preview</p>
      <h2>What working in ITIP looks like.</h2>
      <p class="lead">Design previews from the ITIP Web Application — the screens the product is being built against.</p>
      <div class="preview-grid">
        <figure class="preview-item">
          <img src="/previews/itip-definition-inventory.png" alt="ITIP definition inventory dashboard showing Directives, Norms, Definitions counts, chain completion, lifecycle distribution, and framework contribution" width="1440" height="900" loading="lazy" />
          <figcaption>Definition inventory — the governed single source of truth, with D→N→A chain completion and lifecycle distribution.</figcaption>
        </figure>
        <figure class="preview-item">
          <img src="/previews/itip-stack-composer.png" alt="ITIP Stack Composer showing TOGAF, ISO 25000, NIS2, GDPR and enterprise frameworks composed into one stack with overlaps, conflicts, and coverage map" width="1440" height="900" loading="lazy" />
          <figcaption>Stack Composer — TOGAF, ISO 25000, NIS2, GDPR composed into one governance fabric, overlaps and conflicts detected.</figcaption>
        </figure>
        <figure class="preview-item">
          <img src="/previews/itip-directive-impact.png" alt="ITIP impact analysis for a Data Encryption Standard directive showing affected structures, impacted ascriptions, and cascading directives with severity" width="1440" height="900" loading="lazy" />
          <figcaption>Impact analysis — the blast radius of a Directive traced through typed relations before you commit.</figcaption>
        </figure>
        <figure class="preview-item">
          <img src="/previews/itip-truth-sourcing.png" alt="ITIP truth sources screen listing connected git repositories, artifact stores and schema registries with sync status and definition counts" width="1440" height="900" loading="lazy" />
          <figcaption>Truth sourcing — repositories, registries, and artifact stores continuously sourced into governed definitions.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Products</p>
      <h2>Two products, one governed loop.</h2>
      <ProductCards solution={itip} />
    </div>
  </section>

</BaseLayout>
