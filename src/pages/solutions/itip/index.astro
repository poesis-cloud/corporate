---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import ProductCards from '../../../components/ProductCards.astro';
import SolutionValueCards from '../../../components/SolutionValueCards.astro';
import SolutionCapabilityCards from '../../../components/SolutionCapabilityCards.astro';
import { poesisPortfolio } from '../../../data/poesis-portfolio.ts';

const itip = poesisPortfolio.find((s) => s.slug === 'itip')!;
---
<BaseLayout
  title="The IT Intelligence Platform — the autonomous enterprise and AI governance platform for IT"
  description="ITIP — the autonomous enterprise and AI governance platform for IT: the digital twin of your IT landscape. Define, govern, regulate, and supervise IT as a single source of truth, generate IT artifacts, simulate impacts, and evaluate compliance."
  pageType="Solution"
>
  <section class="hero hero--split">
    <div class="container">
      <p class="eyebrow"><a href="/#portfolio">{itip.tag} · Solution</a></p>
      <h1>The IT Intelligence Platform — AI governance for the autonomous enterprise.</h1>
      <p class="lead">The <strong>digital twin of your IT landscape</strong> — one live, typed model every IT profile and every AI agent can act on.</p>
      <div class="hero-promise">
        <p><strong>It cannot drift.</strong> Truth sourcers read the real system and keep the twin fed, instead of humans transcribing it into wikis and spreadsheets.</p>
        <p><strong>It is operable.</strong> Simulate a change before committing it, evaluate compliance continuously, generate deliverables from it.</p>
      </div>
      <div class="hero-cta">
        <span class="btn btn-primary" aria-disabled="true"><Icon name="azure" /> SaaS Demo Instance <span class="tag tag--muted">coming soon</span></span>
        <span class="btn btn-ghost" aria-disabled="true"><Icon name="store" /> SaaS on Azure Marketplace <span class="tag tag--muted">coming soon</span></span>
        <a class="btn btn-ghost" href="https://docs.poesis.cloud/itip/"><Icon name="docs" /> Read the docs</a>
      </div>
      <p class="hero-note"><a href="/insights/digital-twin-of-an-organization/">Insights · why the twin pattern works here →</a></p>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Values</p>
        <h2>One governed model that stops drifting, that AI can act on, that every IT profile shares — composed from the frameworks you already answer to.</h2>
      </div>
      <SolutionValueCards solution={itip} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Capabilities</p>
        <h2>Hold the IT landscape as one governed inventory, compose the frameworks over it, source it from the real system — then evaluate, reason, and generate from it.</h2>
      </div>
      <SolutionCapabilityCards solution={itip} />
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Products</p>
        <h2>Two products closing the AI governance loop for IT.</h2>
      </div>
      <ProductCards solution={itip} />
    </div>
  </section>

</BaseLayout>
