---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import UsageCases from '../../../components/UsageCases.astro';
import { useCasesForSolution } from '../../../data/usage.ts';
import Icon from '../../../components/Icon.astro';
import ProductCards from '../../../components/ProductCards.astro';
import SolutionValueCards from '../../../components/SolutionValueCards.astro';
import SolutionCapabilityCards from '../../../components/SolutionCapabilityCards.astro';
import { platformSolutions } from '../../../data/poesis-platform.ts';

const itip = platformSolutions.find((s) => s.slug === 'itip')!;
---
<BaseLayout
  title="The IT Intelligence Platform — AI governance for IT"
  description={itip.description}
  pageType="Solution"
>
  <section class="hero hero--split">
    <div class="container">
      <p class="eyebrow"><a href="/#portfolio">{itip.tags.join(' · ')} · Solution</a></p>
      <h1>The IT Intelligence Platform — AI governance for IT.</h1>
      <p class="lead">{itip.tagline}</p>
      <div class="hero-promise">
        <p>{itip.description}</p>
        <p>The digital-twin ambition distinguishes accepted intent, inspected source revisions and fresh deployed observations.</p>
      </div>
      <div class="hero-cta">
        <span class="btn btn-primary" aria-disabled="true"><Icon name="azure" /> SaaS Demo Instance <span class="tag tag--muted">coming soon</span></span>
        <span class="btn btn-ghost" aria-disabled="true"><Icon name="store" /> SaaS on Azure Marketplace <span class="tag tag--muted">coming soon</span></span>
        <a class="btn btn-ghost" href="https://docs.poesis.cloud/itip/"><Icon name="docs" /> Read the docs</a>
      </div>
      <p class="hero-note"><a href="/insights/digital-twin-of-an-organization/">Insights · why the twin pattern works here →</a></p>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Values</p>
        <h2>Shared definitions and reviewable evidence for IT decisions.</h2>
      </div>
      <SolutionValueCards solution={itip} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Capabilities</p>
        <h2>Planned inventory, composition, sourcing, appraisal, reasoning and generation.</h2>
      </div>
      <SolutionCapabilityCards solution={itip} />
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Products</p>
        <h2>Two products for the IT governance workflow.</h2>
      </div>
      <ProductCards solution={itip} />
    </div>
  </section>

  <UsageCases cases={useCasesForSolution('itip')} title="IT decision and review use cases" />
</BaseLayout>
