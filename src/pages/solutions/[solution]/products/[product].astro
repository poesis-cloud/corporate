---
/**
 * Product sub-page — one page per Product inside each Solution.
 * URL: /solutions/[solution]/products/[product] (e.g. /solutions/sie/products/definition-manager).
 * Structure: hero (solution pill · product name · catchy lead · description promise · CTAs) →
 * Values → Features (one entry per feature, anchored) → Roadmap.
 * Section rhythm and item formats mirror the homepage.
 */
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Icon from '../../../../components/Icon.astro';
import DeliveryStatus from '../../../../components/DeliveryStatus.astro';
import ProductRoadmap from '../../../../components/ProductRoadmap.astro';
import UsageCases from '../../../../components/UsageCases.astro';
import CatalogCard from '../../../../components/CatalogCard.astro';
import { useCasesForProduct, productValues, usageFeatures } from '../../../../data/usage.ts';
import { featureCard, valueCard } from '../../../../data/catalog-card.ts';
import { platformSolutions, productTimeline, plannedClass, productStatus, solutionHref } from '../../../../data/poesis-platform.ts';

export function getStaticPaths() {
  return platformSolutions.flatMap((solution) =>
    solution.products.map((product) => ({
      params: { solution: solution.slug, product: product.slug },
      props: { solution, product },
    }))
  );
}

const { solution, product } = Astro.props;
const state = productStatus(product);
const productFeatureCards = usageFeatures
  .filter((entry) => entry.solution.slug === solution.slug && entry.product.slug === product.slug)
  // On its owning product page a feature anchors under its own slug; the
  // catalog needs a platform-wide anchor. Same card, local address.
  .map((entry) => ({ ...featureCard(entry), anchor: entry.feature.slug }));
---
<BaseLayout
  title={`${product.name} — ${solution.fullName}`}
  description={`${product.name}, a product of ${solution.fullName} (${solution.name}). ${product.tagline}`}
  pageType="Product"
>
  <section class="hero hero--split">
    <div class="container">
      <p class="eyebrow"><a href={solutionHref(solution)}>{solution.tags.join(' · ')} · Solution</a> <DeliveryStatus state={state} /></p>
      <h1>{product.name} — {solution.fullName}.</h1>
      <p class="lead">{product.tagline}</p>
      <div class="hero-promise">
        {product.description.split('\n\n').map((para) => (
          <p>
            {para.split('\n').map((line, index, lines) => (
              <>
                {line}
                {index < lines.length - 1 && <br />}
              </>
            ))}
          </p>
        ))}
      </div>
      <div class="hero-cta">
        {product.docs?.map((d, i) => <a class={`btn ${i === 0 ? 'btn-primary' : 'btn-ghost'}`} href={d.href}><Icon name="docs" /> {i === 0 ? 'Read the docs' : d.label}</a>)}
        {product.repos?.map((r) => <a class="btn btn-ghost" href={r.href}><Icon name="github" /> Browse the repo</a>)}
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Values</p>
        <h2>{product.valuesHeadline}</h2>
      </div>
      <ul class="think-consequence-list catalog-grid portfolio-values">
        {productValues(solution.slug, product.slug).map((value) => <CatalogCard card={valueCard(value)} />)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Features</p>
        <h2>{product.featuresHeadline}</h2>
      </div>
      <ul class="think-therapy__grid catalog-grid portfolio-features">
        {productFeatureCards.map((card) => <CatalogCard card={card} variant="platform" />)}
      </ul>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Roadmap</p>
        <h2>Where {product.name} is going.</h2>
      </div>
      <p>Recorded version: v{product.currentVersion}. Historical release labels do not establish the current feature scope above.</p>
      <ProductRoadmap features={product.features} milestones={productTimeline(product)} />
    </div>
  </section>
  <UsageCases cases={useCasesForProduct(solution.slug, product.slug)} title={`Use cases involving ${product.name}`} />
</BaseLayout>

