---
/**
 * Product sub-page — one page per Product inside each Solution.
 * URL: /solutions/[solution]/products/[product] (e.g. /solutions/sie/products/definition-manager).
 * Structure: hero (solution pill · product name · catchy lead · CTAs) →
 * Why it matters (value cards) → Features (one card per feature, anchored).
 */
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Icon from '../../../../components/Icon.astro';
import ProductRoadmap from '../../../../components/ProductRoadmap.astro';
import { solutions } from '../../../../data/solutions.ts';
import { roadmapFor, featureStatus } from '../../../../data/roadmap.ts';

export function getStaticPaths() {
  return solutions.flatMap((solution) =>
    solution.products.map((product) => ({
      params: { solution: solution.slug, product: product.slug },
      props: { solution, product },
    }))
  );
}

const { solution, product } = Astro.props;
const roadmap = roadmapFor(solution.slug, product.slug);
---
<BaseLayout
  title={`${product.name} — ${solution.fullName}`}
  description={`${product.name}, a product of ${solution.fullName} (${solution.name}). ${product.tagline}`}
  pageType="Product"
>
  <section class="hero">
    <div class="container">
      <p class="eyebrow"><a href={solution.href}>{solution.tag} · Solution</a></p>
      <h1>{product.name} — {solution.fullName}.</h1>
      <p class="lead">{product.tagline}</p>
      <div class="hero-cta">
        {product.docs?.map((d, i) => <a class={`btn ${i === 0 ? 'btn-primary' : 'btn-ghost'}`} href={d.href}><Icon name="docs" /> {i === 0 ? 'Read the docs' : d.label}</a>)}
        {product.repos?.map((r) => <a class="btn btn-ghost" href={r.href}><Icon name="github" /> Browse the repo</a>)}
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <p class="eyebrow">Why it matters</p>
      <h2>What {product.name} changes for you.</h2>
      {product.description.split('\n\n').map((para) => (
        <p class="lead">
          {para.split('\n').map((line, index, lines) => (
            <>
              {line}
              {index < lines.length - 1 && <br />}
            </>
          ))}
        </p>
      ))}
      <div class="grid grid-2" style="margin-top:1.5rem">
        {product.values.map((v) => (
          <div class="card card--feature card--static">
            <span class="tag tag--value">Value</span>
            <h3>{v.title}</h3>
            <p>{v.body}</p>
            {v.features.length > 0 ? (
              <p class="pain-addressed">
                Delivered by{' '}
                {v.features.map((fs, i) => (
                  <>
                    {i > 0 && ' · '}
                    <a href={`#${fs}`}>{product.features.find((f) => f.slug === fs)!.name}</a>
                  </>
                ))}
              </p>
            ) : (
              <p class="pain-addressed">A property of the product — how it is built, not a feature.</p>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Features</p>
      <h2>What {product.name} does.</h2>
      <div class="grid grid-2" style="margin-top:1.5rem">
        {product.features.map((f) => {
          const status = featureStatus(roadmap, f.slug);
          return (
            <div class="card card--feature card--static" id={f.slug}>
              <span class="tag tag--feature-pill">Feature</span>
              {status && (
                <span class={`tag tag--version ${status.shipped ? 'tag--value' : 'tag--muted'}`}>
                  {status.shipped ? `shipped · v${status.version}` : `planned · v${status.version}`}
                </span>
              )}
              <h3>{f.name}</h3>
              <p>{f.blurb}</p>
            </div>
          );
        })}
      </div>
      {roadmap ? (
        <>
          <p class="eyebrow" style="margin-top:2.5rem">Roadmap</p>
          <ProductRoadmap roadmap={roadmap} />
        </>
      ) : (
        <p class="text-small" style="margin-top:1rem;opacity:.75">
          Features ship per the canonical <a href="https://docs.poesis.cloud/milestones/">Milestones &amp; Versions</a> register — ordered intent, not delivery commitments or dates.
        </p>
      )}
    </div>
  </section>
</BaseLayout>

