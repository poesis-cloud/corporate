---
/**
 * Product sub-page — one page per Product inside each Solution.
 * URL: /solutions/[solution]/products/[product] (e.g. /solutions/sie/products/definition-manager).
 * Structure: hero (solution pill · product name · catchy lead · description promise · CTAs) →
 * Values → Features (one entry per feature, anchored) → Roadmap.
 * Section rhythm and item formats mirror the homepage.
 */
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Icon from '../../../../components/Icon.astro';
import ProductRoadmap from '../../../../components/ProductRoadmap.astro';
import { poesisPortfolio, productTimeline, featureStatus } from '../../../../data/poesis-portfolio.ts';

export function getStaticPaths() {
  return poesisPortfolio.flatMap((solution) =>
    solution.products.map((product) => ({
      params: { solution: solution.slug, product: product.slug },
      props: { solution, product },
    }))
  );
}

const { solution, product } = Astro.props;
---
<BaseLayout
  title={`${product.name} — ${solution.fullName}`}
  description={`${product.name}, a product of ${solution.fullName} (${solution.name}). ${product.tagline}`}
  pageType="Product"
>
  <section class="hero hero--split">
    <div class="container">
      <p class="eyebrow"><a href={solution.href}>{solution.tag} · Solution</a></p>
      <h1>{product.name} — {solution.fullName}.</h1>
      <p class="lead">{product.tagline}</p>
      <div class="hero-promise">
        {product.description.split('\n\n').map((para) => (
          <p>
            {para.split('\n').map((line, index, lines) => (
              <>
                {line}
                {index < lines.length - 1 && <br />}
              </>
            ))}
          </p>
        ))}
      </div>
      <div class="hero-cta">
        {product.docs?.map((d, i) => <a class={`btn ${i === 0 ? 'btn-primary' : 'btn-ghost'}`} href={d.href}><Icon name="docs" /> {i === 0 ? 'Read the docs' : d.label}</a>)}
        {product.repos?.map((r) => <a class="btn btn-ghost" href={r.href}><Icon name="github" /> Browse the repo</a>)}
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Values</p>
        <h2>What {product.name} changes for you.</h2>
      </div>
      <ul class="think-consequence-list portfolio-values">
        {product.values.map((v) => (
          <li>
            <span class="think-consequence__head">
              <span class="think-consequence__icon"><Icon name={v.vision ? 'compass' : 'check-badge'} size={16} /></span>
              <span class="think-consequence__step">{v.vision ? 'Vision' : 'Value'}</span>
            </span>
            <strong>{v.title}</strong>
            <p>{v.body}</p>
            {v.features.length > 0 ? (
              <p class="proof-line">
                <span>Delivered by</span>
                {v.features.map((fs, i) => (
                  <>
                    {i > 0 && ' · '}
                    <a href={`#${fs}`}>{product.features.find((f) => f.slug === fs)!.name}</a>
                  </>
                ))}
              </p>
            ) : (
              <p class="proof-line">
                <span>Intrinsic</span>
                A property of the product — how it is built, not a feature.
              </p>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Features</p>
        <h2>What {product.name} does.</h2>
      </div>
      <ul class="think-therapy__grid portfolio-features">
        {product.features.map((f) => {
          const status = featureStatus(f);
          return (
            <li id={f.slug}>
              <span class="think-capability__head">
                <span class="think-capability__icon"><Icon name={status.shipped ? 'check-badge' : 'lightbulb'} size={16} /></span>
                <span class="think-capability__step">
                  {status.shipped ? `shipped · v${status.version}` : `planned · v${status.version}`}
                </span>
              </span>
              <strong>{f.name}</strong>
              <p>{f.blurb}</p>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Roadmap</p>
        <h2>Where {product.name} is going.</h2>
      </div>
      <ProductRoadmap milestones={productTimeline(product)} />
    </div>
  </section>
</BaseLayout>

