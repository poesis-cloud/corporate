---
/**
 * Product sub-page — one page per Product inside each Solution.
 * URL: /solutions/[solution]/products/[product] (e.g. /solutions/sie/products/definition-manager).
 * Structure: hero (solution pill · product name · catchy lead · description promise · CTAs) →
 * Values → Features (one entry per feature, anchored) → Roadmap.
 * Section rhythm and item formats mirror the homepage.
 */
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Icon from '../../../../components/Icon.astro';
import DeliveryStatus from '../../../../components/DeliveryStatus.astro';
import ProductRoadmap from '../../../../components/ProductRoadmap.astro';
import UsageCases from '../../../../components/UsageCases.astro';
import ItemRelations from '../../../../components/ItemRelations.astro';
import { useCasesForProduct, productValues, usageIcons, usageRelations, valueAnchor, valueAliases, valueStatus, valueSupports } from '../../../../data/usage.ts';
import { platformSolutions, productTimeline, featureStatus, plannedClass, productStatus, relationQualifiers, solutionHref, typeIcons } from '../../../../data/poesis-platform.ts';

export function getStaticPaths() {
  return platformSolutions.flatMap((solution) =>
    solution.products.map((product) => ({
      params: { solution: solution.slug, product: product.slug },
      props: { solution, product },
    }))
  );
}

const { solution, product } = Astro.props;
const state = productStatus(product);
---
<BaseLayout
  title={`${product.name} — ${solution.fullName}`}
  description={`${product.name}, a product of ${solution.fullName} (${solution.name}). ${product.tagline}`}
  pageType="Product"
>
  <section class="hero hero--split">
    <div class="container">
      <p class="eyebrow"><a href={solutionHref(solution)}>{solution.tags.join(' · ')} · Solution</a> <DeliveryStatus state={state} /></p>
      <h1>{product.name} — {solution.fullName}.</h1>
      <p class="lead">{product.tagline}</p>
      <div class="hero-promise">
        {product.description.split('\n\n').map((para) => (
          <p>
            {para.split('\n').map((line, index, lines) => (
              <>
                {line}
                {index < lines.length - 1 && <br />}
              </>
            ))}
          </p>
        ))}
      </div>
      <div class="hero-cta">
        {product.docs?.map((d, i) => <a class={`btn ${i === 0 ? 'btn-primary' : 'btn-ghost'}`} href={d.href}><Icon name="docs" /> {i === 0 ? 'Read the docs' : d.label}</a>)}
        {product.repos?.map((r) => <a class="btn btn-ghost" href={r.href}><Icon name="github" /> Browse the repo</a>)}
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Values</p>
        <h2>{product.valuesHeadline}</h2>
      </div>
      <ul class="think-consequence-list portfolio-values">
        {productValues(solution.slug, product.slug).map((v) => {
          const supports = valueSupports(v.slug);
          return (
          <li id={valueAnchor(v)} class={plannedClass(valueStatus(v.slug))}>
            {valueAliases(v).map((alias) => <span id={alias} class="claim-anchor" aria-hidden="true" />)}
            <span class="think-consequence__head">
              <span class="think-consequence__icon"><Icon name={usageIcons.value} size={16} /></span>
              <span class="think-consequence__step">Value</span>
              <DeliveryStatus state={valueStatus(v.slug)} />
            </span>
            <strong>{v.title}</strong>
            <p>{v.body}</p>
            {supports.length > 0 ? (
              <p class="proof-line">
                <span>{relationQualifiers.productValueFeatures(supports.length)}</span>
                {supports.map((support, i) => {
                  const slug = support.slug.split('/')[2];
                  const f = product.features.find((c) => c.slug === slug)!;
                  return (
                    <>
                      {i > 0 && ' · '}
                      <a class={plannedClass(f.delivery.state)} href={`#${slug}`}>{f.name} <DeliveryStatus state={f.delivery.state} compact /></a>
                    </>
                  );
                })}
              </p>
            ) : (
              <p class="proof-line">
                <span>Product commitment</span>
                Implementation scope will be assigned to supporting features.
              </p>
            )}
          </li>
          );
        })}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Features</p>
        <h2>{product.featuresHeadline}</h2>
      </div>
      <ul class="think-therapy__grid portfolio-features">
        {product.features.map((f) => {
          const status = featureStatus(f);
          return (
            <li id={f.slug} class={plannedClass(f.delivery.state)}>
              <span class="think-capability__head">
                <span class="think-capability__icon"><Icon name={typeIcons.feature} size={16} /></span>
                <span class="think-capability__step">
                  Feature · milestone v{status.version}
                </span>
                <DeliveryStatus state={status.state} />
              </span>
              <strong>{f.name}</strong>
              <p>{f.blurb}</p>
              <ItemRelations groups={usageRelations(f)} />
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Roadmap</p>
        <h2>Where {product.name} is going.</h2>
      </div>
      <p>Recorded version: v{product.currentVersion}. Historical release labels do not establish the current feature scope above.</p>
      <ProductRoadmap features={product.features} milestones={productTimeline(product)} />
    </div>
  </section>
  <UsageCases cases={useCasesForProduct(solution.slug, product.slug)} title={`Use cases involving ${product.name}`} />
</BaseLayout>

