---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProductCards from '../../../components/ProductCards.astro';
import { solutions } from '../../../data/solutions.ts';

const framework = solutions.find((s) => s.slug === 'framework')!;
const [h1, ...rest] = framework.tagline.split(' — ');
const lead = rest.join(' — ');
const leadText = lead.charAt(0).toUpperCase() + lead.slice(1);
const demoUrl = 'https://demo.poesis.cloud';
const azureUrl = 'https://azuremarketplace.microsoft.com';
---
<BaseLayout
  title="The Framework"
  description="The Poesis SAFe Agentic Framework — open, Apache-2.0 agentic orchestration across portfolio, program, and iteration, from THINK down to the BUILD hand-off."
>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">{framework.tag} · Solution</p>
      <h1>{h1}.</h1>
      <p class="lead">{leadText}</p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="https://docs.poesis.cloud/safe-agentic-framework/">Read the docs</a>
        <a class="btn btn-ghost" href="https://docs.poesis.cloud/safe-agentic-framework/quickstart/">Quickstart</a>
        <a class="btn btn-ghost" href="https://github.com/poesis-cloud/safe-agentic-framework">Get it on GitHub</a>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <p class="eyebrow">Why it matters</p>
      <h2>The generative bridge — and the harness that makes it trustworthy.</h2>
      <div class="grid grid-2" style="margin-top:1.5rem">
        <div class="card--disclosure">
          <h3>Definitions that generate systems.</h3>
          <p>The framework orchestrates the whole THINK space — portfolio, product, and team workflows — and BUILD is its last orchestration layer: governed GSM definitions become running systems, making GSM's promise, “definitions that generate systems”, literally true, and closing THINK → BUILD → RUN as one loop.</p>
        </div>
        <div class="card--disclosure">
          <h3>A method, run by agents, as a harness.</h3>
          <p>AI runs on intuition — exactly like we do — and methods are how intuition becomes reliable. SAFe, run by agents with a human ★ gate at every layer, is the cognitive harness that makes agentic delivery trustworthy. You don't wait for a smarter model; you make it implement a method.</p>
        </div>
        <div class="card--disclosure">
          <h3>Many small agents beat one big one.</h3>
          <p>A probabilistic model is most reliable — and cheapest — when its task is small, bounded, and well-specified. SAFe's portfolio → program → iteration hierarchy decomposes delivery once, so every agent stays focused and every layer adds a check.</p>
        </div>
        <div class="card--disclosure">
          <h3>Open, local-first, sovereign.</h3>
          <p>Apache-2.0, running on your machine against your working tree — work state lives in your own files and git history, not a vendor's cloud. Standard, homogeneous artifacts synchronize through your shared repo, contextualizing every other local orchestration.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Products</p>
      <h2>Three products, one governed delivery loop.</h2>
      <ProductCards solution={framework} />
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <p class="eyebrow">SaaS</p>
      <h2>Pair it with the managed cloud.</h2>
      <p class="lead">The framework complements ITIP and integrates with SIE — see the governed definitions it generates against, live on the managed instance.</p>
      <div class="hero-cta">
        <a class="btn btn-primary" href={demoUrl}>ITIP demo instance <span class="tag tag--muted">incoming</span></a>
        <a class="btn btn-ghost" href={azureUrl}>Azure Marketplace <span class="tag tag--muted">coming soon</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
