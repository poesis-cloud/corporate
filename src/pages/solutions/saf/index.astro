---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import ProductCards from '../../../components/ProductCards.astro';
import SolutionValueCards from '../../../components/SolutionValueCards.astro';
import SolutionCapabilityCards from '../../../components/SolutionCapabilityCards.astro';
import { poesisPortfolio } from '../../../data/poesis-portfolio.ts';

const saf = poesisPortfolio.find((s) => s.slug === 'saf')!;
---
<BaseLayout
  title="The Systemic Agentic Framework — the first distributed agentic SAFe engine"
  description="The first distributed agentic SAFe engine: AI agents run SAFe across portfolio, program, and iteration — open, Apache-2.0, local-first, with a human gate at every layer. Agentic transformation with a method — spec-driven delivery from governed definitions."
  pageType="Solution"
>
  <section class="hero hero--split">
    <div class="container">
      <p class="eyebrow"><a href="/#portfolio">{saf.tag} · Solution</a></p>
      <h1>The Systemic Agentic Framework — the first distributed agentic SAFe engine.</h1>
      <p class="lead">SAFe run by AI agents — portfolio to iteration, Apache-2.0 and local-first, with a human ★ gate at every layer.</p>
      <div class="hero-promise">
        <p>An <strong>org chart, not a swarm</strong>: SAFe’s portfolio → program → iteration hierarchy, staffed by agents, running on your own machine.</p>
        <p>Every step is checked by the harness and closed by a human ★ gate — and the validated artifacts sync out to the shared workspace.</p>
      </div>
      <div class="hero-cta">
        <a class="btn btn-primary" href="https://docs.poesis.cloud/saf/quickstart/"><Icon name="play" /> Quickstart</a>
        <a class="btn btn-ghost" href="https://docs.poesis.cloud/saf/"><Icon name="docs" /> Read the docs</a>
      </div>
      <p class="hero-note"><a href="/insights/agentic-safe/">Insights · agentic SAFe — running the Scaled Agile Framework with AI agents →</a></p>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Values</p>
        <h2>A method agents implement as a harness, run locally and sovereignly by everyone — turning governed definitions into systems, and delivery history back into governed context.</h2>
      </div>
      <SolutionValueCards solution={saf} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Capabilities</p>
        <h2>Run SAFe as deterministic agentic workflows under enforced artifact contracts and a human gate at every layer — locally, on your own tree, with the history sourced back into the model.</h2>
      </div>
      <SolutionCapabilityCards solution={saf} />
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Products</p>
        <h2>Four products, one governed delivery loop — spec-driven, harnessed, human-gated.</h2>
      </div>
      <ProductCards solution={saf} />
    </div>
  </section>

</BaseLayout>
