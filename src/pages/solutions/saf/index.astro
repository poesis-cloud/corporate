---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import UsageCases from '../../../components/UsageCases.astro';
import { useCasesForSolution } from '../../../data/usage.ts';
import Icon from '../../../components/Icon.astro';
import ProductCards from '../../../components/ProductCards.astro';
import SolutionValueCards from '../../../components/SolutionValueCards.astro';
import SolutionCapabilityCards from '../../../components/SolutionCapabilityCards.astro';
import QualityList from '../../../components/QualityList.astro';
import { solutionQualities } from '../../../data/qualities.ts';
import { platformSolutions } from '../../../data/poesis-platform.ts';

const saf = platformSolutions.find((s) => s.slug === 'saf')!;
---
<BaseLayout
  title="The Systemic Agentic Framework — local agentic SAFe workflows"
  description={saf.description}
  pageType="Solution"
>
  <section class="hero hero--split">
    <div class="container">
      <p class="eyebrow"><a href="/#portfolio">{saf.tags.join(' · ')} · Solution</a></p>
      <h1>The Systemic Agentic Framework — local agentic SAFe workflows.</h1>
      <p class="lead">{saf.tagline}</p>
      <div class="hero-promise">
        <p>{saf.description}</p>
        <p>Roles and workflows support local work. The three local-tool products use Apache-2.0; the planned SIE bridge has a separate BUSL-1.1 boundary.</p>
      </div>
      <div class="hero-cta">
        <a class="btn btn-primary" href="https://docs.poesis.cloud/saf/quickstart/"><Icon name="play" /> Quickstart</a>
        <a class="btn btn-ghost" href="https://docs.poesis.cloud/saf/"><Icon name="docs" /> Read the docs</a>
      </div>
      <p class="hero-note"><a href="/insights/agentic-safe/">Insights · agentic SAFe — running the Scaled Agile Framework with AI agents →</a></p>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Values</p>
        <h2>Reviewable methods and explicit control boundaries.</h2>
      </div>
      <SolutionValueCards solution={saf} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Capabilities</p>
        <h2>Local controls and method content, with planned approval and sourcing integrations.</h2>
      </div>
      <SolutionCapabilityCards solution={saf} />
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Products</p>
        <h2>Four products with distinct local and planned integration scopes.</h2>
      </div>
      <ProductCards solution={saf} />
    </div>
  </section>

  <section id="qualities" class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Qualities</p>
        <h2>What runs locally, and what waits for a human.</h2>
      </div>
      <QualityList qualities={solutionQualities('saf')} />
    </div>
  </section>

  <UsageCases cases={useCasesForSolution('saf')} title="Reviewed agentic delivery use cases" />
</BaseLayout>
