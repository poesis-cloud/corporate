---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import ProductCards from '../../../components/ProductCards.astro';
import SafFlowDiagram from '../../../components/SafFlowDiagram.astro';
import { solutions } from '../../../data/solutions.ts';

const saf = solutions.find((s) => s.slug === 'saf')!;
const [h1, ...rest] = saf.tagline.split(' — ');
const lead = rest.join(' — ');
const leadText = lead.charAt(0).toUpperCase() + lead.slice(1);
---
<BaseLayout
  title="SAF — Agentic SAFe Orchestration"
  description="The first distributed agentic SAFe engine: AI agents run SAFe across portfolio, program, and iteration — open, Apache-2.0, local-first, with a human gate at every layer."
  pageType="Solution"
>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">{saf.tag} · Solution</p>
      <h1>The first distributed agentic SAFe engine.</h1>
      <p class="lead">{h1} — {leadText}</p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="https://docs.poesis.cloud/saf/"><Icon name="docs" /> Read the docs</a>
        <a class="btn btn-ghost" href="https://github.com/poesis-cloud"><Icon name="github" /> Browse the repos</a>
        <a class="btn btn-ghost" href="https://docs.poesis.cloud/saf/quickstart/"><Icon name="play" /> Quickstart</a>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <p class="eyebrow">Why it matters</p>
      <h2>The generative bridge — and the harness that makes it trustworthy.</h2>
      <div class="grid grid-2" style="margin-top:1.5rem">
        {saf.values.map((v) => (
          <div class="card card--feature card--static">
            <span class="tag tag--value">Value</span>
            <h3>{v.title}</h3>
            <p set:html={v.body} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">The method</p>
      <h2>Three layers, three gates, one merged commit.</h2>
      <p class="lead">Your strategic, tactical, and technical concerns enter their layer on your own machine — each layer orchestrated by agents running governed workflows, each closed by a human ★ gate, every step checked by the harness — and the validated artifacts sync out to the central workspace, contextualizing every other orchestration.</p>
      <SafFlowDiagram />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Products</p>
      <h2>Three products, one governed delivery loop.</h2>
      <ProductCards solution={saf} />
    </div>
  </section>

</BaseLayout>
