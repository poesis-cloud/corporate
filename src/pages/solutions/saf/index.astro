---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import ProductCards from '../../../components/ProductCards.astro';
import SolutionValueCards from '../../../components/SolutionValueCards.astro';
import SafFlowDiagram from '../../../components/SafFlowDiagram.astro';
import { poesisPortfolio } from '../../../data/poesis-portfolio.ts';

const saf = poesisPortfolio.find((s) => s.slug === 'saf')!;
const [, ...rest] = saf.tagline.split(' — ');
const lead = rest.join(' — ');
const leadText = lead.charAt(0).toUpperCase() + lead.slice(1);
---
<BaseLayout
  title="The Systemic Agentic Framework — the first distributed agentic SAFe engine"
  description="The first distributed agentic SAFe engine: AI agents run SAFe across portfolio, program, and iteration — open, Apache-2.0, local-first, with a human gate at every layer. Agentic transformation with a method — spec-driven delivery from governed definitions."
  pageType="Solution"
>
  <section class="hero">
    <div class="container">
      <p class="eyebrow"><a href="/#portfolio">{saf.tag} · Solution</a></p>
      <h1>The Systemic Agentic Framework — the first distributed agentic SAFe engine.</h1>
      <p class="lead">{leadText}</p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="https://docs.poesis.cloud/saf/"><Icon name="docs" /> Read the docs</a>
        <a class="btn btn-ghost" href="https://github.com/poesis-cloud"><Icon name="github" /> Browse the repos</a>
        <a class="btn btn-ghost" href="https://docs.poesis.cloud/saf/quickstart/"><Icon name="play" /> Quickstart</a>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <p class="eyebrow">Why it matters</p>
      <h2>Agentic transformation with a method — and the harness that makes it trustworthy.</h2>
      <SolutionValueCards solution={saf} />
      <p style="margin-top:1.25rem;text-align:center"><a href="/insights/agentic-safe/">Read: agentic SAFe — running the Scaled Agile Framework with AI agents →</a></p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">The mental model</p>
      <h2>Three layers, three gates, one merged commit.</h2>
      <p class="lead">Think of an org chart, not a swarm: SAFe’s portfolio → program → iteration hierarchy, staffed by agents. Your strategic, tactical, and technical concerns enter their layer on your own machine — each layer orchestrated by agents running governed workflows, each closed by a human ★ gate, every step checked by the harness — and the validated artifacts sync out to the central workspace, contextualizing every other orchestration.</p>
      <SafFlowDiagram />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Products</p>
      <h2>Three products, one governed delivery loop — spec-driven, harnessed, human-gated.</h2>
      <ProductCards solution={saf} />
    </div>
  </section>

</BaseLayout>
