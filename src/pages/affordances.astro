---
import CatalogLayout from '../layouts/CatalogLayout.astro';
import CatalogDirectory, { type DirectoryEntry } from '../components/CatalogDirectory.astro';
import { affordanceHref, poesisUsage, usageAffordances } from '../data/usage.ts';
import { affordanceStatus, typeIcons } from '../data/poesis-platform.ts';

// Same anatomy as the homepage affordance card: the name is the step label and
// the title is the heading, so an affordance reads identically on both pages.
const entries: DirectoryEntry[] = usageAffordances.map((entry) => ({
  anchor: `affordance-${entry.slug}`,
  eyebrow: entry.affordance.name,
  icon: typeIcons.affordance,
  title: entry.affordance.title,
  body: entry.affordance.blurb,
  status: affordanceStatus(entry.affordance),
  meta: [{ label: 'Platform overview', href: affordanceHref(entry) }, { label: `${entry.affordance.relations.capabilities.length} supporting capabilities` }],
  links: poesisUsage.useCases.filter((useCase) => entry.affordance.useCases.includes(useCase.slug)).map((useCase) => ({ label: useCase.name, href: `/usage/${useCase.slug}` })),
  empty: 'No use case declared.',
}));
---
<CatalogLayout
  title="Poesis affordances"
  description="What the Poesis platform lets people and agents do, with the capabilities behind each affordance and the use cases it serves."
  heading="Affordances"
  lead="What the platform lets people and agents do. Each affordance is delivered only when an accepted route of supporting capabilities is."
  count={`${entries.length} affordances`}
>
  <CatalogDirectory id="affordances" eyebrow="Affordances" title="What the platform makes possible" entries={entries} variant="platform" relation="Declared use cases" />
</CatalogLayout>
