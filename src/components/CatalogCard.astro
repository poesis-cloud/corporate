---
/**
 * CatalogCard — the only place a catalog item is rendered.
 *
 * The anatomy never varies: type and status in the head, the item's own
 * identity as the heading, an optional hook, the body, metadata tags, and the
 * relation type links in the footer. `variant` selects the surrounding skin.
 */
import DeliveryStatus from './DeliveryStatus.astro';
import Icon from './Icon.astro';
import ItemRelations from './ItemRelations.astro';
import { plannedClass } from '../data/poesis-platform.ts';
import { cardTypeIcons, cardTypeLabels, type CatalogCard } from '../data/catalog-card.ts';

interface Props {
  card: CatalogCard;
  /** Heading level, so a card fits the document structure of its host page. */
  as?: 'h3' | 'h4';
  variant?: 'platform' | 'usage';
}
const { card, as: Heading = 'h3', variant = 'usage' } = Astro.props;
const block = variant === 'platform' ? 'think-capability' : 'think-consequence';
---
<li id={card.anchor} data-catalog-slug={card.slug ?? card.anchor} class={plannedClass(card.status)} {...card.data}>
  {card.aliases?.filter((alias) => alias !== card.anchor).map((alias) => <span id={alias} class="claim-anchor" aria-hidden="true" />)}
  <span class={`${block}__head`}>
    <span class={`${block}__icon`}><Icon name={cardTypeIcons[card.type]} size={16} /></span>
    <span class={`${block}__step`}>{cardTypeLabels[card.type]}</span>
    {card.availability ? <span class:list={['service-availability', { 'service-availability--planned': card.availability === 'Planned' }]} data-service-availability={card.availability}><Icon name={card.availability === 'Planned' ? 'clock' : 'check-badge'} size={14} />{card.availability}</span> : <DeliveryStatus state={card.status} />}
  </span>
  <Heading>{card.href ? <a href={card.href}>{card.heading}</a> : card.heading}</Heading>
  {card.hook && <p class="catalog-hook">{card.hook}</p>}
  {card.bodyHtml ? <p set:html={card.body} /> : <p>{card.body}</p>}
  {card.tags.length ? (
    <ul class="catalog-tags" aria-label={`${card.heading} themes`}>
      {card.tags.map((tag) => <li>{tag}</li>)}
    </ul>
  ) : null}
  {card.relations?.length ? <ItemRelations groups={card.relations} /> : null}
</li>

<style>
  .service-availability { display: inline-flex; align-items: center; gap: .3em; color: var(--status-delivered); font-size: .75rem; font-weight: 500; letter-spacing: 0; line-height: 1.4; white-space: nowrap; }
  .service-availability--planned { color: var(--status-planned); }
</style>
