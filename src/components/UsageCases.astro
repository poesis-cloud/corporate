---
import DeliveryStatus from './DeliveryStatus.astro';
import Icon from './Icon.astro';
import { plannedClass } from '../data/poesis-platform.ts';
import { painsForUseCase, poesisUsage, useCaseStatus, type UseCase } from '../data/usage.ts';
interface Props { cases: UseCase[]; title?: string; browse?: boolean }
const { cases, title = 'Use cases', browse = true } = Astro.props;
---
<section class="section usage-section" aria-label={title}>
  <div class="container">
    <div class="section-head usage-heading">
      <div><p class="eyebrow">Usage</p><h2>{title}</h2></div>
      {browse && <a href="/usage">All use cases <Icon name="arrow-right" /></a>}
    </div>
    <ul class="think-consequence-list catalog-grid usage-case-list">
      {cases.map((useCase) => (
        <li class={plannedClass(useCaseStatus(useCase))} data-usage-case={useCase.slug} data-actors={useCase.actorTypes.join(' ')} data-pains={painsForUseCase(useCase.slug).map((pain) => pain.slug).join(' ')}>
          <span class="think-consequence__head"><span class="think-consequence__step">Use case</span>{useCaseStatus(useCase) && <DeliveryStatus state={useCaseStatus(useCase)!} />}</span>
          <h3><a href={`/usage/${useCase.slug}`}>{useCase.name}</a></h3>
          <p>{useCase.goal}</p>
          <p class="proof-line"><span>Pursued by</span>{useCase.actorTypes.map((slug, index) => <>{index > 0 && ' · '}<a href={`/usage?actor=${slug}#use-cases`}>{poesisUsage.actorTypes.find((actor) => actor.slug === slug)!.name}</a></>)}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .usage-heading { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 1rem; }
  .usage-heading > a { display: inline-flex; align-items: center; gap: .5rem; }
  .usage-case-list > li[hidden] { display: none; }
</style>