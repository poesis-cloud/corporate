---
/**
 * GsmModelDiagram — the GSM data model, simplified and meaningful:
 * Archetypes type everything; eight primitives define the system;
 * the DNA grammar binds governance to subjects through Ascriptions.
 */
---
<div class="gsmd" role="img" aria-label="Simplified GSM data model: Archetypes type definitions; eight primitives define the system; Directives refine into Norms and bind to subjects through lifecycle-managed Ascriptions">
  <div class="gsmd-band gsmd-band--type">
    <span class="gsmd-band-label">Type</span>
    <div class="gsmd-box gsmd-box--archetype">
      <strong>Archetype</strong>
      <span>typed JSON Schema domain semantics — meaning travels with the type</span>
    </div>
    <div class="gsmd-rel" aria-hidden="true">types every definition ↓</div>
  </div>

  <div class="gsmd-band gsmd-band--define">
    <span class="gsmd-band-label">Define</span>
    <div class="gsmd-cols">
      <div class="gsmd-group">
        <span class="gsmd-group-label">the acting system</span>
        <div class="gsmd-chips">
          <span class="gsmd-chip">Structure</span>
          <span class="gsmd-chip">Mechanism</span>
          <span class="gsmd-chip">Effector</span>
          <span class="gsmd-chip">Receptor</span>
          <span class="gsmd-chip">Interaction</span>
        </div>
      </div>
      <div class="gsmd-group">
        <span class="gsmd-group-label">the governing intent</span>
        <div class="gsmd-chips">
          <span class="gsmd-chip gsmd-chip--gov">Directive</span>
          <span class="gsmd-arrow" aria-hidden="true">→ refines into →</span>
          <span class="gsmd-chip gsmd-chip--gov">Norm</span>
        </div>
      </div>
    </div>
    <div class="gsmd-rel" aria-hidden="true">bound to subjects through ↓</div>
  </div>

  <div class="gsmd-band gsmd-band--bind">
    <span class="gsmd-band-label">Bind</span>
    <div class="gsmd-box gsmd-box--ascription">
      <strong>Ascription</strong>
      <span>the versioned, lifecycle-managed binding of a definition to its subject — <code>DRAFT → … → ACTIVE → … → RETIRED</code></span>
    </div>
  </div>
</div>

<style>
  .gsmd {
    margin-top: 1.75rem;
    display: grid;
    gap: 0;
  }
  .gsmd-band {
    position: relative;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--bg-soft);
    padding: 1.1rem 1.2rem 1.1rem 5.5rem;
  }
  .gsmd-band + .gsmd-band {
    margin-top: 2.1rem;
  }
  .gsmd-band-label {
    position: absolute;
    left: 1.2rem;
    top: 1.15rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .gsmd-box strong {
    display: block;
    font-size: 1rem;
    color: var(--ink);
  }
  .gsmd-box span {
    display: block;
    margin-top: 0.35rem;
    font-size: 0.88rem;
    color: var(--ink-soft);
    line-height: 1.45;
  }
  .gsmd-rel {
    position: absolute;
    left: 50%;
    bottom: -1.75rem;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted);
    white-space: nowrap;
    z-index: 1;
  }
  .gsmd-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.4rem;
  }
  .gsmd-group-label {
    display: block;
    font-size: 0.75rem;
    color: var(--muted);
    margin-bottom: 0.55rem;
  }
  .gsmd-chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
  }
  .gsmd-chip {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    color: var(--ink-soft);
    background: rgba(255, 255, 255, 0.03);
  }
  .gsmd-chip--gov {
    border-color: rgba(45, 212, 191, 0.35);
    color: var(--accent-ink);
    background: var(--accent-soft);
  }
  .gsmd-arrow {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--muted);
  }
  @media (max-width: 820px) {
    .gsmd-band {
      padding-left: 1.2rem;
      padding-top: 2.4rem;
    }
    .gsmd-cols {
      grid-template-columns: 1fr;
    }
    .gsmd-rel {
      white-space: normal;
      text-align: center;
      width: 90%;
    }
  }
</style>
