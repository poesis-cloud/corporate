---
import Icon from './Icon.astro';
import { commitmentStatus, deliveryLabels, type DeliveryState } from '../data/poesis-platform.ts';

interface Props {
  state: DeliveryState | undefined;
  /** Inside a relation link the state annotates the link, so the icon carries it alone. */
  compact?: boolean;
}

const { compact = false } = Astro.props;
const state = commitmentStatus([Astro.props.state]);
const label = deliveryLabels[state];
const variants = { planned: { modifier: 'planned', icon: 'clock' }, partial: { modifier: 'progress', icon: 'spark' }, delivered: { modifier: 'implemented', icon: 'check-badge' } };
const { modifier, icon } = variants[state];
---
{Astro.props.state !== undefined && <span class={`delivery-status is-${modifier}`} data-delivery-status={state} title={label} aria-label={label}>
  <Icon name={icon} size={14} />
  {!compact && <span>{label}</span>}
</span>}

<style>
  .delivery-status { display: inline-flex; flex: none; align-items: center; gap: 0.3em; font-family: var(--font-sans); font-size: 0.75rem; font-weight: 500; letter-spacing: 0; text-transform: none; line-height: 1.4; white-space: nowrap; vertical-align: middle; }
  .is-implemented { color: var(--status-delivered, #6aab9e); }
  .is-progress { color: var(--status-progress, #8399bd); }
  .is-planned { color: var(--status-planned, #b59b70); }
</style>