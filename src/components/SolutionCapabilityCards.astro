---
/**
 * SolutionCapabilityCards — the Capabilities grid shared by all solution pages,
 * in the same format as the homepage therapy capabilities. Each card is labelled
 * with the Poesis platform capability it rolls up into, and names the product
 * features that realize it (→ feature anchor on the product page), the way a
 * product page's value card names the features that deliver it.
 */
import Icon from './Icon.astro';
import { capabilityRealizations, platformCapabilities, type Solution } from '../data/poesis-portfolio.ts';

interface Props {
  solution: Solution;
}

const { solution } = Astro.props;
const realizedBy = (count: number) => (count > 1 ? 'Realized by product features' : 'Realized by product feature');
---
<ul class="think-therapy__grid portfolio-capabilities">
  {solution.capabilities.map((c) => {
    const platform = platformCapabilities[c.platform];
    const realizations = capabilityRealizations(solution, c);
    return (
      <li id={c.slug}>
        <span class="think-capability__head">
          <span class="think-capability__icon"><Icon name={platform.icon} size={16} /></span>
          <span class="think-capability__step">{platform.label}</span>
        </span>
        <strong>{c.name}</strong>
        <p>{c.blurb}</p>
        <p class="proof-line">
          <span>{realizedBy(realizations.length)}</span>
          {realizations.map((r, i) => (
            <>
              {i > 0 && ' · '}
              <a href={`${solution.href}/products/${r.product.slug}#${r.feature.slug}`}>{r.feature.name}</a>
            </>
          ))}
        </p>
      </li>
    );
  })}
</ul>
