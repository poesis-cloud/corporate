---
/**
 * SolutionCapabilityCards — the Capabilities grid shared by all solution pages,
 * in the same format as the homepage therapy capabilities. Each card names the
 * product features that realize it (→ feature anchor on the product page), the
 * way a product page's value card names the features that deliver it, and the
 * platform affordance it contributes to (→ the homepage affordance card).
 */
import Icon from './Icon.astro';
import DeliveryStatus from './DeliveryStatus.astro';
import ItemRelations from './ItemRelations.astro';
import { affordanceStatus, capabilityAffordances, capabilityRealizations, capabilityStatus, plannedClass, relationQualifiers, solutionHref, typeIcons, type Solution } from '../data/poesis-platform.ts';
import { usageRelations } from '../data/usage.ts';

interface Props {
  solution: Solution;
}

const { solution } = Astro.props;
const base = solutionHref(solution);
---
<ul class="think-therapy__grid portfolio-capabilities">
  {solution.capabilities.map((c) => {
    const affordances = capabilityAffordances(solution, c);
    const realizations = capabilityRealizations(solution, c);
    const state = capabilityStatus(solution, c);
    return (
      <li id={c.slug} class={plannedClass(state)}>
        <span class="think-capability__head">
          <span class="think-capability__icon"><Icon name={typeIcons.capability} size={16} /></span>
          <span class="think-capability__step">Capability</span>
          <DeliveryStatus state={state} />
        </span>
        <strong>{c.name}</strong>
        <p>{c.blurb}</p>
        <ItemRelations groups={usageRelations(c)} />
        <p class="proof-line">
          <span>{relationQualifiers.capabilityFeatures(realizations.length)}</span>
          {realizations.map((r, i) => (
            <>
              {i > 0 && ' · '}
              <a
                class={plannedClass(r.feature.delivery.state)}
                href={`${base}/products/${r.product.slug}#${r.feature.slug}`}
              >{r.feature.name} <DeliveryStatus state={r.feature.delivery.state} compact /></a>
            </>
          ))}
        </p>
        <p class="proof-line">
          <span>{relationQualifiers.capabilityAffordance()}</span>
          {affordances.map((affordance) => <a href={`/#affordance-${affordance.slug}`}>{affordance.name} <DeliveryStatus state={affordanceStatus(affordance)} compact /></a>)}
        </p>
      </li>
    );
  })}
</ul>
