---
/**
 * SolutionCapabilityCards — the Capabilities grid shared by all solution pages,
 * in the same card as every other catalog item.
 */
import CatalogCard from './CatalogCard.astro';
import type { Solution } from '../data/poesis-platform.ts';
import { usageCapabilities } from '../data/usage.ts';
import { capabilityCard } from '../data/catalog-card.ts';

interface Props {
  solution: Solution;
}

const { solution } = Astro.props;
// On its owning solution page a capability anchors under its own slug; the
// catalog needs a platform-wide anchor. Same card, local address.
const cards = usageCapabilities
  .filter((entry) => entry.solution.slug === solution.slug)
  .map((entry) => ({ ...capabilityCard(entry), anchor: entry.capability.slug }));
---
<ul class="think-therapy__grid catalog-grid portfolio-capabilities">
  {cards.map((card) => <CatalogCard card={card} variant="platform" />)}
</ul>
