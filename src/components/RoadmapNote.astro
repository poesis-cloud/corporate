---
/**
 * RoadmapNote — the standard delivery-status note auto-rendered on every
 * insight article, so no article carries its own hand-written disclaimer.
 */
import { CLAUSE_URL } from '../data/poesis-platform.ts';
import DeliveryStatus from './DeliveryStatus.astro';
---
<aside class="roadmap-note">
  <p class="text-small">
    <strong>Reader's note — delivery status.</strong> Research articles discuss the Poesis
    stack as a designed whole. Public commitments are <DeliveryStatus state="delivered" />
    for the stated scope or <DeliveryStatus state="planned" /> while implementation is incomplete.
    Research hypotheses remain hypotheses. The canonical
    <a href={CLAUSE_URL}>Milestones &amp; Versions</a> register records each feature's status.
    Historical release labels remain separate from current feature acceptance, hosted availability and measured outcomes.
  </p>
</aside>

<style>
  .roadmap-note {
    margin: 2rem 0 0;
    padding: 0.85rem 1.1rem;
    border-left: 3px solid var(--accent, #10b981);
    background: rgba(16, 185, 129, 0.06);
    border-radius: 0 6px 6px 0;
  }
  .roadmap-note p {
    margin: 0;
    opacity: 0.85;
  }
</style>
