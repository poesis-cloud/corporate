---
/**
 * SieLoopDiagram — the SIE systemic functions and the state plane:
 * governance generates Directives; regulation operationalizes them into Norms;
 * supervision evaluates definitions and subjects against the Norms; operations
 * produce the state plane and keep it normalized from evaluation feedbacks.
 * Every function is realized by humans, AI, and/or executable GSM Mechanisms.
 */
const functions = [
  {
    name: 'Governance',
    role: 'Generates Directives — strategic intents / objectives',
    io: 'registers Directives in the Definition Manager',
  },
  {
    name: 'Regulation',
    role: 'Operationalizes Directives by generating Norms — tactical, measurable constraints / objectives',
    io: 'fetches Directives, registers Norms — Definition Manager',
  },
  {
    name: 'Supervision',
    role: 'Evaluates Definitions and defined subjects against the Norms',
    io: 'fetches Norms — Definition Manager; evaluates — Operator',
  },
  {
    name: 'Operations',
    role: 'Produces the state plane and maintains it normalized from evaluation feedbacks',
    io: 'acts on the state plane',
  },
];
const flows = ['Directives', 'Norms', 'evaluation feedbacks'];
---
<div class="loopd" role="img" aria-label="Governance generates Directives; regulation operationalizes them into Norms; supervision evaluates definitions and subjects against the Norms and feeds evaluations back to operations, which produce and normalize the state plane">
  <ol class="loopd-track">
    {functions.map((f, i) => (
      <li class="loopd-station" data-flow={i < flows.length ? flows[i] : undefined}>
        <span class="loopd-step">{f.name}</span>
        <span class="loopd-body">{f.role}</span>
        <span class="loopd-product">{f.io}</span>
      </li>
    ))}
  </ol>
  <div class="loopd-plane-links" aria-hidden="true">
    <span class="loopd-plane-link loopd-plane-link--evaluates">supervision evaluates ↓</span>
    <span class="loopd-plane-link loopd-plane-link--produces">↓ operations produce · maintain normalized</span>
  </div>
  <div class="loopd-plane">
    <span class="loopd-plane-label">State plane</span>
    <span class="loopd-plane-body">Your organization — its definitions, data, software, processes, teams, obligations — the state the functions above define, realize, evaluate, and normalize.</span>
  </div>
  <div class="loopd-return" aria-hidden="true">
    <span class="loopd-return-arrow">⟲</span>
    <span>Every function is realized by <strong>humans and/or AI</strong> and/or <strong>deterministic, executable GSM Mechanisms</strong> — the organization re-produces itself under its own definition: autopoiesis.</span>
  </div>
</div>

<style>
  .loopd {
    margin-top: 1.75rem;
  }
  .loopd-track {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2.4rem;
    margin: 0;
    padding: 0;
  }
  .loopd-station {
    position: relative;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--bg-soft);
    padding: 1.1rem 1.2rem;
  }
  .loopd-station[data-flow]::after {
    content: attr(data-flow) ' →';
    position: absolute;
    right: -2.3rem;
    top: 50%;
    transform: translateY(-50%) rotate(0deg);
    width: 2.2rem;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    line-height: 1.25;
    text-align: center;
  }
  .loopd-step {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .loopd-body {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.88rem;
    color: var(--ink-soft);
    line-height: 1.45;
  }
  .loopd-product {
    display: block;
    margin-top: 0.65rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--muted);
    line-height: 1.4;
  }
  .loopd-plane-links {
    display: flex;
    justify-content: space-between;
    padding: 0.55rem 6% 0.55rem 52%;
    gap: 1rem;
  }
  .loopd-plane-link {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--muted);
  }
  .loopd-plane {
    border: 1px solid rgba(45, 212, 191, 0.35);
    border-radius: var(--radius);
    background: var(--accent-soft);
    padding: 1rem 1.2rem;
  }
  .loopd-plane-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .loopd-plane-body {
    display: block;
    margin-top: 0.45rem;
    font-size: 0.88rem;
    color: var(--ink-soft);
    line-height: 1.45;
  }
  .loopd-return {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-top: 1.1rem;
    padding: 0.65rem 1.1rem;
    border: 1px dashed var(--line-strong);
    border-radius: 999px;
    color: var(--ink-soft);
    font-size: 0.85rem;
  }
  .loopd-return-arrow {
    color: var(--accent);
    font-size: 1.15rem;
    line-height: 1;
  }
  @media (max-width: 900px) {
    .loopd-track {
      grid-template-columns: 1fr;
      gap: 2.1rem;
    }
    .loopd-station[data-flow]::after {
      content: attr(data-flow) ' ↓';
      right: auto;
      left: 50%;
      top: auto;
      bottom: -1.7rem;
      transform: translateX(-50%);
      width: auto;
      white-space: nowrap;
    }
    .loopd-plane-links {
      padding: 0.55rem 0;
      flex-direction: column;
      gap: 0.2rem;
    }
  }
</style>
