---
/**
 * SieLoopDiagram — SIE systemic schema as one SVG:
 * actors (humans, AI, GSM Mechanisms) realize four functions
 * (governance → regulation → supervision → operations); the functions
 * interact with the SIE components (Definition Manager ⇄ Operator);
 * supervision evaluates the state plane, operations produce and normalize it.
 */
---
<svg class="loopd" viewBox="0 0 1200 760" role="img" aria-label="Humans, AI, and GSM Mechanisms realize four functions: governance generates Directives; regulation operationalizes them into Norms; supervision evaluates definitions and subjects against the Norms and feeds evaluations back to operations, which produce and normalize the state plane. Governance, regulation, and supervision interact with the Definition Manager; supervision evaluates through the Operator, which fetches definitions and Norms from the Definition Manager.">
  <defs>
    <marker id="loopd-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" class="loopd-arrhead" />
    </marker>
  </defs>

  <!-- ============ actors ============ -->
  <g class="loopd-actor">
    <rect x="415" y="12" width="120" height="42" rx="12" />
    <g transform="translate(429,24) scale(0.75)"><path class="loopd-ic" d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle class="loopd-ic" cx="12" cy="7" r="4" /></g>
    <text x="452" y="38">Humans</text>
  </g>
  <g class="loopd-actor">
    <rect x="555" y="12" width="70" height="42" rx="12" />
    <g transform="translate(566,24) scale(0.75)"><path class="loopd-ic" d="M12 2 L14.5 9.5 L22 12 L14.5 14.5 L12 22 L9.5 14.5 L2 12 L9.5 9.5 Z" /></g>
    <text x="589" y="38">AI</text>
  </g>
  <g class="loopd-actor">
    <rect x="645" y="12" width="180" height="42" rx="12" />
    <g transform="translate(658,24) scale(0.75)"><rect class="loopd-ic" x="3" y="3" width="7" height="7" /><rect class="loopd-ic" x="14" y="3" width="7" height="7" /><rect class="loopd-ic" x="3" y="14" width="7" height="7" /><rect class="loopd-ic" x="14" y="14" width="7" height="7" /></g>
    <text x="682" y="38">GSM Mechanisms</text>
  </g>

  <!-- realization edges: actors → bus → each function -->
  <g class="loopd-dash">
    <line x1="475" y1="54" x2="475" y2="88" />
    <line x1="590" y1="54" x2="590" y2="88" />
    <line x1="735" y1="54" x2="735" y2="88" />
    <line x1="135" y1="88" x2="1065" y2="88" />
    <line x1="135" y1="88" x2="135" y2="128" marker-end="url(#loopd-arr)" />
    <line x1="445" y1="88" x2="445" y2="128" marker-end="url(#loopd-arr)" />
    <line x1="755" y1="88" x2="755" y2="128" marker-end="url(#loopd-arr)" />
    <line x1="1065" y1="88" x2="1065" y2="128" marker-end="url(#loopd-arr)" />
  </g>
  <text class="loopd-edge" x="600" y="80" text-anchor="middle">realize</text>

  <!-- ============ functions ============ -->
  <g class="loopd-fn">
    <rect x="10" y="132" width="250" height="150" rx="14" />
    <g transform="translate(24,146) scale(0.62)"><circle class="loopd-ic" cx="12" cy="12" r="10" /><polygon class="loopd-ic" points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76" /></g>
    <text class="loopd-fn-name" x="46" y="158">Governance</text>
    <text class="loopd-fn-body" x="24" y="184"><tspan x="24" dy="0">Generates Directives —</tspan><tspan x="24" dy="16">strategic intents / objectives</tspan></text>
  </g>
  <g class="loopd-fn">
    <rect x="320" y="132" width="250" height="150" rx="14" />
    <g transform="translate(334,146) scale(0.62)"><path class="loopd-ic" d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /></g>
    <text class="loopd-fn-name" x="356" y="158">Regulation</text>
    <text class="loopd-fn-body" x="334" y="184"><tspan x="334" dy="0">Operationalizes Directives</tspan><tspan x="334" dy="16">by generating Norms —</tspan><tspan x="334" dy="16">tactical, measurable</tspan><tspan x="334" dy="16">constraints / objectives</tspan></text>
  </g>
  <g class="loopd-fn">
    <rect x="630" y="132" width="250" height="150" rx="14" />
    <g transform="translate(644,146) scale(0.62)"><circle class="loopd-ic" cx="11" cy="11" r="8" /><line class="loopd-ic" x1="21" y1="21" x2="16.65" y2="16.65" /></g>
    <text class="loopd-fn-name" x="666" y="158">Supervision</text>
    <text class="loopd-fn-body" x="644" y="184"><tspan x="644" dy="0">Evaluates Definitions and</tspan><tspan x="644" dy="16">defined subjects against</tspan><tspan x="644" dy="16">the Norms</tspan></text>
  </g>
  <g class="loopd-fn">
    <rect x="940" y="132" width="250" height="150" rx="14" />
    <g transform="translate(954,146) scale(0.62)"><polygon class="loopd-ic" points="5 3 19 12 5 21 5 3" /></g>
    <text class="loopd-fn-name" x="976" y="158">Operations</text>
    <text class="loopd-fn-body" x="954" y="184"><tspan x="954" dy="0">Produces the state plane</tspan><tspan x="954" dy="16">and maintains it normalized</tspan><tspan x="954" dy="16">from evaluation feedbacks</tspan></text>
  </g>

  <!-- flow edges between functions -->
  <g class="loopd-flow">
    <line x1="260" y1="207" x2="320" y2="207" marker-end="url(#loopd-arr)" />
    <line x1="570" y1="207" x2="630" y2="207" marker-end="url(#loopd-arr)" />
    <line x1="880" y1="207" x2="940" y2="207" marker-end="url(#loopd-arr)" />
  </g>
  <text class="loopd-edge" x="290" y="194" text-anchor="middle">Directives</text>
  <text class="loopd-edge" x="600" y="194" text-anchor="middle">Norms</text>
  <text class="loopd-edge" x="910" y="182" text-anchor="middle"><tspan x="910" dy="0">evaluation</tspan><tspan x="910" dy="12">feedbacks</tspan></text>

  <!-- ============ interaction edges functions → components ============ -->
  <g class="loopd-dash">
    <line x1="135" y1="282" x2="330" y2="430" marker-end="url(#loopd-arr)" />
    <line x1="445" y1="282" x2="445" y2="430" marker-end="url(#loopd-arr)" />
    <line x1="690" y1="282" x2="540" y2="434" marker-end="url(#loopd-arr)" />
    <line x1="820" y1="282" x2="856" y2="430" marker-end="url(#loopd-arr)" />
  </g>
  <text class="loopd-edge" x="200" y="368" text-anchor="middle">registers Directives</text>
  <text class="loopd-edge" x="452" y="352" text-anchor="start"><tspan x="452" dy="0">fetches Directives</tspan><tspan x="452" dy="12">registers Norms</tspan></text>
  <text class="loopd-edge" x="618" y="368" text-anchor="middle">fetches Norms</text>
  <text class="loopd-edge" x="848" y="360" text-anchor="start">evaluates through</text>

  <!-- ============ components ============ -->
  <g class="loopd-comp">
    <rect x="300" y="430" width="290" height="52" rx="12" />
    <text x="445" y="461" text-anchor="middle">Definition Manager</text>
  </g>
  <g class="loopd-comp">
    <rect x="770" y="430" width="180" height="52" rx="12" />
    <text x="860" y="461" text-anchor="middle">Operator</text>
  </g>
  <line class="loopd-flow-line" x1="770" y1="456" x2="590" y2="456" marker-end="url(#loopd-arr)" />
  <text class="loopd-edge" x="680" y="446" text-anchor="middle">fetches Definitions &amp; Norms</text>

  <!-- ============ edges to the state plane ============ -->
  <g class="loopd-flow">
    <line x1="612" y1="282" x2="612" y2="560" marker-end="url(#loopd-arr)" />
    <line x1="1065" y1="282" x2="1065" y2="560" marker-end="url(#loopd-arr)" />
  </g>
  <text class="loopd-edge" x="619" y="540" text-anchor="start">evaluates</text>
  <text class="loopd-edge" x="1072" y="528" text-anchor="start"><tspan x="1072" dy="0">produces ·</tspan><tspan x="1072" dy="12">maintains normalized</tspan></text>

  <!-- ============ state plane ============ -->
  <g class="loopd-plane">
    <rect x="10" y="564" width="1170" height="120" rx="14" />
    <g transform="translate(24,580) scale(0.62)"><polygon class="loopd-ic" points="12 2 2 7 12 12 22 7 12 2" /><polyline class="loopd-ic" points="2 17 12 22 22 17" /><polyline class="loopd-ic" points="2 12 12 17 22 12" /></g>
    <text class="loopd-fn-name" x="46" y="592">State plane</text>
    <text class="loopd-fn-body" x="24" y="620"><tspan x="24" dy="0">Your organization — its definitions, data, software, processes, teams, obligations —</tspan><tspan x="24" dy="17">the state the functions above define, realize, evaluate, and normalize.</tspan></text>
  </g>
</svg>

<style>
  .loopd {
    display: block;
    width: 100%;
    height: auto;
    margin-top: 1.75rem;
    font-family: var(--font-mono);
  }
  .loopd rect {
    fill: var(--bg-soft);
    stroke: var(--line-strong);
  }
  .loopd-actor rect {
    stroke-dasharray: 5 4;
  }
  .loopd-actor text {
    fill: var(--ink-soft);
    font-size: 13px;
    font-weight: 600;
  }
  .loopd-ic {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .loopd-dash line {
    stroke: var(--accent);
    stroke-dasharray: 4 5;
    opacity: 0.55;
  }
  .loopd-fn-name {
    fill: var(--accent);
    font-size: 13.5px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .loopd-fn-body {
    fill: var(--ink-soft);
    font-size: 12.5px;
  }
  .loopd-flow line,
  .loopd-flow-line {
    stroke: var(--accent);
    stroke-width: 1.5;
  }
  .loopd-arrhead {
    fill: var(--accent);
  }
  .loopd-edge {
    fill: var(--muted);
    font-size: 11px;
  }
  .loopd-comp rect {
    fill: rgba(255, 255, 255, 0.03);
    stroke: var(--line-strong);
  }
  .loopd-comp text {
    fill: var(--ink-soft);
    font-size: 13px;
    font-weight: 600;
  }
  .loopd-plane rect {
    fill: var(--accent-soft);
    stroke: rgba(45, 212, 191, 0.35);
  }
</style>
