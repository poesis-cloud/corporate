---
/**
 * SieLoopDiagram — the closed self-sustaining loop SIE runs, in the systemic
 * vocabulary (VSM-like): governance defines the state space, regulation steers
 * toward it, operation produces the actual state, supervision evaluates it —
 * and adaptation regenerates the definitions themselves (autopoiesis).
 */
const stations = [
  { step: 'Governance', body: 'Define the state space — what the system must be, as typed, versioned, governed definitions', product: 'Definition Manager' },
  { step: 'Regulation', body: 'Steer toward the defined state — AI generation and executed Mechanisms realize the definitions', product: 'AI generation · Operator' },
  { step: 'Operation', body: 'The system runs in its state space, producing the actual state', product: 'your systems · generated artifacts' },
  { step: 'Supervision', body: 'Evaluate the actual state against the defined — observability capacities feed Norm verdicts', product: 'observability · Operator' },
];
---
<div class="loopd" role="img" aria-label="The closed loop: governance defines the state space, regulation steers toward it, operation produces the actual state, supervision evaluates it, and adaptation regenerates the definitions">
  <ol class="loopd-track">
    {stations.map((s) => (
      <li class="loopd-station">
        <span class="loopd-step">{s.step}</span>
        <span class="loopd-body">{s.body}</span>
        <span class="loopd-product">{s.product}</span>
      </li>
    ))}
  </ol>
  <div class="loopd-return" aria-hidden="true">
    <span class="loopd-return-arrow">⟲</span>
    <span><strong>Adaptation</strong> — verdicts and evidence-backed contributions regenerate the definitions themselves: AI generation proposes, the Definition Blackboard qualifies, governance disposes. The organization re-produces itself — autopoiesis.</span>
  </div>
  <p class="loopd-note text-small">
    Each pass rewrites the definitions it started from, so the loop never closes on the same point — a spiral, not a circle. Kubernetes runs the same shape on infrastructure — <code>spec</code> → controllers → <code>status</code> → reconcile — SIE generalizes it to any governed system.
  </p>
</div>

<style>
  .loopd {
    margin-top: 1.75rem;
  }
  .loopd-track {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.75rem;
    margin: 0;
    padding: 0;
  }
  .loopd-station {
    position: relative;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--bg-soft);
    padding: 1.1rem 1.2rem;
  }
  .loopd-station:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -1.35rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent);
    font-size: 1.1rem;
  }
  .loopd-step {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .loopd-body {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.9rem;
    color: var(--ink-soft);
    line-height: 1.45;
  }
  .loopd-product {
    display: block;
    margin-top: 0.65rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--muted);
  }
  .loopd-return {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-top: 1.1rem;
    padding: 0.65rem 1.1rem;
    border: 1px dashed var(--line-strong);
    border-radius: 999px;
    color: var(--ink-soft);
    font-size: 0.85rem;
  }
  .loopd-return-arrow {
    color: var(--accent);
    font-size: 1.15rem;
    line-height: 1;
  }
  .loopd-note {
    margin-top: 1.1rem;
    color: var(--muted);
  }
  @media (max-width: 900px) {
    .loopd-track {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .loopd-station:not(:last-child)::after {
      content: '↓';
      right: auto;
      left: 50%;
      top: auto;
      bottom: -1.6rem;
      transform: translateX(-50%);
    }
  }
</style>
