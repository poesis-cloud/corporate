---
import Icon from './Icon.astro';
import { poesisPortfolio } from '../data/poesis-portfolio.ts';
import { services } from '../data/services.ts';
import { domains } from '../data/domains.ts';

const community = [
  { href: 'https://github.com/poesis-cloud', label: 'GitHub repos' },
  { href: 'https://github.com/orgs/poesis-cloud/discussions', label: 'GitHub discussions' },
  { href: 'https://www.linkedin.com/company/poesis-cloud', label: 'LinkedIn' },
];

const insights = [
  { href: '/insights/research', label: 'Research' },
];
---
<header class="site-header">
  <div class="container nav">
    <a class="brand" href="/">
      <img class="brand-mark" src="/poesis-logo.png" alt="" width="26" height="26" />
      Poesis
    </a>
    <button
      class="nav-toggle"
      type="button"
      aria-controls="primary-navigation"
      aria-expanded="false"
      aria-label="Open primary menu"
      hidden
    >
      <span class="nav-toggle-icon" aria-hidden="true"></span>
      <span>Menu</span>
    </button>
    <nav class="nav-links" id="primary-navigation" aria-label="Primary">
      <div class="nav-dropdown">
        <button class="nav-dropdown-trigger" aria-haspopup="true" aria-expanded="false">
          Domains <span aria-hidden="true">▾</span>
        </button>
        <ul class="nav-dropdown-menu" role="menu">
          {domains.map((d) => (
            d.subitems ? (
              <li class="nav-subgroup" role="none">
                <div class="nav-subgroup-row">
                  <a href={d.href} role="menuitem">{d.label}</a>
                  <button class="nav-subgroup-toggle" type="button" aria-expanded="false" aria-label={`Show ${d.name} pages`}>
                    <span aria-hidden="true">▸</span>
                  </button>
                </div>
                <ul class="nav-submenu" role="menu">
                  {d.subitems.map((item) => (
                    <li role="none">
                      <a href={item.href} role="menuitem">{item.label}</a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li role="none">
                <a href={d.href} role="menuitem">{d.label}</a>
              </li>
            )
          ))}
        </ul>
      </div>
      <div class="nav-dropdown">
        <button class="nav-dropdown-trigger" aria-haspopup="true" aria-expanded="false">
          Solutions <span aria-hidden="true">▾</span>
        </button>
        <ul class="nav-dropdown-menu" role="menu">
          {poesisPortfolio.map((s) => (
            <li class="nav-subgroup" role="none">
              <div class="nav-subgroup-row">
                <a href={s.href} role="menuitem">{s.fullName}</a>
                <button class="nav-subgroup-toggle" type="button" aria-expanded="false" aria-label={`Show ${s.name} products`}>
                  <span aria-hidden="true">▸</span>
                </button>
              </div>
              <ul class="nav-submenu" role="menu">
                {s.products.map((p) => (
                  <li role="none">
                    <a href={`${s.href}/products/${p.slug}`} role="menuitem">{p.name}</a>
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ul>
      </div>
      <div class="nav-dropdown">
        <button class="nav-dropdown-trigger" aria-haspopup="true" aria-expanded="false">
          Services <span aria-hidden="true">▾</span>
        </button>
        <ul class="nav-dropdown-menu" role="menu">
          {services.map((service) => (
            <li role="none">
              <a href={service.href} role="menuitem">{service.label}</a>
            </li>
          ))}
        </ul>
      </div>
      <div class="nav-dropdown">
        <button class="nav-dropdown-trigger" aria-haspopup="true" aria-expanded="false">
          Partnerships <span aria-hidden="true">▾</span>
        </button>
        <ul class="nav-dropdown-menu" role="menu">
          <li role="none">
            <a href="/partnerships/llm-vendor-value-proposal" role="menuitem">LLM Vendor Partnership — Value Proposal</a>
          </li>
        </ul>
      </div>
      <div class="nav-dropdown">
        <button class="nav-dropdown-trigger" aria-haspopup="true" aria-expanded="false">
          Insights <span aria-hidden="true">▾</span>
        </button>
        <ul class="nav-dropdown-menu" role="menu">
          {insights.map((item) => (
            <li role="none">
              <a href={item.href} role="menuitem">{item.label}</a>
            </li>
          ))}
        </ul>
      </div>
      <div class="nav-dropdown">
        <button class="nav-dropdown-trigger" aria-haspopup="true" aria-expanded="false">
          Docs <span aria-hidden="true">▾</span>
        </button>
        <ul class="nav-dropdown-menu" role="menu">
          <li role="none"><a href="https://docs.poesis.cloud" role="menuitem">Poesis documentation</a></li>
          <li role="none"><a href="https://docs.poesis.cloud/gsm/" role="menuitem">GSM documentation</a></li>
          <li role="none"><a href="https://docs.poesis.cloud/itip/" role="menuitem">ITIP documentation</a></li>
          <li role="none"><a href="https://docs.poesis.cloud/sie/" role="menuitem">SIE documentation</a></li>
          <li role="none"><a href="https://docs.poesis.cloud/saf/" role="menuitem">SAF documentation</a></li>
        </ul>
      </div>
      <div class="nav-dropdown">
        <button class="nav-dropdown-trigger" aria-haspopup="true" aria-expanded="false">
          Community <span aria-hidden="true">▾</span>
        </button>
        <ul class="nav-dropdown-menu" role="menu">
          {community.map((item) => (
            <li role="none">
              <a href={item.href} role="menuitem" target="_blank" rel="noopener">{item.label}</a>
            </li>
          ))}
        </ul>
      </div>
      <div class="nav-dropdown nav-dropdown--search">
        <button class="nav-dropdown-trigger nav-dropdown-trigger--icon" aria-haspopup="true" aria-expanded="false" aria-label="Search">
          <Icon name="search" size={18} />
          <span class="sr-only">Search</span>
        </button>
        <div class="nav-dropdown-menu nav-dropdown-menu--search" role="dialog" aria-label="Site search">
          <div class="search-box" id="nav-search" role="search"></div>
        </div>
      </div>
      <a class="btn btn-ghost btn-sm" href="/about">About</a>
      <a class="btn btn-primary btn-sm" href="/contact">Talk to us</a>
    </nav>
  </div>
</header>

<script type="module">
  document.addEventListener('DOMContentLoaded', () => {
    const compactMenuQuery = window.matchMedia('(max-width: 1023px)');
    const header = document.querySelector('.site-header');
    const nav = document.getElementById('primary-navigation');
    const menuToggle = document.querySelector('.nav-toggle');
    const dropdowns = [...document.querySelectorAll('.nav-dropdown')];

    const closeDropdowns = () => {
      dropdowns.forEach((dropdown) => {
        dropdown.classList.remove('open');
        dropdown.querySelector('.nav-dropdown-trigger')?.setAttribute('aria-expanded', 'false');
      });
    };

    const setMenuOpen = (isOpen, restoreFocus = false) => {
      if (!header || !nav || !menuToggle) return;
      const nextOpen = compactMenuQuery.matches && isOpen;
      const focusIsInNav = nav.contains(document.activeElement);
      header.classList.toggle('menu-open', nextOpen);
      menuToggle.setAttribute('aria-expanded', String(nextOpen));
      menuToggle.setAttribute('aria-label', `${nextOpen ? 'Close' : 'Open'} primary menu`);
      nav.setAttribute('aria-hidden', String(!nextOpen && compactMenuQuery.matches));
      if (compactMenuQuery.matches && !nextOpen) closeDropdowns();
      if ((restoreFocus || focusIsInNav) && compactMenuQuery.matches && !nextOpen) menuToggle.focus();
    };

    const syncCompactMenu = () => {
      if (!nav || !menuToggle) return;
      menuToggle.hidden = !compactMenuQuery.matches;
      setMenuOpen(false);
      if (!compactMenuQuery.matches) {
        nav.removeAttribute('aria-hidden');
        closeDropdowns();
      }
    };

    header?.classList.add('nav-ready');
    menuToggle?.addEventListener('click', () => {
      setMenuOpen(menuToggle.getAttribute('aria-expanded') !== 'true');
    });

    async function initSearch() {
      const target = document.getElementById('nav-search');
      if (!target || typeof window === 'undefined') return;

      const loadScript = (src) => new Promise((resolve, reject) => {
        const s = document.createElement('script');
        s.src = src;
        s.async = true;
        s.onload = resolve;
        s.onerror = reject;
        document.head.appendChild(s);
      });

      try {
        await loadScript('/pagefind/pagefind-ui.js');
        if (!window.PagefindUI) throw new Error('PagefindUI not loaded');
        new window.PagefindUI({
          element: '#nav-search',
          showImages: false,
          showSubResults: false,
          resetStyles: false,
          autofocus: true,
          processResult: (result) => {
            const type = result.meta?.type || 'Page';
            result.meta.title = `[${type}] ${result.meta.title}`;
            result.meta.image = '';
            return result;
          },
          translations: {
            placeholder: 'Search poesis.cloud...',
            zero_results: 'No results',
            many_results: '[COUNT] results',
            one_result: '1 result',
          },
        });
      } catch (err) {
        target.innerHTML = '<p class="search-error">Search unavailable.</p>';
        // eslint-disable-next-line no-console
        console.error('Pagefind failed to load', err);
      }
    }

    initSearch();

    document.querySelectorAll('.nav-dropdown').forEach((dropdown) => {
      const trigger = dropdown.querySelector('.nav-dropdown-trigger');
      if (!trigger) return;
      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        if (!compactMenuQuery.matches) return;
        dropdowns.filter((candidate) => candidate !== dropdown).forEach((candidate) => {
          candidate.classList.remove('open');
          candidate.querySelector('.nav-dropdown-trigger')?.setAttribute('aria-expanded', 'false');
        });
        const isOpen = dropdown.classList.toggle('open');
        trigger.setAttribute('aria-expanded', String(isOpen));
      });
    });

    document.querySelectorAll('.nav-subgroup-toggle').forEach((toggle) => {
      toggle.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const group = toggle.closest('.nav-subgroup');
        if (!group) return;
        const isOpen = group.classList.toggle('open');
        toggle.setAttribute('aria-expanded', String(isOpen));
      });
    });

    nav?.addEventListener('click', (event) => {
      if (compactMenuQuery.matches && event.target instanceof Element && event.target.closest('a')) setMenuOpen(false);
    });

    document.addEventListener('click', (event) => {
      if (header && !header.contains(event.target)) setMenuOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      const wasOpen = menuToggle?.getAttribute('aria-expanded') === 'true';
      setMenuOpen(false, wasOpen);
    });

    compactMenuQuery.addEventListener('change', syncCompactMenu);
    syncCompactMenu();
  });
</script>

