---
/**
 * ArchMap — the Poesis portfolio rendered as an interactive architecture map.
 * Nesting: Solution boxes > Product boxes > Feature chips.
 * Every box is clickable: solution → /solutions/[solution],
 * product → /solutions/[solution]/products/[product],
 * feature → /solutions/[solution]/products/[product]#[feature].
 */
import { solutions } from '../data/solutions.ts';
import { roadmapFor, featureStatus } from '../data/roadmap.ts';

const stack = solutions.filter((s) => s.slug !== 'saf');
const framework = solutions.find((s) => s.slug === 'saf')!;
---
<div class="arch" aria-label="Poesis portfolio — solutions, products, and features architecture map">
  <div class="arch-legend" aria-hidden="true">
    <span>poesis portfolio · solutions ⊃ products ⊃ features</span>
    <span>every box is clickable</span>
  </div>

  <div class="arch-grid">
    <div class="arch-stack">
        {stack.map((s, i) => (
          <>            {i > 0 && <div class="arch-joint" aria-hidden="true"><span>{i === 1 ? 'built on · powered by' : 'implements'}</span></div>}
            <article class="arch-scope arch-scope--standard">
              <div class="arch-scope-meta">
                <span class="tag">{s.tag} · Solution</span>
              </div>
              <h3><a href={s.href}>{s.name}</a></h3>
              <p>{s.tagline}</p>
              <details class="arch-group" open>
                <summary>Products</summary>
                <div class="arch-products">
                  {s.products.map((p) => {
                    const roadmap = roadmapFor(s.slug, p.slug);
                    return (
                    <section class="arch-product">
                      <h4>
                        <a href={`${s.href}/products/${p.slug}`}>{p.name}</a>
                        {roadmap && <span class="arch-version">v{roadmap.current}</span>}
                      </h4>
                      <p class="arch-product-tagline">{p.tagline}</p>
                      <details class="arch-group arch-group--features">
                        <summary>Features</summary>
                        <nav class="arch-comps" aria-label={`${p.name} features`}>
                          {p.features.map((f) => {
                            const status = featureStatus(roadmap, f.slug);
                            return (
                              <a class="arch-comp" href={`${s.href}/products/${p.slug}#${f.slug}`}>
                                {f.name}
                                {status && (
                                  <span class="arch-comp-version" title={status.shipped ? `Shipped in v${status.version}` : `Planned for v${status.version}`}>
                                    {status.shipped ? '✓' : `v${status.version}`}
                                  </span>
                                )}
                              </a>
                            );
                          })}
                        </nav>
                      </details>
                    </section>
                    );
                  })}
                </div>
              </details>
            </article>
          </>
        ))}
    </div>

    <div class="arch-bridge" aria-hidden="true"><span>definitions ⇄ generated artifacts</span></div>

    <aside class="arch-side">
          <article class="arch-scope arch-scope--framework">
            <div class="arch-scope-meta">
              <span class="tag tag--accent-3">{framework.tag} · Solution</span>
            </div>
            <h3><a href={framework.href}>{framework.name}</a></h3>
            <p>{framework.tagline}</p>
            <details class="arch-group" open>
              <summary>Products</summary>
              <div class="arch-products">
                {framework.products.map((p) => {
                  const roadmap = roadmapFor(framework.slug, p.slug);
                  return (
                  <section class="arch-product">
                    <h4>
                      <a href={`${framework.href}/products/${p.slug}`}>{p.name}</a>
                      {roadmap && <span class="arch-version">v{roadmap.current}</span>}
                    </h4>
                    <p class="arch-product-tagline">{p.tagline}</p>
                    <details class="arch-group arch-group--features">
                      <summary>Features</summary>
                      <nav class="arch-comps" aria-label={`${p.name} features`}>
                        {p.features.map((f) => {
                          const status = featureStatus(roadmap, f.slug);
                          return (
                            <a class="arch-comp" href={`${framework.href}/products/${p.slug}#${f.slug}`}>
                              {f.name}
                              {status && (
                                <span class="arch-comp-version" title={status.shipped ? `Shipped in v${status.version}` : `Planned for v${status.version}`}>
                                  {status.shipped ? '✓' : `v${status.version}`}
                                </span>
                              )}
                            </a>
                          );
                        })}
                      </nav>
                    </details>
                  </section>
                  );
                })}
              </div>
            </details>
          </article>
        </aside>
  </div>
</div>

<style>
  .arch-version {
    margin-left: 0.45rem;
    font-size: 0.72rem;
    font-weight: 600;
    opacity: 0.55;
    white-space: nowrap;
    text-transform: none;
  }
  .arch-comp-version {
    margin-left: 0.35rem;
    font-size: 0.68rem;
    opacity: 0.55;
    white-space: nowrap;
    text-transform: none;
  }
</style>
