---
/**
 * ArchMap — the Poesis portfolio rendered as an interactive architecture map.
 * Nesting: Solution boxes > Product boxes > Feature chips.
 * Every box is clickable: solution → /solutions/[solution],
 * product → /solutions/[solution]/products/[product],
 * feature → /solutions/[solution]/products/[product]#[feature].
 * A solution's capabilities link to their anchor on the solution page.
 */
import { platformSolutions, productTimeline, featureStatus, capabilityStatus, plannedClass, solutionHref, typeIcons, affordances, affordanceStatus } from '../data/poesis-platform.ts';
import { solutionQualities, productQualities, platformQualities, qualityHref } from '../data/qualities.ts';
import DeliveryStatus from './DeliveryStatus.astro';
import ProductRoadmapMini from './ProductRoadmapMini.astro';
import Icon from './Icon.astro';

const stack = platformSolutions.filter((s) => s.slug !== 'saf');
const framework = platformSolutions.find((s) => s.slug === 'saf')!;
const frameworkHref = solutionHref(framework);
---
<div class="arch" aria-label="Poesis Platform — affordances, qualities, solutions, products, capabilities, and features architecture map">
  <div class="arch-legend" aria-hidden="true">
    <span>Poesis Platform Map · platform ⊃ solutions ⊃ products ⊃ features</span>
    <span>Scoped claims · historical milestones shown separately</span>
  </div>

  <div class="arch-platform">
    <article class="arch-scope arch-scope--platform" aria-labelledby="arch-platform-heading">
      <div class="arch-scope-meta">
        <span class="arch-icon"><Icon name="layers" size={16} /></span>
        <span class="tag tag--accent-2">Platform</span>
      </div>
      <h3 id="arch-platform-heading"><a href="/">Poesis Platform</a></h3>
      <p>The cross-solution capstone: affordances realized by contributing capabilities across every solution, and the qualities the platform bears as a whole.</p>
      <details class="arch-group">
        <summary>Affordances</summary>
        <nav class="arch-comps" aria-label="Platform affordances">
          {affordances.map((a) => (
            <a class:list={['arch-comp', plannedClass(affordanceStatus(a))]} href={`/#affordance-${a.slug}`}>{a.name} <DeliveryStatus state={affordanceStatus(a)} /></a>
          ))}
        </nav>
      </details>
      {platformQualities.length > 0 && (
        <details class="arch-group">
          <summary>Qualities</summary>
          <nav class="arch-comps" aria-label="Platform qualities">
            {platformQualities.map((q) => (
              <a class="arch-comp" href={qualityHref(q)}>{q.name} {q.state && <DeliveryStatus state={q.state} />}</a>
            ))}
          </nav>
        </details>
      )}
      <details class="arch-group arch-group--solutions" open>
        <summary>Solutions</summary>
        <div class="arch-grid">
          <div class="arch-stack">
        {stack.map((s, i) => (
          <>            {i > 0 && <div class="arch-joint" aria-hidden="true"><span>{i === 1 ? 'planned integration' : 'specification contract'}</span></div>}
            <article class="arch-scope arch-scope--standard" aria-labelledby={`arch-solution-${s.slug}`}>
              <div class="arch-scope-meta">
                <span class="arch-icon"><Icon name={typeIcons.solution} size={16} /></span>
                <span class="tag">{s.tags.join(' · ')} · Solution</span>
              </div>
              <h3 id={`arch-solution-${s.slug}`}><a href={solutionHref(s)}>{s.name}</a></h3>
              <p>{s.excerpt}</p>
              <details class="arch-group">
                <summary>Capabilities</summary>
                <nav class="arch-comps" aria-label={`${s.name} capabilities`}>
                  {s.capabilities.map((c) => (
                    <a class:list={['arch-comp', plannedClass(capabilityStatus(s, c))]} href={`${solutionHref(s)}#${c.slug}`}>{c.name} <DeliveryStatus state={capabilityStatus(s, c)} /></a>
                  ))}
                </nav>
              </details>
              {solutionQualities(s.slug).length > 0 && (
                <details class="arch-group">
                  <summary>Qualities</summary>
                  <nav class="arch-comps" aria-label={`${s.name} qualities`}>
                    {solutionQualities(s.slug).map((q) => (
                      <a class="arch-comp" href={qualityHref(q)}>{q.name} {q.state && <DeliveryStatus state={q.state} />}</a>
                    ))}
                  </nav>
                </details>
              )}
              <details class="arch-group">
                <summary>Products</summary>
                <div class="arch-products">
                  {s.products.map((p) => {
                    return (
                    <section class="arch-product" aria-labelledby={`arch-product-${s.slug}-${p.slug}`}>
                      <span class="arch-version">Current v{p.currentVersion}</span>
                      <h4 id={`arch-product-${s.slug}-${p.slug}`}>
                        <a href={`${solutionHref(s)}/products/${p.slug}`}>{p.name}</a>
                      </h4>
                      <p class="arch-product-tagline">{p.excerpt}</p>
                      <ProductRoadmapMini product={p.name} features={p.features} milestones={productTimeline(p)} />
                      <details class="arch-group arch-group--features">
                        <summary>Features</summary>
                        <nav class="arch-comps" aria-label={`${p.name} features`}>
                          {p.features.map((f) => {
                            const status = featureStatus(f);
                            return (
                              <a class:list={['arch-comp', plannedClass(status.state)]} href={`${solutionHref(s)}/products/${p.slug}#${f.slug}`}>
                                {f.name}
                                <span class="arch-comp-version" title={`Historical milestone v${status.version}`}>
                                  <DeliveryStatus state={status.state} />
                                </span>
                              </a>
                            );
                          })}
                        </nav>
                      </details>
                      {productQualities(s.slug, p.slug).length > 0 && (
                        <details class="arch-group">
                          <summary>Qualities</summary>
                          <nav class="arch-comps" aria-label={`${p.name} qualities`}>
                            {productQualities(s.slug, p.slug).map((q) => (
                              <a class="arch-comp" href={qualityHref(q)}>{q.name} {q.state && <DeliveryStatus state={q.state} />}</a>
                            ))}
                          </nav>
                        </details>
                      )}
                    </section>
                    );
                  })}
                </div>
              </details>
            </article>
          </>
        ))}
          </div>

          <div class="arch-bridge" aria-hidden="true"><span>planned definition / artifact integration</span></div>

          <aside class="arch-side">
          <article class="arch-scope arch-scope--framework" aria-labelledby={`arch-solution-${framework.slug}`}>
            <div class="arch-scope-meta">
              <span class="arch-icon"><Icon name={typeIcons.solution} size={16} /></span>
              <span class="tag tag--accent-3">{framework.tags.join(' · ')} · Solution</span>
            </div>
            <h3 id={`arch-solution-${framework.slug}`}><a href={frameworkHref}>{framework.name}</a></h3>
            <p>{framework.excerpt}</p>
            <details class="arch-group">
              <summary>Capabilities</summary>
              <nav class="arch-comps" aria-label={`${framework.name} capabilities`}>
                {framework.capabilities.map((c) => (
                  <a class:list={['arch-comp', plannedClass(c.delivery.state)]} href={`${frameworkHref}#${c.slug}`}>{c.name} <DeliveryStatus state={c.delivery.state} /></a>
                ))}
              </nav>
            </details>
            {solutionQualities(framework.slug).length > 0 && (
              <details class="arch-group">
                <summary>Qualities</summary>
                <nav class="arch-comps" aria-label={`${framework.name} qualities`}>
                  {solutionQualities(framework.slug).map((q) => (
                    <a class="arch-comp" href={qualityHref(q)}>{q.name} {q.state && <DeliveryStatus state={q.state} />}</a>
                  ))}
                </nav>
              </details>
            )}
            <details class="arch-group">
              <summary>Products</summary>
              <div class="arch-products">
                {framework.products.map((p) => {
                  return (
                  <section class="arch-product" aria-labelledby={`arch-product-${framework.slug}-${p.slug}`}>
                    <span class="arch-version">Current v{p.currentVersion}</span>
                    <h4 id={`arch-product-${framework.slug}-${p.slug}`}>
                      <a href={`${frameworkHref}/products/${p.slug}`}>{p.name}</a>
                    </h4>
                    <p class="arch-product-tagline">{p.excerpt}</p>
                    <ProductRoadmapMini product={p.name} features={p.features} milestones={productTimeline(p)} />
                    <details class="arch-group arch-group--features">
                      <summary>Features</summary>
                      <nav class="arch-comps" aria-label={`${p.name} features`}>
                        {p.features.map((f) => {
                          const status = featureStatus(f);
                          return (
                            <a class:list={['arch-comp', plannedClass(status.state)]} href={`${frameworkHref}/products/${p.slug}#${f.slug}`}>
                              {f.name}
                              <span class="arch-comp-version" title={`Historical milestone v${status.version}`}>
                                <DeliveryStatus state={status.state} />
                              </span>
                            </a>
                          );
                        })}
                      </nav>
                    </details>
                    {productQualities(framework.slug, p.slug).length > 0 && (
                      <details class="arch-group">
                        <summary>Qualities</summary>
                        <nav class="arch-comps" aria-label={`${p.name} qualities`}>
                          {productQualities(framework.slug, p.slug).map((q) => (
                            <a class="arch-comp" href={qualityHref(q)}>{q.name} {q.state && <DeliveryStatus state={q.state} />}</a>
                          ))}
                        </nav>
                      </details>
                    )}
                  </section>
                  );
                })}
              </div>
            </details>
          </article>
          </aside>
        </div>
      </details>
    </article>
  </div>

  <p class="arch-note">
    <span class="arch-note__label">Version convention</span>
    Product versions shown are current, not historical milestones.
    <DeliveryStatus state="delivered" /> and <DeliveryStatus state="planned" /> describe feature, capability and affordance scope, not hosted availability or certification.
  </p>
</div>

<style>
  .arch-scope>.arch-group+.arch-group {
    margin-top: .7rem;
  }
  .arch-icon {
    display: grid;
    flex: none;
    width: 1.6rem;
    height: 1.6rem;
    place-items: center;
    border: 1px solid rgba(45, 212, 191, .35);
    color: var(--accent);
  }
  .arch-scope--framework .arch-icon {
    border-color: rgba(129, 140, 248, .35);
    color: var(--accent-3);
  }
  .arch-version,
  .arch-comp-version {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--accent);
    white-space: normal;
  }
  .arch-version {
    display: block;
    margin-bottom: .4rem;
  }
  .arch-comp-version {
    margin-left: 0.45rem;
  }
  .arch-scope--framework .arch-version,
  .arch-scope--framework .arch-comp-version {
    color: var(--accent-3);
  }
</style>
