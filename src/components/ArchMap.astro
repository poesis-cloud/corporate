---
/**
 * ArchMap — the Poesis portfolio rendered as an interactive architecture map.
 * Nesting: Portfolio frame > Solution boxes > Product boxes > Feature chips.
 * Every box is clickable: solution → /[solution], product → /[solution]/[product],
 * feature → /[solution]/[product]#[feature].
 */
import { solutions } from '../data/solutions.ts';

const think = solutions.filter((s) => s.zone === 'THINK');
const build = solutions.filter((s) => s.zone === 'BUILD');
---
<div class="arch" aria-label="Poesis portfolio — solutions, products, and features architecture map">
  <div class="arch-legend" aria-hidden="true">
    <span>poesis portfolio · solutions ⊃ products ⊃ features</span>
    <span>every box is clickable</span>
  </div>

  <div class="arch-grid">
    <div class="arch-stack">
      {think.map((s, i) => (
        <>
          {i > 0 && <div class="arch-joint" aria-hidden="true"><span>{i === 1 ? 'built on · powered by' : 'implements'}</span></div>}
          <article class={`arch-scope${s.slug === 'gsm' ? ' arch-scope--standard' : ''}`}>
            <div class="arch-scope-meta">
              <span class={`tag${s.slug === 'gsm' ? '' : ' tag--muted'}`}>{s.tag} · Solution</span>
              <span class="arch-zone">{s.zoneLabel}</span>
            </div>
            <h3><a href={s.href}>{s.name}</a></h3>
            <p>{s.tagline}</p>
            <div class="arch-products">
              {s.products.map((p) => (
                <section class="arch-product">
                  <h4><a href={`${s.href}/${p.slug}`}>{p.name}</a></h4>
                  <nav class="arch-comps" aria-label={`${p.name} features`}>
                    {p.features.map((f) => (
                      <a class="arch-comp" href={`${s.href}/${p.slug}#${f.slug}`}>{f.name}</a>
                    ))}
                  </nav>
                </section>
              ))}
            </div>
          </article>
        </>
      ))}
    </div>

    <div class="arch-bridge" aria-hidden="true"><span>definitions ⇄ build artifacts</span></div>

    <aside class="arch-side">
      {build.map((s) => (
        <article class="arch-scope arch-scope--framework">
          <div class="arch-scope-meta">
            <span class="tag tag--muted">{s.tag} · Solution</span>
            <span class="arch-zone">{s.zoneLabel}</span>
          </div>
          <h3><a href={s.href}>{s.name}</a></h3>
          <p>{s.tagline}</p>
          <div class="arch-products">
            {s.products.map((p) => (
              <section class="arch-product">
                <h4><a href={`${s.href}/${p.slug}`}>{p.name}</a></h4>
                <nav class="arch-comps" aria-label={`${p.name} features`}>
                  {p.features.map((f) => (
                    <a class="arch-comp" href={`${s.href}/${p.slug}#${f.slug}`}>{f.name}</a>
                  ))}
                </nav>
              </section>
            ))}
          </div>
        </article>
      ))}
    </aside>
  </div>

  <div class="arch-joint" aria-hidden="true"><span>enforces · observes</span></div>

  <div class="arch-run">
    <span class="arch-zone arch-zone--run">RUN</span>
    <p>Your IT landscape — deployed from generated artifacts, enforced by the <a href="/sie/operator">Operator</a>, observed back as evidence into the definitions.</p>
  </div>
</div>
