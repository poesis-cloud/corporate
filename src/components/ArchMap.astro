---
/**
 * ArchMap — the Poesis portfolio rendered as an interactive architecture map.
 * Nesting: Solution boxes > Product boxes > Feature chips.
 * Every box is clickable: solution → /solutions/[solution],
 * product → /solutions/[solution]/products/[product],
 * feature → /solutions/[solution]/products/[product]#[feature].
 * A solution's capabilities link to their anchor on the solution page.
 */
import { poesisPortfolio, productTimeline, featureStatus, productShipped, capabilityShipped, typeIcons } from '../data/poesis-portfolio.ts';
import ProductRoadmapMini from './ProductRoadmapMini.astro';
import Icon from './Icon.astro';

const stack = poesisPortfolio.filter((s) => s.slug !== 'saf');
const framework = poesisPortfolio.find((s) => s.slug === 'saf')!;
---
<div class="arch" aria-label="Poesis portfolio — solutions, products, and features architecture map">
  <div class="arch-legend" aria-hidden="true">
    <span>Poesis Platform Map · solutions ⊃ products ⊃ features</span>
    <span>every box is clickable · <em class="is-planned">amber = not shipped yet</em></span>
  </div>

  <div class="arch-grid">
    <div class="arch-stack">
        {stack.map((s, i) => (
          <>            {i > 0 && <div class="arch-joint" aria-hidden="true"><span>{i === 1 ? 'built on · powered by' : 'implements'}</span></div>}
            <article class="arch-scope arch-scope--standard" aria-labelledby={`arch-solution-${s.slug}`}>
              <div class="arch-scope-meta">
                <span class="arch-icon"><Icon name={typeIcons.solution} size={16} /></span>
                <span class="tag">{s.tag} · Solution</span>
              </div>
              <h3 id={`arch-solution-${s.slug}`}><a href={s.href}>{s.name}</a></h3>
              <p>{s.excerpt}</p>
              <details class="arch-group">
                <summary>Capabilities</summary>
                <nav class="arch-comps" aria-label={`${s.name} capabilities`}>
                  {s.capabilities.map((c) => (
                    <a class:list={['arch-comp', !capabilityShipped(s, c) && 'is-planned']} href={`${s.href}#${c.slug}`}>{c.name}</a>
                  ))}
                </nav>
              </details>
              <details class="arch-group">
                <summary>Products</summary>
                <div class="arch-products">
                  {s.products.map((p) => {
                    return (
                    <section class:list={['arch-product', !productShipped(p) && 'is-planned']} aria-labelledby={`arch-product-${s.slug}-${p.slug}`}>
                      <span class="arch-version">current v{p.currentVersion}</span>
                      <h4 id={`arch-product-${s.slug}-${p.slug}`}>
                        <a href={`${s.href}/products/${p.slug}`}>{p.name}</a>
                      </h4>
                      <p class="arch-product-tagline">{p.excerpt}</p>
                      <ProductRoadmapMini product={p.name} milestones={productTimeline(p)} />
                      <details class="arch-group arch-group--features">
                        <summary>Features</summary>
                        <nav class="arch-comps" aria-label={`${p.name} features`}>
                          {p.features.map((f) => {
                            const status = featureStatus(f);
                            return (
                              <a class:list={['arch-comp', !status.shipped && 'is-planned']} href={`${s.href}/products/${p.slug}#${f.slug}`}>
                                {f.name}
                                <span class="arch-comp-version" title={status.shipped ? `Shipped in v${status.version}` : `Planned for v${status.version}`}>
                                  {status.shipped ? '✓' : `v${status.version}`}
                                </span>
                              </a>
                            );
                          })}
                        </nav>
                      </details>
                    </section>
                    );
                  })}
                </div>
              </details>
            </article>
          </>
        ))}
    </div>

    <div class="arch-bridge" aria-hidden="true"><span>definitions ⇄ generated artifacts</span></div>

    <aside class="arch-side">
          <article class="arch-scope arch-scope--framework" aria-labelledby={`arch-solution-${framework.slug}`}>
            <div class="arch-scope-meta">
              <span class="arch-icon"><Icon name={typeIcons.solution} size={16} /></span>
              <span class="tag tag--accent-3">{framework.tag} · Solution</span>
            </div>
            <h3 id={`arch-solution-${framework.slug}`}><a href={framework.href}>{framework.name}</a></h3>
            <p>{framework.excerpt}</p>
            <details class="arch-group">
              <summary>Capabilities</summary>
              <nav class="arch-comps" aria-label={`${framework.name} capabilities`}>
                {framework.capabilities.map((c) => (
                  <a class:list={['arch-comp', !capabilityShipped(framework, c) && 'is-planned']} href={`${framework.href}#${c.slug}`}>{c.name}</a>
                ))}
              </nav>
            </details>
            <details class="arch-group">
              <summary>Products</summary>
              <div class="arch-products">
                {framework.products.map((p) => {
                  return (
                  <section class:list={['arch-product', !productShipped(p) && 'is-planned']} aria-labelledby={`arch-product-${framework.slug}-${p.slug}`}>
                    <span class="arch-version">current v{p.currentVersion}</span>
                    <h4 id={`arch-product-${framework.slug}-${p.slug}`}>
                      <a href={`${framework.href}/products/${p.slug}`}>{p.name}</a>
                    </h4>
                    <p class="arch-product-tagline">{p.excerpt}</p>
                    <ProductRoadmapMini product={p.name} milestones={productTimeline(p)} />
                    <details class="arch-group arch-group--features">
                      <summary>Features</summary>
                      <nav class="arch-comps" aria-label={`${p.name} features`}>
                        {p.features.map((f) => {
                          const status = featureStatus(f);
                          return (
                            <a class:list={['arch-comp', !status.shipped && 'is-planned']} href={`${framework.href}/products/${p.slug}#${f.slug}`}>
                              {f.name}
                              <span class="arch-comp-version" title={status.shipped ? `Shipped in v${status.version}` : `Planned for v${status.version}`}>
                                {status.shipped ? '✓' : `v${status.version}`}
                              </span>
                            </a>
                          );
                        })}
                      </nav>
                    </details>
                  </section>
                  );
                })}
              </div>
            </details>
          </article>
        </aside>
  </div>

  <p class="arch-note">
    <span class="arch-note__label">Version convention</span>
    Anything below <strong>v1.0</strong> is a pre-release development line, not a
    shipped product: it is visible here so the roadmap is honest, but it is not
    available to clients. <strong>v1.0</strong> is the first version you can use.
  </p>
</div>

<style>
  .arch-scope>.arch-group+.arch-group {
    margin-top: .7rem;
  }
  .arch-icon {
    display: grid;
    flex: none;
    width: 1.6rem;
    height: 1.6rem;
    place-items: center;
    border: 1px solid rgba(45, 212, 191, .35);
    color: var(--accent);
  }
  .arch-scope--framework .arch-icon {
    border-color: rgba(129, 140, 248, .35);
    color: var(--accent-3);
  }
  .arch-version,
  .arch-comp-version {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    white-space: nowrap;
  }
  .arch-version {
    display: block;
    margin-bottom: .4rem;
  }
  .arch-comp-version {
    margin-left: 0.45rem;
  }
  .arch-scope--framework .arch-version,
  .arch-scope--framework .arch-comp-version {
    color: var(--accent-3);
  }
</style>
