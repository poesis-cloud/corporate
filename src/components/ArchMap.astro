---
/**
 * ArchMap — the Poesis portfolio rendered as an interactive architecture map.
 * Nesting: Solution boxes > Product boxes > Feature chips.
 * Every box is clickable: solution → /solutions/[solution],
 * product → /solutions/[solution]/products/[product],
 * feature → /solutions/[solution]/products/[product]#[feature].
 */
import { solutions } from '../data/solutions.ts';

const stack = solutions.filter((s) => s.slug !== 'framework');
const framework = solutions.find((s) => s.slug === 'framework')!;
---
<div class="arch" aria-label="Poesis portfolio — solutions, products, and features architecture map">
  <div class="arch-legend" aria-hidden="true">
    <span>poesis portfolio · solutions ⊃ products ⊃ features</span>
    <span>every box is clickable</span>
  </div>

  <div class="arch-grid">
    <div class="arch-stack">
        {stack.map((s, i) => (
          <>            {i > 0 && <div class="arch-joint" aria-hidden="true"><span>{i === 1 ? 'built on · powered by' : 'implements'}</span></div>}
            <article class={`arch-scope${s.slug === 'gsm' ? ' arch-scope--standard' : ''}`}>
              <div class="arch-scope-meta">
                <span class={`tag${s.slug === 'gsm' ? '' : ' tag--muted'}`}>{s.tag} · Solution</span>
              </div>
              <h3><a href={s.href}>{s.name}</a></h3>
              <p>{s.tagline}</p>
              <details class="arch-group" open>
                <summary>Products</summary>
                <div class="arch-products">
                  {s.products.map((p) => (
                    <section class="arch-product">
                      <h4><a href={`${s.href}/products/${p.slug}`}>{p.name}</a></h4>
                      <details class="arch-group arch-group--features">
                        <summary>Features</summary>
                        <nav class="arch-comps" aria-label={`${p.name} features`}>
                          {p.features.map((f) => (
                            <a class="arch-comp" href={`${s.href}/products/${p.slug}#${f.slug}`}>{f.name}</a>
                          ))}
                        </nav>
                      </details>
                    </section>
                  ))}
                </div>
              </details>
            </article>
          </>
        ))}
    </div>

    <div class="arch-bridge" aria-hidden="true"><span>definitions ⇄ generated artifacts</span></div>

    <aside class="arch-side">
          <article class="arch-scope arch-scope--framework">
            <div class="arch-scope-meta">
              <span class="tag tag--muted">{framework.tag} · Solution</span>
            </div>
            <h3><a href={framework.href}>{framework.name}</a></h3>
            <p>{framework.tagline}</p>
            <details class="arch-group" open>
              <summary>Products</summary>
              <div class="arch-products">
                {framework.products.map((p) => (
                  <section class="arch-product">
                    <h4><a href={`${framework.href}/products/${p.slug}`}>{p.name}</a></h4>
                    <details class="arch-group arch-group--features">
                      <summary>Features</summary>
                      <nav class="arch-comps" aria-label={`${p.name} features`}>
                        {p.features.map((f) => (
                          <a class="arch-comp" href={`${framework.href}/products/${p.slug}#${f.slug}`}>{f.name}</a>
                        ))}
                      </nav>
                    </details>
                  </section>
                ))}
              </div>
            </details>
          </article>
        </aside>
  </div>
</div>
