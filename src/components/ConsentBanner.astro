---
/**
 * ConsentBanner — minimal GDPR/ePrivacy consent gate for GA4.
 *
 * The choice ('granted' | 'denied') is stored in a `poesis_consent_v1` cookie
 * scoped to the parent domain, so it is shared across poesis.cloud and
 * docs.poesis.cloud (localStorage is per-origin and would re-prompt on each).
 * This consent cookie is strictly necessary and needs no consent itself.
 * No choice yet => banner shown. 'Cookie settings' links (any element with
 * [data-cookie-settings]) reopen the banner. Bump the key to re-prompt everyone.
 */
---

<div
  id="consent-banner"
  class="consent-banner"
  role="dialog"
  aria-modal="false"
  aria-label="Cookie consent"
  aria-describedby="consent-banner-text"
  hidden
>
  <p id="consent-banner-text" class="consent-banner-text">
    We use Google Analytics to understand how the site is used. Analytics cookies
    are only set with your consent. See our
    <a href="/legal/cookies">cookie policy</a> and
    <a href="/legal/privacy">privacy policy</a>.
  </p>
  <div class="consent-banner-actions">
    <button type="button" class="btn btn-ghost btn-sm" data-consent="denied">
      Reject
    </button>
    <button type="button" class="btn btn-primary btn-sm" data-consent="granted">
      Accept
    </button>
  </div>
</div>

<script is:inline>
  (function () {
    var KEY = 'poesis_consent_v1';
    var LEGACY_KEY = 'poesis-consent-v1';

    // Registrable domain, so the apex and every subdomain share one choice.
    // (A host-only cookie on poesis.cloud would be invisible to docs.poesis.cloud.)
    function consentDomain() {
      var host = location.hostname;
      if (host.indexOf('.') === -1 || /^[0-9.]+$/.test(host)) return null;
      return '.' + host.split('.').slice(-2).join('.');
    }

    function readConsent() {
      var match = document.cookie.split(';').map(function (c) { return c.trim(); })
        .filter(function (c) { return c.indexOf(KEY + '=') === 0; })[0];
      if (match) return match.split('=')[1];
      // Migrate a pre-cookie choice made on this origin, then drop it so that
      // clearing cookies is a real reset instead of being undone by localStorage.
      try {
        var legacy = localStorage.getItem(LEGACY_KEY);
        if (legacy) {
          localStorage.removeItem(LEGACY_KEY);
          storeConsent(legacy);
          return legacy;
        }
      } catch (e) { /* ignore */ }
      return null;
    }

    function storeConsent(value) {
      var domain = consentDomain();
      var attrs = '; path=/; max-age=15552000; SameSite=Lax';
      if (location.protocol === 'https:') attrs += '; Secure';
      // Drop any host-only copy first so only the shared domain cookie remains.
      document.cookie = KEY + '=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/';
      document.cookie = KEY + '=' + value + attrs + (domain ? '; domain=' + domain : '');
    }

    function writeConsent(value, clearStale) {
      storeConsent(value);
      if (value === 'granted') {
        // On an explicit accept click, clear any stale duplicate GA cookies
        // (host-only vs parent-domain) so GA writes a single parent-scoped
        // cookie. On a stored-consent page load we skip this — the cookie is
        // already correct and clearing it would force a new client ID each visit.
        if (clearStale) deleteGACookies();
        // Load GA4 now (it is not on the page until consent is granted).
        if (typeof window.poesisLoadGA4 === 'function') window.poesisLoadGA4();
      } else {
        // Reject: ensure no GA cookie persists (defensive — GA4 isn't loaded, but
        // clear any _ga cookie that a previous version/third party may have set).
        deleteGACookies();
      }
    }

    function deleteGACookies() {
      var hosts = [location.hostname, '.' + location.hostname];
      // Also try the parent domain (e.g. .poesis.cloud) since _ga is often set there.
      var parts = location.hostname.split('.');
      if (parts.length > 2) hosts.push('.' + parts.slice(-2).join('.'));
      document.cookie.split(';').forEach(function (c) {
        var name = c.split('=')[0].trim();
        if (name === '_ga' || name.indexOf('_ga_') === 0) {
          hosts.forEach(function (h) {
            document.cookie = name + '=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/; domain=' + h;
          });
          document.cookie = name + '=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/';
        }
      });
    }

    var banner = document.getElementById('consent-banner');
    if (!banner) return;

    function show() { banner.hidden = false; }
    function hide() { banner.hidden = true; }

    banner.addEventListener('click', function (e) {
      var btn = e.target && e.target.closest ? e.target.closest('[data-consent]') : null;
      if (!btn) return;
      writeConsent(btn.getAttribute('data-consent'), /* clearStale */ true);
      hide();
    });

    document.addEventListener('click', function (e) {
      var t = e.target && e.target.closest ? e.target.closest('[data-cookie-settings]') : null;
      if (!t) return;
      e.preventDefault();
      show();
    });

    // Apply a stored choice. On 'granted' this loads GA4 (without clearing the
    // valid cookie); on 'denied' it just clears any stray GA cookie.
    var stored = readConsent();
    if (stored === 'granted') {
      writeConsent('granted');
    } else if (stored === 'denied') {
      deleteGACookies();
    } else {
      show();
    }
  })();
</script>
