---
/**
 * SolutionValueCards — the shared value list for solution pages, in the same
 * card as every other catalog item.
 */
import CatalogCard from './CatalogCard.astro';
import type { Solution } from '../data/poesis-platform.ts';
import { solutionValues } from '../data/usage.ts';
import { valueCard } from '../data/catalog-card.ts';

interface Props {
  solution: Solution;
}

const { solution } = Astro.props;
---
<ul class="think-consequence-list catalog-grid portfolio-values">
  {solutionValues(solution.slug).map((value) => <CatalogCard card={valueCard(value)} />)}
</ul>
