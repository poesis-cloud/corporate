---
/**
 * SolutionValueCards — the shared value list for solution pages, in the same
 * format as the homepage therapy values. A value is delivered by solution
 * capabilities, never by products directly: the relation named in the proof
 * line is `delivered by capability` when one capability suffices, and
 * `emerges from capabilities` when the value only exists once several
 * capabilities combine. Each entry links to the capability anchors further
 * down the same page.
 */
import Icon from './Icon.astro';
import { capabilityShipped, relationQualifiers, solutionValueAnchor, typeIcons, type Solution } from '../data/poesis-portfolio.ts';

interface Props {
  solution: Solution;
}

const { solution } = Astro.props;
const capability = (slug: string) => solution.capabilities.find((c) => c.slug === slug)!;
---
<ul class="think-consequence-list portfolio-values">
  {solution.values.map((v) => (
    <li id={solutionValueAnchor(v.title)}>
      <span class="think-consequence__head">
        <span class="think-consequence__icon"><Icon name={typeIcons.value} size={16} /></span>
        <span class="think-consequence__step">Value</span>
      </span>
      <strong>{v.title}</strong>
      <p set:html={v.body} />
      <p class="proof-line">
        <span>{relationQualifiers.solutionValueCapabilities(v.relations.capabilities.length, v.emergent)}</span>
        {v.relations.capabilities.map((cs, i) => (
          <>
            {i > 0 && ' · '}
            <a class={capabilityShipped(solution, capability(cs)) ? undefined : 'is-planned'} href={`#${cs}`}>{capability(cs).name}</a>
          </>
        ))}
      </p>
    </li>
  ))}
</ul>
