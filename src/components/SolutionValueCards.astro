---
/**
 * SolutionValueCards — the shared value list for solution pages, in the same
 * format as the homepage therapy values. Each entry links to the product(s)
 * that deliver the value; emergent values name the product interaction they
 * arise from (never a single feature — that mapping lives on the product
 * pages).
 */
import Icon from './Icon.astro';
import { solutionValueAnchor, type Solution } from '../data/poesis-portfolio.ts';

interface Props {
  solution: Solution;
}

const { solution } = Astro.props;
const productName = (slug: string) => solution.products.find((p) => p.slug === slug)!.name;
---
<ul class="think-consequence-list portfolio-values">
  {solution.values.map((v) => (
    <li id={solutionValueAnchor(v.title)}>
      <span class="think-consequence__head">
        <span class="think-consequence__icon"><Icon name={v.emergent ? 'spark' : 'check-badge'} size={16} /></span>
        <span class="think-consequence__step">{v.emergent ? 'Emergent value' : 'Value'}</span>
      </span>
      <strong>{v.title}</strong>
      <p set:html={v.body} />
      <p class="proof-line">
        <span>{v.emergent ? 'Emerges from' : 'Delivered by'}</span>
        {v.products.map((ps, i) => (
          <>
            {i > 0 && ' · '}
            <a href={`${solution.href}/products/${ps}`}>{productName(ps)}</a>
          </>
        ))}
      </p>
    </li>
  ))}
</ul>
