---
/**
 * SolutionValueCards — the shared value list for solution pages, in the same
 * format as the homepage therapy values. A value is realized by solution
 * capabilities, never by products directly. The capabilities named in the proof
 * line are the ones that declare the value, and each entry links to its
 * capability anchor further down the same page.
 */
import DeliveryStatus from './DeliveryStatus.astro';
import { plannedClass, relationQualifiers, type Solution } from '../data/poesis-platform.ts';
import { solutionValues, valueAliases, valueAnchor, valueStatus, valueSupports } from '../data/usage.ts';

interface Props {
  solution: Solution;
}

const { solution } = Astro.props;
---
<ul class="think-consequence-list portfolio-values">
  {solutionValues(solution.slug).map((v) => (
    <li id={valueAnchor(v)} class={plannedClass(valueStatus(v.slug))}>
      {valueAliases(v).map((alias) => <span id={alias} class="claim-anchor" aria-hidden="true" />)}
      <span class="think-consequence__head">
        <span class="think-consequence__step">Value</span>
        <DeliveryStatus state={valueStatus(v.slug)} />
      </span>
      <strong>{v.title}</strong>
      <p set:html={v.body} />
      <p class="proof-line">
        <span>{relationQualifiers.solutionValueCapabilities()}</span>
        {valueSupports(v.slug).map((support, i) => (
          <>
            {i > 0 && ' · '}
            <a class={plannedClass(support.state)} href={`#${support.slug.split('/')[1]}`}>{support.name} <DeliveryStatus state={support.state} /></a>
          </>
        ))}
      </p>
    </li>
  ))}
</ul>
