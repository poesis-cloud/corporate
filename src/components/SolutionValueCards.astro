---
/**
 * SolutionValueCards — the shared value list for solution pages, in the same
 * format as the homepage therapy values. A value is delivered by solution
 * capabilities, never by products directly: the relation named in the proof
 * line is `delivered by capability` when one capability suffices, and
 * `emerges from capabilities` when the value only exists once several
 * capabilities combine. Each entry links to the capability anchors further
 * down the same page.
 */
import Icon from './Icon.astro';
import { solutionValueAnchor, type Solution } from '../data/poesis-portfolio.ts';

interface Props {
  solution: Solution;
}

const { solution } = Astro.props;
const capabilityName = (slug: string) => solution.capabilities.find((c) => c.slug === slug)!.name;
const relation = (v: Solution['values'][number]) =>
  v.emergent
    ? 'Emerges from the combination of capabilities'
    : v.capabilities.length > 1
      ? 'Delivered together by capabilities'
      : 'Delivered by capability';
---
<ul class="think-consequence-list portfolio-values">
  {solution.values.map((v) => (
    <li id={solutionValueAnchor(v.title)}>
      <span class="think-consequence__head">
        <span class="think-consequence__icon"><Icon name={v.emergent ? 'spark' : 'check-badge'} size={16} /></span>
        <span class="think-consequence__step">{v.emergent ? 'Emergent value' : 'Value'}</span>
      </span>
      <strong>{v.title}</strong>
      <p set:html={v.body} />
      <p class="proof-line">
        <span>{relation(v)}</span>
        {v.capabilities.map((cs, i) => (
          <>
            {i > 0 && ' · '}
            <a href={`#${cs}`}>{capabilityName(cs)}</a>
          </>
        ))}
      </p>
    </li>
  ))}
</ul>
