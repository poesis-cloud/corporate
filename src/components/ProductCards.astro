---
/**
 * ProductCards — the Products section shared by all solution pages, in the
 * same format as the Capabilities grid. One clickable card per Product
 * (→ product page), its features listed in the value format, each one linking
 * to its anchor on the product page.
 */
import Icon from './Icon.astro';
import type { Solution } from '../data/poesis-portfolio.ts';
import { featureStatus } from '../data/poesis-portfolio.ts';

interface Props {
  solution: Solution;
}

const { solution } = Astro.props;
---
<ul class="think-therapy__grid portfolio-products">
  {solution.products.map((p) => {
    const statuses = p.features.map(featureStatus);
    return (
      <li>
        <span class="think-capability__head">
          <span class="think-capability__icon"><Icon name={statuses.some((s) => s.shipped) ? 'check-badge' : 'lightbulb'} size={16} /></span>
          <span class="think-capability__step">Product · v{p.currentVersion}</span>
        </span>
        <strong><a class="card-cover" href={`${solution.href}/products/${p.slug}`}>{p.name}</a></strong>
        <p>{p.tagline}</p>
        <div class="proof-line">
          <span>Features</span>
          <ul class="portfolio-product-features">
            {p.features.map((f, i) => (
              <li>
                <span class="think-consequence__step">
                  {statuses[i].shipped ? `shipped · v${statuses[i].version}` : `planned · v${statuses[i].version}`}
                </span>
                <a href={`${solution.href}/products/${p.slug}#${f.slug}`}>{f.name}</a>
              </li>
            ))}
          </ul>
        </div>
      </li>
    );
  })}
</ul>
