---
/**
 * ProductCards — the Products section shared by all solution pages, in the
 * same format as the Capabilities grid. One clickable card per Product
 * (→ product page), its features listed in the value format, each one linking
 * to its anchor on the product page.
 */
import Icon from './Icon.astro';
import DeliveryStatus from './DeliveryStatus.astro';
import type { Solution } from '../data/poesis-platform.ts';
import { featureStatus, productStatus, relationQualifiers, solutionHref, typeIcons } from '../data/poesis-platform.ts';

interface Props {
  solution: Solution;
}

const { solution } = Astro.props;
const base = solutionHref(solution);
---
<ul class="think-therapy__grid portfolio-products">
  {solution.products.map((p) => {
    const statuses = p.features.map(featureStatus);
    const state = productStatus(p);
    const planned = state !== 'delivered';
    return (
      <li class={planned ? 'is-planned' : undefined}>
        <span class="think-capability__head">
          <span class="think-capability__icon"><Icon name={typeIcons.product} size={16} /></span>
          <span class="think-capability__step">Product · recorded v{p.currentVersion}</span>
          <DeliveryStatus state={state} />
        </span>
        <strong><a class="card-cover" href={`${base}/products/${p.slug}`}>{p.name}</a></strong>
        <p>{p.tagline}</p>
        <div class="proof-line">
          <span>{relationQualifiers.productFeatures()}</span>
          <ul class="portfolio-product-features">
            {p.features.map((f, i) => (
              <li class={statuses[i].shipped ? undefined : 'is-planned'}>
                <span class="think-consequence__step">
                  Feature · milestone v{statuses[i].version}
                </span>
                <DeliveryStatus state={statuses[i].state} />
                <a href={`${base}/products/${p.slug}#${f.slug}`}>{f.name}</a>
              </li>
            ))}
          </ul>
        </div>
      </li>
    );
  })}
</ul>
