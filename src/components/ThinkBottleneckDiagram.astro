---
import Icon from './Icon.astro';
import { affordanceRealizations, affordances, capabilityShipped, platformValues, relationQualifiers, typeIcons } from '../data/poesis-portfolio.ts';
import { painsForPhase } from '../data/pains.ts';

const legacyPains = painsForPhase('legacy');
const genaiPains = painsForPhase('genai');
---
<div class="think-story" aria-label="How the THINK bottleneck changes with AI and Poesis">
  <div class="think-story__phases">
    <article class="think-phase" aria-labelledby="think-history-title">
      <header>
        <span class="think-phase__number">01 · Historically — The THINK pathology</span>
        <h3 id="think-history-title">THINK lived in people&rsquo;s heads and prose — BUILD and RUN moved at its speed or drifted.</h3>
      </header>
      <div class="think-phase__flow">
        <div class="think-capacity think-capacity--narrow">
          <span class="think-capacity__head"><Icon name="compass" size={16} /><strong>THINK</strong></span>
          <span class="think-capacity__definition">Define, evaluate, govern</span>
          <span class="think-capacity__state think-capacity__state--bad">implicitly, manually, in people&rsquo;s heads</span>
        </div>
        <span class="think-phase__arrow" aria-hidden="true">→</span>
        <div class="think-capacity-group">
          <div class="think-capacity">
            <span class="think-capacity__head"><Icon name="layers" size={16} /><strong>BUILD</strong></span>
            <span class="think-capacity__definition">Generate from definitions</span>
            <span class="think-capacity__state think-capacity__state--bad">held in people&rsquo;s heads &mdash; all human</span>
          </div>
          <div class="think-capacity">
            <span class="think-capacity__head"><Icon name="play" size={16} /><strong>RUN</strong></span>
            <span class="think-capacity__definition">Operate</span>
            <span class="think-capacity__state think-capacity__state--bad">by hand, against nothing explicit</span>
          </div>
        </div>
      </div>
      <div class="think-phase__foot">
        <span class="think-phase__details-label">Pain points</span>
        <ul class="think-phase__details">
          <li>Purpose, rules, and constraints scattered across people, meetings, documents, and tools.</li>
          <li>Every handoff reconstructed THINK — and lost a little of it each time.</li>
          <li>THINK artifacts went stale as BUILD and RUN changed — definition and reality drifted apart.</li>
          {legacyPains.map((p) => (
            <li id={p.id}><span>{p.pain}</span></li>
          ))}
        </ul>
      </div>
    </article>

    <article class="think-phase think-phase--warning" aria-labelledby="think-ai-title">
      <header>
        <span class="think-phase__number">02 · Today — Gen AI on pathological THINK</span>
        <h3 id="think-ai-title">AI generates probabilistically against implicit definitions — lose speed, or lose alignment.</h3>
      </header>
      <div class="think-phase__flow">
        <div class="think-capacity think-capacity--narrow">
          <span class="think-capacity__head"><Icon name="compass" size={16} /><strong>THINK</strong></span>
          <span class="think-capacity__definition">Define, evaluate, govern</span>
          <span class="think-capacity__state think-capacity__state--bad">implicitly, manually, in people&rsquo;s heads</span>
        </div>
        <span class="think-phase__arrow" aria-hidden="true">→</span>
        <div class="think-capacity-group think-capacity-group--expanded">
          <div class="think-capacity">
            <span class="think-capacity__head"><Icon name="layers" size={16} /><strong>BUILD</strong></span>
            <span class="think-capacity__definition">Generate from definitions</span>
            <span class="think-capacity__state think-capacity__state--bad">that stay implicit &mdash; now AI-accelerated</span>
          </div>
          <div class="think-capacity">
            <span class="think-capacity__head"><Icon name="play" size={16} /><strong>RUN</strong></span>
            <span class="think-capacity__definition">Operate</span>
            <span class="think-capacity__state think-capacity__state--bad">AI-accelerated, still against nothing explicit</span>
          </div>
        </div>
      </div>
      <div class="think-phase__foot">
        <span class="think-phase__details-label">Pain points</span>
        <ul class="think-phase__details">
          <li>Keep the speed: every artifact drifts further from intent, compounding at machine pace.</li>
          <li>Restore alignment at every handoff: prompts, reviews, corrections, and controls consume the acceleration gain.</li>
          <li>Human attention becomes the control plane — understanding, validation, coordination, and accountability remain scarce.</li>
          {genaiPains.map((p) => (
            <li id={p.id}><span>{p.pain}</span></li>
          ))}
        </ul>
      </div>
    </article>

    <article class="think-phase think-phase--poesis" aria-labelledby="think-poesis-title">
      <header>
        <span class="think-phase__number">03 · Decided now — The Poesis Gene Therapy</span>
        <h3 id="think-poesis-title">Human + AI capacity goes to THINK first — governance decides what becomes authoritative.</h3>
      </header>
      <div class="think-therapy">
        <div class="think-therapy__aside">
          <div class="think-phase__flow">
            <a class="think-capacity think-capacity--governed think-capacity--link" href="#use-case-think">
              <span class="think-capacity__head"><Icon name="compass" size={16} /><strong>THINK</strong></span>
              <span class="think-capacity__definition">Define, evaluate, govern</span>
              <span class="think-capacity__state think-capacity__state--good">explicitly, AI-accelerated, shared</span>
            </a>
            <span class="think-phase__arrow" aria-hidden="true">→</span>
            <div class="think-capacity-group think-capacity-group--expanded">
              <a class="think-capacity think-capacity--link" href="#use-case-build">
                <span class="think-capacity__head"><Icon name="layers" size={16} /><strong>BUILD</strong></span>
                <span class="think-capacity__definition">Generate from definitions</span>
                <span class="think-capacity__state think-capacity__state--good">that are explicit and governed &mdash; by AI or programmatically</span>
              </a>
              <a class="think-capacity think-capacity--link" href="#use-case-run">
                <span class="think-capacity__head"><Icon name="play" size={16} /><strong>RUN</strong></span>
                <span class="think-capacity__definition">Operate</span>
                <span class="think-capacity__state think-capacity__state--good">against the definition &mdash; by AI or programmatically</span>
              </a>
            </div>
          </div>
        </div>
        <div class="think-therapy__body">
          <span class="think-phase__details-label">Affordances</span>
          <ul class="think-therapy__grid">
            {affordances.map((a) => (
              <li id={`affordance-${a.slug}`}>
                <span class="think-capability__head"><span class="think-capability__icon"><Icon name={typeIcons.affordance} size={16} /></span><span class="think-capability__step">{a.name}</span></span>
                <strong>{a.title}</strong>
                <p>{a.blurb}</p>
                <p class="proof-line">
                  <span>{relationQualifiers.affordanceCapabilities(a.relations.capabilities.length)}</span>
                  {affordanceRealizations(a).map((r, i) => (
                    <>
                      {i > 0 && ' · '}
                      <a
                        class={capabilityShipped(r.solution, r.capability) ? undefined : 'is-planned'}
                        href={`${r.solution.href}#${r.capability.slug}`}
                      >{r.capability.name}</a>
                    </>
                  ))}
                </p>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <div class="think-phase__foot think-therapy__values">
        <span class="think-phase__details-label">Values</span>
        <p class="think-therapy__values-lead"><strong>The organization becomes intelligible</strong> &mdash; to the people and the machines who think, build, and run it. Definitions stop being prose: a structured causal context that can be reasoned over, taught, governed, simulated, and continuously evaluated.</p>
        <ul class="think-consequence-list">
          {platformValues.map((v) => (
            <li>
              <span class="think-consequence__head"><span class="think-consequence__icon"><Icon name={typeIcons.value} size={16} /></span><span class="think-consequence__step">{v.name}</span></span>
              <strong>{v.title}</strong>
              <p>{v.body}</p>
              <p class="proof-line">
                <span>{relationQualifiers.platformValueAffordances(v.relations.affordances.length, v.emergent)}</span>
                {v.relations.affordances.map((slug, i) => (
                  <>
                    {i > 0 && ' · '}
                    <a href={`#affordance-${slug}`}>{affordances.find((a) => a.slug === slug)!.name}</a>
                  </>
                ))}
              </p>
            </li>
          ))}
        </ul>
      </div>
    </article>
  </div>
</div>