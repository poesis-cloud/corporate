---
/**
 * SafFlowDiagram — the SAFe Agentic Organization on the user's local computer:
 * three orchestrated layers with all their workflows (agents and deliverables
 * inline), a human ★ gate each, the user's concerns entering per layer; the
 * Agentic Harness check pipeline gates every workflow step; committed
 * artifacts sync with the central Agentic Workspace.
 */
import Icon from './Icon.astro';

const layers = [
  {
    name: 'Portfolio',
    agent: '@vmo-orchestrator',
    concern: 'strategic concerns',
    workflows: [
      { name: 'Epic Lean Business Case', agents: 'BO · EA · Sec · RAI', delivers: 'Epic + lean business case' },
      { name: 'Architectural Vision', agents: 'EA · BO', delivers: 'architectural vision' },
      { name: 'Strategic Portfolio Review', agents: 'BO · EA', delivers: 'review record' },
      { name: 'Participatory Budgeting', agents: 'BO · EA', delivers: 'budget allocations' },
      { name: 'Portfolio Sync', agents: 'VMO · Epic owners', delivers: 'kanban + gate records' },
    ],
  },
  {
    name: 'Program',
    agent: '@rte-orchestrator',
    concern: 'tactical concerns',
    workflows: [
      { name: 'Feature Backlog Refinement', agents: 'PM · Arch · Dev · QA · UX · Sec', delivers: 'Features (WSJF-ranked)' },
      { name: 'Architectural Runway Extension', agents: 'SA · Sec · DevOps · Dev', delivers: 'ADRs + runway items' },
      { name: 'PI Planning', agents: 'the ART', delivers: 'PI plan' },
      { name: 'System Demo', agents: 'the ART', delivers: 'demo record' },
      { name: 'ART Sync', agents: 'Arch · leads', delivers: 'sync record' },
      { name: 'Inspect & Adapt', agents: 'the ART', delivers: 'improvement items' },
    ],
  },
  {
    name: 'Iteration',
    agent: '@sm-orchestrator',
    concern: 'technical concerns',
    workflows: [
      { name: 'Iteration Planning', agents: 'PO · pairs', delivers: 'iteration plan' },
      { name: 'Story Backlog Refinement', agents: 'PO', delivers: 'Stories (estimated, assigned)' },
      { name: 'Pair micro-cycle', agents: 'Dev · Dev · Sec', delivers: 'code + PR packet' },
      { name: 'Verification & Sign-off', agents: 'QA · Sec', delivers: 'sign-off + gate records' },
      { name: 'Daily · Review · Retro', agents: 'the team', delivers: 'ceremony records' },
    ],
  },
];

const checks = [
  { icon: 'search', name: 'resolve', detail: 'workflow · step · model · session context' },
  { icon: 'list', name: 'conditions', detail: 'pre · invariant · post' },
  { icon: 'shield', name: 'authorize', detail: 'acting agent vs. access-control list' },
  { icon: 'check-badge', name: 'validate', detail: 'artifact vs. its JSON Schema, before commit' },
  { icon: 'book-open', name: 'journal', detail: 'session ledger — git history is the event log' },
] as const;
---
<div class="safd" role="img" aria-label="On your local computer, the SAFe Agentic Organization runs three orchestrated layers — portfolio, program, iteration — each receiving your strategic, tactical, or technical concerns, running its workflows with role agents and deliverables, gated by you; the Agentic Harness check pipeline (resolve, conditions, authorize, validate, journal) gates every workflow step; committed artifacts sync with the central Agentic Workspace">
  <div class="safd-local">
    <span class="safd-scope-label">Your local computer — IDE / agent host</span>
    <div class="safd-grid">
      <ol class="safd-layers">
        {layers.map((l) => (
          <li class="safd-layer">
            <div class="safd-concern" aria-hidden="true">you emit <strong>{l.concern}</strong> →</div>
            <div class="safd-layer-head">
              <strong>{l.name}</strong>
              <code>{l.agent}</code>
            </div>
            <ul class="safd-workflows">
              {l.workflows.map((w) => (
                <li>
                  <span class="safd-wf-name">{w.name}</span>
                  <span class="safd-wf-agents">{w.agents}</span>
                  <span class="safd-wf-arrow" aria-hidden="true">→</span>
                  <span class="safd-wf-delivers">{w.delivers}</span>
                </li>
              ))}
            </ul>
            <div class="safd-gate"><span class="safd-star" aria-hidden="true">★</span> human gate — agents propose, you dispose</div>
          </li>
        ))}
      </ol>
      <aside class="safd-harness">
        <div class="safd-harness-head">
          <span class="safd-harness-icon"><Icon name="grid" size={16} /></span>
          <strong>Agentic Harness</strong>
        </div>
        <span class="safd-harness-sub">every workflow step, on every layer, passes through:</span>
        <ol class="safd-checks">
          {checks.map((c, i) => (
            <li class="safd-check">
              <span class="safd-check-icon"><Icon name={c.icon} size={14} /></span>
              <span class="safd-check-name">{i + 1} · {c.name}</span>
              <span class="safd-check-detail">{c.detail}</span>
            </li>
          ))}
        </ol>
        <span class="safd-harness-foot">deterministic — resolved from persisted state and validated configuration only; invalid bytes never land</span>
      </aside>
    </div>
  </div>
  <div class="safd-sync" aria-hidden="true">⇅ committed artifacts sync — and contextualize every other local orchestration</div>
  <div class="safd-central">
    <span class="safd-scope-label safd-scope-label--central">Central Agentic Workspace — your organization's git host</span>
    <span class="safd-central-body">Epics · Features · Stories · ADRs · kanbans · gate records — validated, committed, shared; mirrored to boards, tickets, and wiki.</span>
  </div>
</div>

<style>
  .safd {
    margin-top: 1.75rem;
  }
  .safd-local {
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius);
    padding: 1.1rem 1.2rem 1.2rem;
  }
  .safd-scope-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1rem;
  }
  .safd-grid {
    display: grid;
    grid-template-columns: 1fr 16rem;
    gap: 1.2rem;
    align-items: start;
  }
  .safd-layers {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }
  .safd-layer {
    position: relative;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--bg-soft);
    padding: 1rem 1.2rem;
  }
  .safd-layer + .safd-layer {
    margin-top: 2rem;
  }
  .safd-layer + .safd-layer::before {
    content: '↓ dispatch';
    position: absolute;
    top: -1.6rem;
    left: 1.2rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--muted);
  }
  .safd-concern {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--accent-ink);
    margin-bottom: 0.4rem;
  }
  .safd-layer-head {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    flex-wrap: wrap;
  }
  .safd-layer-head strong {
    color: var(--ink);
    font-size: 0.98rem;
  }
  .safd-layer-head code {
    font-size: 0.74rem;
    color: var(--accent-ink);
  }
  .safd-workflows {
    list-style: none;
    margin: 0.7rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }
  .safd-workflows li {
    border-left: 2px solid var(--line-strong);
    padding-left: 0.7rem;
    line-height: 1.5;
  }
  .safd-wf-name {
    font-size: 0.85rem;
    color: var(--ink);
  }
  .safd-wf-agents {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--muted);
    margin-left: 0.45rem;
  }
  .safd-wf-arrow {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--accent);
    margin: 0 0.25rem;
  }
  .safd-wf-delivers {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--accent-ink);
  }
  .safd-gate {
    margin-top: 0.75rem;
    padding-top: 0.6rem;
    border-top: 1px dashed var(--line);
    font-size: 0.8rem;
    color: var(--ink-soft);
  }
  .safd-star {
    color: var(--accent);
  }
  .safd-harness {
    position: sticky;
    top: 1rem;
    border: 1px solid rgba(45, 212, 191, 0.35);
    border-radius: var(--radius);
    background: var(--accent-soft);
    padding: 1rem 1.05rem;
  }
  .safd-harness-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .safd-harness-icon {
    display: inline-flex;
    color: var(--accent);
  }
  .safd-harness-head strong {
    color: var(--ink);
    font-size: 0.92rem;
  }
  .safd-harness-sub {
    display: block;
    margin-top: 0.45rem;
    font-size: 0.76rem;
    color: var(--ink-soft);
  }
  .safd-checks {
    list-style: none;
    margin: 0.8rem 0 0;
    padding: 0;
    position: relative;
  }
  /* pipeline spine through the check nodes */
  .safd-checks::before {
    content: '';
    position: absolute;
    top: 0.5rem;
    bottom: 0.5rem;
    left: 0.55rem;
    border-left: 1px dashed rgba(45, 212, 191, 0.5);
  }
  .safd-check {
    position: relative;
    padding: 0 0 0.85rem 1.7rem;
  }
  .safd-check:last-child {
    padding-bottom: 0;
  }
  .safd-check-icon {
    position: absolute;
    left: 0;
    top: 0.05rem;
    display: inline-flex;
    padding: 0.14rem;
    border: 1px solid rgba(45, 212, 191, 0.5);
    border-radius: 50%;
    background: var(--bg-soft);
    color: var(--accent);
  }
  .safd-check-name {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }
  .safd-check-detail {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--muted);
    line-height: 1.45;
  }
  .safd-harness-foot {
    display: block;
    margin-top: 0.85rem;
    padding-top: 0.65rem;
    border-top: 1px dashed rgba(45, 212, 191, 0.35);
    font-size: 0.7rem;
    font-family: var(--font-mono);
    color: var(--muted);
    line-height: 1.5;
  }
  .safd-sync {
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--accent);
    padding: 0.7rem 0;
  }
  .safd-central {
    border: 1px solid rgba(45, 212, 191, 0.35);
    border-radius: var(--radius);
    background: var(--accent-soft);
    padding: 1rem 1.2rem;
  }
  .safd-scope-label--central {
    color: var(--accent);
    margin-bottom: 0.35rem;
  }
  .safd-central-body {
    font-size: 0.85rem;
    color: var(--ink-soft);
    line-height: 1.5;
  }
  @media (max-width: 900px) {
    .safd-grid {
      grid-template-columns: 1fr;
    }
    .safd-harness {
      position: static;
    }
  }
</style>
