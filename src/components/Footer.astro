---
import { footerNavigation } from '../data/site-navigation.ts';

const year = new Date().getFullYear();

const legal = [
  { href: '/legal/mentions-legales', label: 'Legal notice' },
  { href: '/legal/privacy', label: 'Privacy policy' },
  { href: '/legal/cookies', label: 'Cookie policy' },
];
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a class="brand" href="/">
          <img class="brand-mark" src="/poesis-logo.png" alt="" width="26" height="26" /> Poesis
        </a>
        <p class="footer-tag">Harnessing generative AI for an age of governed synthetic autopoiesis.</p>
      </div>
      {footerNavigation.map((group) => (
        <div>
          <h4>{group.label}</h4>
          <ul>
            {group.items.map((item) => (
              <li><a href={item.href} target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener' : undefined}>{item.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
      <div>
        <h4>Legal</h4>
        <ul>
          {legal.map((l) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
          <li><a href="/legal/cookies" data-cookie-settings>Cookie settings</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-legal">
      <span>&copy; {year} Poesis &middot; Founded by <a href="https://www.linkedin.com/in/clement-cazaud" target="_blank" rel="noopener">Clément Cazaud</a>.</span>
      <span>Proprietary. &ldquo;Poesis&rdquo;, &ldquo;Generative System Model&rdquo;, &ldquo;Systemic Intelligence Engine&rdquo;, &ldquo;IT Intelligence Platform&rdquo; are trademarks of Clément Cazaud.</span>
    </div>
  </div>
</footer>

