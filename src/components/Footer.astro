---
import { solutionLinks } from '../data/solutions.ts';
import { services } from '../data/services.ts';
import { domains } from '../data/domains.ts';

const year = new Date().getFullYear();

const insights = [
  { href: '/insights/research', label: 'Research' },
];

const docs = [
  { href: 'https://docs.poesis.cloud', label: 'Poesis documentation' },
  { href: 'https://docs.poesis.cloud/gsm/', label: 'GSM documentation' },
  { href: 'https://docs.poesis.cloud/itip/', label: 'ITIP documentation' },
  { href: 'https://docs.poesis.cloud/sie/', label: 'SIE documentation' },
  { href: 'https://docs.poesis.cloud/saf/', label: 'SAF documentation' },
];

const partnerships = [
  { href: '/partnerships/llm-vendor-value-proposal', label: 'LLM Vendor Partnership — Value Proposal' },
];

const community = [
  { href: 'https://github.com/poesis-cloud', label: 'GitHub repos' },
  { href: 'https://github.com/orgs/poesis-cloud/discussions', label: 'GitHub discussions' },
  { href: 'https://www.linkedin.com/company/poesis-cloud', label: 'LinkedIn' },
];
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a class="brand" href="/">
          <img class="brand-mark" src="/poesis-logo.png" alt="" width="26" height="26" /> Poesis
        </a>
        <p class="footer-tag">Harnessing generative AI for an age of governed synthetic autopoiesis.</p>
      </div>
      <div>
        <h4>Domains</h4>
        <ul>
          {domains.map((d) => (
            <li><a href={d.href}>{d.label}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h4>Solutions</h4>
        <ul>
          {solutionLinks.map((p) => (
            <li><a href={p.href}>{p.label}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h4>Services</h4>
        <ul>
          {services.map((s) => (
            <li><a href={s.href}>{s.label}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h4>Partnerships</h4>
        <ul>
          {partnerships.map((p) => (
            <li><a href={p.href}>{p.label}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h4>Insights</h4>
        <ul>
          {insights.map((i) => (
            <li><a href={i.href}>{i.label}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h4>Docs</h4>
        <ul>
          {docs.map((d) => (
            <li><a href={d.href}>{d.label}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h4>Community</h4>
        <ul>
          {community.map((c) => (
            <li><a href={c.href} target="_blank" rel="noopener">{c.label}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h4>Company</h4>
        <ul>
          <li><a href="/about">About</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-legal">
      <span>&copy; {year} Poesis &middot; Founded by <a href="https://www.linkedin.com/in/clement-cazaud" target="_blank" rel="noopener">Clément Cazaud</a>.</span>
      <span>Proprietary. &ldquo;Poesis&rdquo;, &ldquo;Generative System Model&rdquo;, &ldquo;Systemic Intelligence Engine&rdquo;, &ldquo;IT Intelligence Platform&rdquo; are trademarks of Clément Cazaud.</span>
    </div>
  </div>
</footer>

