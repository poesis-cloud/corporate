---
/**
 * Shared relationship links, including source-scoped catalog navigation.
 */
import DeliveryStatus from './DeliveryStatus.astro';
import { plannedClass } from '../data/poesis-platform.ts';
import type { RelationGroup } from '../data/usage.ts';

interface Props {
  groups: RelationGroup[];
}

const { groups } = Astro.props;
---

{groups.length > 0 && (
  <div class="proof-line relation-previews">
    {groups.map((group) => (
      <details class="relation-preview">
        <summary>
          <span>{`${group.qualifier} ${group.label}`}</span>
          <span class="relation-preview__count">({group.previews.length})</span>
        </summary>
        <div class="relation-preview__body">
          <ul class="relation-preview__items">
            {group.previews.map((preview) => (
              <li>
                <a class={plannedClass(preview.state)} href={preview.href}>
                  <span>{preview.label}</span>
                  <DeliveryStatus state={preview.state} compact />
                </a>
              </li>
            ))}
          </ul>
          {group.href && <a class="relation-preview__all" href={group.href}>View all {group.label}</a>}
        </div>
      </details>
    ))}
  </div>
)}
