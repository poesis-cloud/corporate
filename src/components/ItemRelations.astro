---
/**
 * Shared relationship links, including source-scoped catalog navigation.
 */
import DeliveryStatus from './DeliveryStatus.astro';
import { plannedClass } from '../data/poesis-platform.ts';
import type { RelationGroup } from '../data/usage.ts';

interface Props {
  groups: RelationGroup[];
}

const { groups } = Astro.props;
---

{groups.length > 0 && (
  <p class="proof-line proof-line--merged">
    {groups.map((group, groupIndex) => (
      <>
        {groupIndex > 0 && ' · '}
        <span class="proof-line__qualifier">
          {group.qualifier}{group.label && !(group.links.length === 1 && group.links[0].label === group.label) ? ` ${group.label}` : ''}:
        </span>{' '}
        {group.links.map((link, index) => (
          <>
            {index > 0 && ' · '}
            <a class={plannedClass(link.state)} href={link.href}>{link.label} <DeliveryStatus state={link.state} compact /></a>
          </>
        ))}
      </>
    ))}
  </p>
)}
