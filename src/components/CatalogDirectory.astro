---
/**
 * The catalog directory. It lays a catalog page out and delegates every entry
 * to CatalogCard, so a directory adapts the layout and never the card.
 */
import CatalogCard from './CatalogCard.astro';
import type { CatalogCard as CatalogCardModel } from '../data/catalog-card.ts';

interface Props {
  id: string;
  eyebrow: string;
  title: string;
  cards: CatalogCardModel[];
  /** Which card skin this directory reuses: the boxed grid or the left-ruled list. */
  variant?: 'platform' | 'usage';
}
const { id, eyebrow, title, cards, variant = 'usage' } = Astro.props;
const list = variant === 'platform' ? 'think-therapy__grid' : 'think-consequence-list';
---
<section id={id} class="section">
  <div class="container">
    <div class="section-head"><p class="eyebrow">{eyebrow}</p><h2>{title}</h2></div>
    <ul class={`${list} catalog-grid`}>
      {cards.map((card) => <CatalogCard card={card} variant={variant} />)}
    </ul>
  </div>
</section>
<style>
  .catalog-grid > li[hidden] { display: none; }
</style>
