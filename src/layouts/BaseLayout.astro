---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  pageType?: string;
  noindex?: boolean;
  /** Set for insight/blog posts — switches og:type to article and emits BlogPosting JSON-LD. */
  article?: {
    publishedTime: string;
    authorName: string;
    authorUrl?: string;
  };
}

const {
  title,
  description = 'Poesis harnesses generative AI for an age of governed synthetic autopoiesis — with the GSM standard, the SIE engine, and the ITIP application defining and governing systems in software.',
  pageType,
  noindex = false,
  article,
} = Astro.props;

const site = Astro.site ?? new URL('https://poesis.cloud');
const canonical = new URL(Astro.url.pathname, site).href;
const fullTitle = title === 'Poesis' ? 'Poesis — governed synthetic autopoiesis' : `${title} · Poesis`;
const ogImage = new URL('/og-default.png', site).href;

const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Poesis',
  url: site.href,
  logo: new URL('/poesis-logo.png', site).href,
  slogan: 'Define the world in software; generate it.',
  sameAs: ['https://www.linkedin.com/company/poesis-cloud', 'https://github.com/poesis-cloud'],
};

const articleLd = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      url: canonical,
      datePublished: article.publishedTime,
      image: ogImage,
      author: {
        '@type': 'Person',
        name: article.authorName,
        ...(article.authorUrl ? { url: article.authorUrl } : {}),
      },
      publisher: { '@type': 'Organization', name: 'Poesis', url: site.href },
    }
  : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#070a12" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Poesis" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Poesis — governed synthetic autopoiesis" />
    {article && <meta property="article:published_time" content={article.publishedTime} />}
    {article && <meta property="article:author" content={article.authorName} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="generator" content={Astro.generator} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationLd)} />
    {articleLd && <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />}
    {/* Google tag (gtag.js) — GA4 measurement G-KZGGY5D9GW */}
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-KZGGY5D9GW"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-KZGGY5D9GW');
    </script>
  </head>
  <body data-page-type={pageType}>
    {pageType && <span data-pagefind-meta="type" style="display:none">{pageType}</span>}
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
